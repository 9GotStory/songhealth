#!/usr/bin/env bash
# Songhealth commit checks (#58 retro): the pinned Node (#65 retro), formatting, Knip, types,
# duplicated code (#93), the invisible-character scan, the comment-width, cited-path and
# package-fact checks (#122 retro), the document-version check (#127 retro; on a ticket's branch,
# DESIGN.md naming the ticket it stages for: #286 retro) and the heading check
# (#145 retro), plus ShellCheck when a shell script is staged. Source scans include tracked and
# non-ignored untracked files. A check prints only when it fails. CI runs these with the
# build and the full node tests on every pull request (.github/workflows/checks.yml). The checks
# read the working tree, not the staged snapshot: to commit part of the changes, set the rest aside
# first (git stash push --keep-index). Where the Legacy site's export exists, the leak check
# (#179 retro) reads the staged changes too, and every tracked file's name and text (#289); CI
# holds no export. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Run one check; when it fails, print its output and stop the commit.
check() {
  local output
  if ! output=$("$@" 2>&1); then
    printf 'pre-commit: %s failed\n%s\n' "$*" "$output" >&2
    exit 1
  fi
}

check scripts/check-node.sh
check npm run --silent format:check
# Fail on comment formatting before the heavier checks (#193 retro, PO comment 6722771184).
check node --test tests/node/comment-width.test.ts
check npm run --silent knip
check npm run --silent typecheck
check npm run --silent jscpd
check node --test tests/node/invisible-characters.test.ts \
  tests/node/cited-source-paths.test.ts tests/node/package-facts.test.ts \
  tests/node/document-versions.test.ts tests/node/public-titles.test.ts
# The export stays outside the repository (ADR 0008), so CI has none, and the script leaves with
# WordPress. The newest export's dated name sorts last. The whole tree is read, not only what the
# commit adds: a file written before the newest export arrived may hold one of its texts (#289).
exports=("$HOME"/.local/state/songhealth-migration/WordPress.*.xml)
if [[ -e ${exports[-1]} && -f scripts/migration.ts ]]; then
  check node scripts/migration.ts leak-check "${exports[-1]}" --tree
fi
if git diff --cached --name-only --diff-filter=ACMR | grep -q -e '\.sh$' -e '^\.githooks/'; then
  check npm run --silent lint:shell
fi
