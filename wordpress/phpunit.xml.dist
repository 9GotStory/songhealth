<?xml version="1.0" encoding="UTF-8"?>
<!--
    WordPress plugin unit/integration PHPUnit configuration (Delivery 002, T002).

    Boots the clean WordPress verification profile through tests/bootstrap.php:
    WordPress core plus the WordPress PHPUnit test library and the first-party
    songhealth-core plugin ONLY. No legacy WordPress theme or plugin is loaded,
    and no Delivery 001 runtime asset is included.

    The native public-surface containment suite has its own bootstrap
    (tests/containment/bootstrap.php) and is run through
    `composer test:containment`.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.result.cache"
         failOnWarning="true">
    <testsuites>
        <testsuite name="unit">
            <directory>wp-content/plugins/songhealth-core/tests/unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>wp-content/plugins/songhealth-core/tests/integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Real test installation configuration; see wp-tests-config-sample.php. -->
        <env name="WP_PHPUNIT__TESTS_CONFIG" value="wp-tests-config.php"/>
        <!-- WordPress test library, provided by the composer baseline (T001). -->
        <env name="WP_TESTS_DIR" value="vendor/wp-phpunit/wp-phpunit"/>
    </php>
</phpunit>
