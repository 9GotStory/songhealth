# Songhealth external configuration example.
#
# Copy this file to `.env` (ignored by Git) and supply real local values there:
#   cp .env.example .env
#
# This committed example contains variable names and safe, clearly non-production
# placeholders only. Never place real secrets, credentials, host-specific values,
# or environment-specific sensitive values in this file. In production,
# configuration and secrets are injected at runtime from operator-managed
# Podman/systemd secrets or equivalent host-protected files; they are never
# baked into images or committed to the repository.

# Public origin of the site (scheme + host + optional port, no trailing slash).
# Development default shown; production MUST be an absolute HTTPS origin that
# matches the external proxy boundary.
SITE_ORIGIN=http://localhost:4321

# Address the application server binds to. The development default binds to
# loopback only; production must match the container/proxy boundary and must
# not expose an unintended interface. Native Astro HOST/PORT inputs.
HOST=127.0.0.1

# Port the application server listens on.
PORT=4321

# SECRET-BEARING — PostgreSQL connection string for the EmDash database.
# The password inside the URL is part of the secret: replace the placeholder
# only in ignored local files or the runtime secret mechanism, and never log
# the value or include it in evidence. The example is a non-usable placeholder
# for a local development database.
DATABASE_URL=postgresql://songhealth:CHANGE_ME@localhost:5432/songhealth

# Media directory used by the native EmDash local-media adapter. The
# development default is the Git-ignored local media directory (see /media/ in
# .gitignore); production must resolve to the intended persistent media mount
# and be writable.
MEDIA_DIRECTORY=./media

# SECRET — EmDash encryption key. Required at runtime, exists only in the
# runtime environment, and must never be committed, logged, or included in
# database/media backups. No usable value is provided here on purpose:
# generate a unique strong key, keep it in an operator-managed secret with an
# independently protected recovery copy, and set the real value only in
# ignored local files or the runtime secret mechanism.
EMDASH_ENCRYPTION_KEY=
