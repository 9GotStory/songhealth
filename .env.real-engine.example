# Local real-engine acceptance-test configuration.
#
# Copy to .env.real-engine.local and replace placeholders with credentials for a
# dedicated, non-Production MySQL-compatible test account.
#
# This file is NOT the Production-like Verification runtime configuration.
# It exists only for destructive real-engine acceptance tests that create and
# drop isolated, test-owned databases whose names begin with `songhealth_test_`.
#
# Never use Production credentials or Production-derived data here.
# Never commit .env.real-engine.local.

SONGHEALTH_TEST_DATABASE_URL=mysql://songhealth_test:local-test-placeholder@127.0.0.1:3307/songhealth_test_local
