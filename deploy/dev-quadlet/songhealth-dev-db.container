# Songhealth DEVELOPMENT PostgreSQL 18.6 (UID 1000 Quadlet runtime; PO gate
# 6410811185, Phase 1 source-only). Reference: deploy/quadlet/songhealth-db.container
# (T019 production — NOT modified). Differences from production are deliberate:
# distinct ContainerName/network/volume/env-file/secret names; NO host port
# publication at all (the development app reaches the database only on the private
# songhealth-qdev network); the same immutable PostgreSQL 18.6 image digest as
# production. Mount is the PostgreSQL 18 parent path /var/lib/postgresql
# (PGDATA=/var/lib/postgresql/18/docker). First start on a genuinely empty
# operator-provisioned volume performs the image's native cluster initialization
# ONLY as the documented fresh-install plan (docs/operations/development-quadlet.md);
# backup/restore and replacement guards live in scripts/dev-runtime-{backup,restore}.sh.
[Unit]
Description=Songhealth dev PostgreSQL 18.6 (private qdev network only, no host port)
Before=songhealth-dev-app.service
[Container]
Image=docker.io/library/postgres:18.6@sha256:fc973eb97c9fd04bfa1840e0f510719a584ccb3be8debfe6a4144637a9dfe8cf
ContainerName=songhealth-qdev-db
Network=songhealth-dev.network
Volume=songhealth-dev-db-data.volume:/var/lib/postgresql
Environment=POSTGRES_USER
Environment=POSTGRES_DB
Secret=songhealth-qdev-db-password
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/songhealth-qdev-db-password
HealthCmd=pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB" -h 127.0.0.1
HealthInterval=5s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy
[Service]
EnvironmentFile=%h/.config/containers/systemd/songhealth-dev-db.env
ExecCondition=/usr/bin/test -n "${POSTGRES_USER}"
ExecCondition=/usr/bin/test -n "${POSTGRES_DB}"
ExecCondition=/usr/bin/sh -c 'p=$$(podman volume inspect --format "{{.Mountpoint}}" songhealth-qdev-db-data) || { /usr/bin/echo "songhealth-qdev-db: refusing to start: volume metadata not inspectable - an uninspectable store is never accepted" >&2; exit 1; }; [ -n "$$p" ] || { /usr/bin/echo "songhealth-qdev-db: refusing to start: volume reports no data directory" >&2; exit 1; }; if podman unshare /usr/bin/test -e "$$p/18/docker/PG_VERSION"; then podman unshare /usr/bin/test -s "$$p/18/docker/PG_VERSION" || { /usr/bin/echo "songhealth-qdev-db: refusing to start: PG_VERSION exists but is EMPTY - a half-formed or silently replaced store is never re-initialized" >&2; exit 1; }; fi'
Restart=always
RestartSec=5s
[Install]
WantedBy=default.target
