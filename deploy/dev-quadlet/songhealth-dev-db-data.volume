# Songhealth DEVELOPMENT database volume (UID 1000 Quadlet runtime; PO gate
# 6410811185 Phase 1). Production reference deploy/quadlet/songhealth-db-data.volume
# is untouched. VolumeName is deliberately distinct (songhealth-qdev-db-data) from
# the production volume and from any UID-1001 store; first-start semantics and the
# fresh-install initialization plan are documented in docs/operations/development-quadlet.md.
[Volume]
VolumeName=songhealth-qdev-db-data
