# Songhealth's production application container (Feature 001 T020; `10` §3.1 and §20.1): the one
# Astro + EmDash application, on the private network with PostgreSQL (songhealth-db.container),
# with the persistent media volume at /app/media and the application port published on the host's
# loopback alone, for the reverse proxy.
#
# Inputs, never committed, each absence failing closed:
# - ~/.config/containers/systemd/songhealth-app.env (0600), which systemd loads: HOST, PORT,
#   PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD and EMDASH_SITE_URL, forwarded into the
#   container by name. PGPASSWORD is here rather than in a Podman secret because the readiness
#   helper (scripts/verify-readiness.mjs) reads it from the container's own environment, as the
#   health check below and through `podman exec` in the T016 harness.
# - the Podman secrets songhealth-migration-database-url and songhealth-encryption-key, mounted
#   read-only at /run/secrets/<name> and read by the startup payload into the application's
#   process environment alone, so `podman inspect` does not show them.
# - the marker .songhealth-media-store at the root of the media volume, which the Operator creates
#   once when provisioning the store. Podman creates a missing named volume empty (the
#   `podman volume create --ignore` Quadlet generates for songhealth-media.volume), so the marker
#   tells the provisioned store from an empty replacement.
#
# The startup payload (Exec=, one `sh -c`), in order: /app/media must be a mount point
# (/proc/mounts) and the marker readable; the two secrets are read; then, before any migration,
# the application role is checked on both connections. Each must create into and look up only
# schema public (current_schema() is public, current_schemas(false) is public beside pg_catalog,
# pg_my_temp_schema() is 0); the role must not be SUPERUSER, CREATEDB or CREATEROLE, must hold
# CONNECT, USAGE and CREATE, and must own, with full DML, every existing table and sequence in
# public. The lookup path is cast to text[]: pg-types 2.2.0 (lib/textParsers.js) parses text[]
# (OID 1009) into an array and leaves name[] a string. Then the T013 startup gate
# (`npm run verify:startup`, tests/operations/verify-startup.sh) builds the application, checks the
# migration manifest that build emits, applies and checks the migrations and probes the media store,
# and only then is the server started with `exec`. Any failure exits before the application serves.
# The T016 harness (tests/operations/verify-foundation.sh) requires this payload byte for byte.
#
# The server binds 0.0.0.0 inside the container (HOST=0.0.0.0 for that one process): a rootless
# published port delivers to the container's network address, not its loopback. The boundary stays
# the host's loopback (PublishPort) and the private network PostgreSQL alone shares.

[Unit]
Description=Songhealth Astro + EmDash application (T013 startup gate, least-privilege role prerequisite, private network, loopback-only publication)
# Ordering only: a database unit that was skipped still completes its start job. Whether the
# database is usable is proved by the role check and the gate's S1 and S3.
Requires=songhealth-db.service
After=songhealth-db.service

[Container]
# Pinned by repository, version and digest. Podman resolves the digest in local storage, so another
# or rebuilt image fails container creation: accepting a new build means changing this line.
Image=localhost/songhealth-app:0.0.1@sha256:4cfccf41d4e10fc32f1f9dc76d5b7a69bed049b7b03556eb82059f5278de7407

# Quadlet adds the network's and the volume's services as dependencies of this unit.
Network=songhealth.network
Volume=songhealth-media.volume:/app/media

# Host loopback only. PORT must equal 4321 (the ExecCondition below), so the server, the readiness
# probe and the publication use one port.
PublishPort=127.0.0.1:4321:4321

Environment=HOST
Environment=PORT
Environment=PGHOST
Environment=PGPORT
Environment=PGDATABASE
Environment=PGUSER
Environment=PGPASSWORD
Environment=EMDASH_SITE_URL

# A secret that does not exist fails container creation.
Secret=songhealth-migration-database-url
Secret=songhealth-encryption-key

Exec=sh -c "grep -q ' /app/media ' /proc/mounts || { echo songhealth-app: required persistent media volume songhealth-media is not attached at /app/media - refusing to start >&2; exit 1; }; test -r /app/media/.songhealth-media-store || { echo songhealth-app: operator-managed existing media store marker .songhealth-media-store is missing at /app/media - the persistent store was not provisioned or has been replaced - refusing to start >&2; exit 1; }; IFS= read -r EMDASH_MIGRATION_DATABASE_URL </run/secrets/songhealth-migration-database-url; IFS= read -r EMDASH_ENCRYPTION_KEY </run/secrets/songhealth-encryption-key; export EMDASH_MIGRATION_DATABASE_URL EMDASH_ENCRYPTION_KEY; node -e 'const pg=require(`pg`);const fail=m=>{console.error(`songhealth-app: `+m);process.exit(1)};const schemaContractOk=r=>!!r&&String(r.creation_schema)===`public`&&Array.isArray(r.lookup_schemas)&&r.lookup_schemas.filter(x=>String(x)!==`pg_catalog`).length===1&&String(r.lookup_schemas.filter(x=>String(x)!==`pg_catalog`)[0])===`public`&&String(r.temp_schema)===`0`;(async()=>{const c=new pg.Client({host:process.env.PGHOST,port:Number(process.env.PGPORT),database:process.env.PGDATABASE,user:process.env.PGUSER,password:process.env.PGPASSWORD,connectionTimeoutMillis:5000,query_timeout:5000});await c.connect();const sa=(await c.query(`select current_schema() as creation_schema, current_schemas(false)::text[] as lookup_schemas, pg_my_temp_schema() as temp_schema`)).rows[0];if(!schemaContractOk(sa))fail(`public-only schema prerequisite failed: the application connection does not satisfy the public-only schema contract (creation schema current_schema() must be public, the effective lookup path current_schemas(false) minus the documented implicit or explicit pg_catalog system lookup must be exactly public, and pg_my_temp_schema() must be 0 so no temporary schema shadows EmDash relation lookup) - refusing before any migration mutation`);const mc=new pg.Client({connectionString:process.env.EMDASH_MIGRATION_DATABASE_URL,connectionTimeoutMillis:5000,query_timeout:5000});await mc.connect();const sm=(await mc.query(`select current_schema() as creation_schema, current_schemas(false)::text[] as lookup_schemas, pg_my_temp_schema() as temp_schema`)).rows[0];await mc.end();if(!schemaContractOk(sm))fail(`public-only schema prerequisite failed: the migration connection does not satisfy the public-only schema contract (the same creation-schema, effective-lookup-path, and temporary-schema conditions) - refusing before any migration mutation`);const r=await c.query(`select rolsuper s,rolcreatedb cd,rolcreaterole cr,has_database_privilege(current_user,current_database(),$q$CONNECT$q$) dbc,has_schema_privilege(current_user,$q$public$q$,$q$USAGE$q$) su,has_schema_privilege(current_user,$q$public$q$,$q$CREATE$q$) sc from pg_roles where rolname=current_user`);const b=r.rows[0];if(!b)fail(`least-privilege application-role prerequisite failed: the connecting role has no pg_roles row`);if(b.s)fail(`least-privilege application-role prerequisite failed: the connecting role is SUPERUSER - the bootstrap administrator is not the application identity`);if(b.cd)fail(`least-privilege application-role prerequisite failed: the connecting role has CREATEDB`);if(b.cr)fail(`least-privilege application-role prerequisite failed: the connecting role has CREATEROLE`);if(!b.dbc)fail(`least-privilege application-role prerequisite failed: the connecting role lacks CONNECT on the target database`);if(!b.su)fail(`least-privilege application-role prerequisite failed: the connecting role lacks USAGE on schema public`);if(!b.sc)fail(`least-privilege application-role prerequisite failed: the connecting role lacks CREATE on schema public`);const o=await c.query(`select case c.relkind when $q$S$q$ then $q$sequence$q$ else $q$table$q$ end kind,c.relname obj,pg_has_role(current_user,c.relowner,$q$USAGE$q$) owned,case c.relkind when $q$S$q$ then has_sequence_privilege(current_user,c.oid,$q$SELECT$q$) and has_sequence_privilege(current_user,c.oid,$q$USAGE$q$) and has_sequence_privilege(current_user,c.oid,$q$UPDATE$q$) else has_table_privilege(current_user,c.oid,$q$SELECT$q$) and has_table_privilege(current_user,c.oid,$q$INSERT$q$) and has_table_privilege(current_user,c.oid,$q$UPDATE$q$) and has_table_privilege(current_user,c.oid,$q$DELETE$q$) end dml from pg_class c join pg_namespace n on n.oid=c.relnamespace where c.relkind in ($q$r$q$,$q$p$q$,$q$S$q$) and n.nspname=$q$public$q$`);await c.end();for(const x of o.rows){const p=[];if(!x.owned)p.push(`not owned by the connecting role directly or through role membership`);if(!x.dml)p.push(`lacking effective required DML privileges`);if(p.length>0)fail(`least-privilege application-role prerequisite failed: existing EmDash `+x.kind+` `+x.obj+` in the established public schema is `+p.join(` and `))}console.error(`songhealth-app: least-privilege application-role and public-only schema prerequisites verified: both connections create into public (current_schema) with effective lookup exactly public beyond the documented pg_catalog system lookup (current_schemas(false)) and no temporary schema (pg_my_temp_schema 0); non-superuser, no CREATEDB, no CREATEROLE, database CONNECT, schema public USAGE and CREATE, and `+o.rows.length+` existing EmDash relation(s) in the established public schema pass required ownership (direct or inherited) and full DML verification`)})().catch(e=>fail(`least-privilege application-role and public-only schema prerequisite failed: `+((e&&e.code)||`error`)))' && npm run verify:startup && HOST=0.0.0.0 exec node dist/server/entry.mjs"

# Health is the T012 readiness helper: the loopback page and its marker, PostgreSQL and the media
# mount, within its own 8 s bound; it writes nothing (the migrations and the media probe stay in the
# startup gate). Notify=healthy holds the unit's start until the check first passes.
HealthCmd=node scripts/verify-readiness.mjs
HealthInterval=10s
HealthTimeout=15s
HealthRetries=3
HealthStartPeriod=300s
Notify=healthy

# Podman's init runs first in the container and passes the stop signal on: the server, run first
# itself, ignores SIGTERM and is killed when the stop timeout ends. The host provides the init
# (/usr/libexec/podman/catatonit). On a stop the server ends at once, and a request in flight is
# cut (Product Owner, #453 comment 7158951848).
RunInit=true

[Service]
EnvironmentFile=%h/.config/containers/systemd/songhealth-app.env
# Each condition skips the unit (not failed, not restarted) before any container exists when an
# input is empty or PORT is not the published 4321. The ":" prefix turns off systemd's variable
# substitution (systemd.service(5)), so PGPASSWORD reaches no command line and the shell tests it
# in its own environment; ConditionEnvironment= would read the manager's environment, not
# EnvironmentFile= (systemd.unit(5)).
ExecCondition=/usr/bin/test -n "${HOST}"
ExecCondition=/usr/bin/test "${PORT}" = 4321
ExecCondition=/usr/bin/test -n "${PGHOST}"
ExecCondition=/usr/bin/test -n "${PGPORT}"
ExecCondition=/usr/bin/test -n "${PGDATABASE}"
ExecCondition=/usr/bin/test -n "${PGUSER}"
ExecCondition=:/usr/bin/sh -c 'test -n "$PGPASSWORD"'
ExecCondition=/usr/bin/test -n "${EMDASH_SITE_URL}"

# Back after any exit but an explicit stop; systemd's start rate limit bounds the retries.
Restart=always
RestartSec=5s

# The stop signal ends the server through Podman's init with 143; counted a success, the unit is
# inactive after `systemctl --user stop`, not failed (Product Owner, #453 comment 7158951848).
SuccessExitStatus=143

# The Product Owner's ceiling for one start: the gate's build is bounded at 930 s and its four
# migration commands at 630 s each, 3,450 s in all; the rest (the role check, the media probe, the
# server's start and the first health check) has no proven bound.
TimeoutStartSec=3600s
