# Development operation target — daily Development configuration example.
# Copy to .env.development.local and fill in local values. Actual local .env files are
# ignored by Git. These are non-secret, non-Production placeholders only; they are
# never accepted as Production configuration and contain no real credentials.
#
# operationTarget and diagnosticScope are NOT configuration keys: operationTarget is
# supplied by the local command boundary (--target) and diagnosticScope is derived
# output context.

APP_ENVIRONMENT=development
RUNTIME_PROFILE=daily
APP_HOST=127.0.0.1
APP_PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
DATABASE_URL=mysql://songhealth_dev:dev-only-placeholder@127.0.0.1:3306/songhealth_development
DATABASE_POOL_MAX=5
PROXY_POLICY=none
LOG_LEVEL=info
FIXTURE_PROVENANCE=synthetic
