---
// A Document's file as a tile (Feature 010 #315, #317; spec #311 "The Document repository", "The
// card over the field's edge"; Feature 014 #418, spec #417 "The light row tile"): the row's light
// tile (RowTile), 68 px below `sm` and 92 px from `sm`, with the 24 px file-text in brand-primary
// over the file's type ("PDF") at small size, semibold, in brand-dark, or "ไฟล์" when the file
// cannot be served or its name and stored key carry no type (src/lib/media.ts). It is decorative,
// since the words beside it name the type too. A Document row and the card on a Document's and a
// Health Report's page show it.
import FileText from "@lucide/astro/icons/file-text";
import RowTile from "./RowTile.astro";

interface Props {
	/** The file's type, such as "PDF"; none for a file that cannot be served or has no type. */
	type?: string;
}

const { type } = Astro.props;
---

<RowTile class="gap-1">
	<FileText class="shrink-0" size={24} />
	<span class="text-small font-semibold text-brand-dark">{type ?? "ไฟล์"}</span>
</RowTile>
