---
// A Document's status in its own domain as a label (Feature 003 #55; spec #51 "Shared building
// blocks"): superseded and expired need attention.
import { DOMAIN_STATUS_LABELS, type DomainStatus } from "../lib/documents";
import StatusLabel from "./StatusLabel.astro";

interface Props {
	status: DomainStatus;
}

const { status } = Astro.props;
---

<StatusLabel attention={status !== "current"}>{DOMAIN_STATUS_LABELS[status]}</StatusLabel>
