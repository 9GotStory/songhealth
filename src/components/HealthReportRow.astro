---
// A Health Report as a row in the Health Reports list (Feature 003 #59; spec #51 "Public reads"
// (Health Reports), user story 45; Feature 011 #342, spec #338 "The Health Reports list",
// decisions 1 and 12): the Announcement row (AnnouncementRow, §8.7) without its badge, a white row
// with the report's tile, the facts line, the title in two lines at most, from `sm` the summary,
// the reporting period, and from `sm` the round arrow.
//
// The tile is the row's light tile (RowTile; Feature 014 #418, spec #417 "The light row tile": 68
// px below `sm`, 92 px from `sm`) with the 24 px file-chart-column in brand-primary and under it
// the fiscal year at small size, semibold, in brand-dark, or the icon alone for a report without
// one; it is decorative, since the facts line names the year too. The facts line is MetaLine's: the
// Report Type, the date the list orders by (the report date, else the publication:
// src/lib/health-reports.ts healthReportDate) and the fiscal year, which wraps between facts. The
// summary is at label size in text-secondary, two lines at most, and none below `sm`; the period at
// small size in text-secondary.
//
// The row is the one the Announcement's and a search result's rows share (LinkRow; Feature 015
// #434): a native link named by the title covers the whole row; the facts and the period stay
// readable outside the link's name (WCAG 2.2 SC 2.5.3). A report row has no download: the list
// does not read its Document (decision 1). The row lies over the deep field's lower edge in the
// first place, so its focus ring has a white band on both sides (`focus-ring-banded`), as the
// Announcements'.
//
// Under the pointer the title turns brand-primary, the arrow's circle accent-warm, and with motion
// allowed the row moves 10 px to the right with the `deep` shadow; a press on the 10 px it left
// still opens the report (LinkRow).
import FileChartColumn from "@lucide/astro/icons/file-chart-column";
import { healthReportDate, healthReportPath, type HealthReportEntry } from "../lib/health-reports";
import { termsOf } from "../lib/terms";
import LinkRow from "./LinkRow.astro";
import MetaLine from "./MetaLine.astro";
import RowTile from "./RowTile.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	report: HealthReportEntry;
}

const { report } = Astro.props;
const data = report.data;
const type = termsOf(data, "report_type")[0];
const date = healthReportDate(data);
const titleId = `report-${crypto.randomUUID()}`;
---

<LinkRow href={healthReportPath(report.id)} titleId={titleId} surface="report-surface">
	<RowTile class="gap-1">
		<FileChartColumn class="shrink-0" size={24} />
		{data.fiscal_year ? (
			<span class="text-small font-semibold text-brand-dark">{data.fiscal_year}</span>
		) : null}
	</RowTile>
	<div class="flex min-w-0 flex-1 flex-col gap-1">
		<MetaLine
			facts={[
				type && { text: type.label },
				date && { date },
				data.fiscal_year && { text: `ปีงบประมาณ ${data.fiscal_year}` },
			]}
		/>
		<h2
			id={titleId}
			class="line-clamp-2 text-body font-semibold wrap-anywhere group-hover:text-brand-primary sm:text-body-large"
		>
			<ThaiTitle text={data.title} />
		</h2>
		{data.summary && (
			<p class="line-clamp-2 text-label text-text-secondary max-sm:hidden">{data.summary}</p>
		)}
		{data.reporting_period && (
			<p class="text-small wrap-anywhere text-text-secondary">
				ช่วงเวลาของรายงาน: {data.reporting_period}
			</p>
		)}
	</div>
</LinkRow>
