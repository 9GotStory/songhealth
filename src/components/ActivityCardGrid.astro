---
// A page of Activities as a grid of list cards (Feature 003 #56; Feature 010 #313; spec #311 "The
// Activities list", decisions 6 and 12): the News lists' cards, each dated by when the Activity
// was held, else its publication, the order the list follows, with its place (`location_text`)
// after the date and its summary, and the `heart` visual in place of a missing picture. The list
// has no filter, so every first page leads with the large card. The grid, the large card and the
// motion are ListCardGrid's; the place is held to its lines (`clampLabel`).
import { activityDate, activityPath, type ActivityEntry } from "../lib/activities";
import ListCardGrid from "./ListCardGrid.astro";

interface Props {
	entries: ActivityEntry[];
	/** The page's number, from 1. */
	page: number;
}

const { entries, page } = Astro.props;
const cards = entries.map(({ id, data }) => ({
	href: activityPath(id),
	title: data.title,
	label: data.location_text ?? undefined,
	date: activityDate(data),
	summary: data.summary ?? undefined,
	image: data.featured_image ?? undefined,
}));
---

<ListCardGrid cards={cards} icon="heart" page={page} narrowed={false} clampLabel />
