---
// A MOIT's Evidence as pills (Feature 004 #123; spec #121 "Public routes", the prototype's variant
// C): each piece of Evidence with its Round when it names one, its label, and what it is.
//
// - A file downloads under its uploaded name and says its type and size, as a Document's file does
//   (src/components/DocumentDownload.astro). One that cannot be served says so in the Document
//   wording, without a link to it, and points to the office (#121 user story 13).
// - A link says where it leads: a page of this site, another website by its host, or the email
//   address or telephone number it opens. Like src/components/ContentLink.astro, a link to another
//   website says in text that it leaves the site and opens in a new tab, and the others open in
//   place. A link staff marked current carries "ข้อมูลปัจจุบัน" as a status that needs attention
//   (StatusLabel.astro): it shows today's data, not the fiscal year's record (ADR 0006).
// - The icons follow the site's rules (CODING_STANDARDS "Public pages"): a file's download icon at
//   its start, chevron-right at the end of a link on this site and arrow-up-right at the end of
//   one that leaves it. They are decorative (docs/agents/lucide-astro-1.59.0.md).
// - A pill keeps its icons at its ends and lets its text wrap between them, so on a phone an icon
//   never sits on a line of its own.
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Download from "@lucide/astro/icons/download";
import type { EvidencePill } from "../lib/ita";
import { FILE_UNAVAILABLE } from "../lib/media";
import StatusLabel from "./StatusLabel.astro";

interface Props {
	pills: EvidencePill[];
}

const { pills } = Astro.props;

const pillBox =
	"inline-flex min-h-11 max-w-full items-center gap-2 rounded-24 px-4 py-2 text-label";
/** Each pill's look: a link's, one that leads nowhere, and a file that cannot be served. */
const pillLooks = {
	link: `${pillBox} border border-border-default bg-surface-soft text-brand-dark hover:border-brand-primary hover:bg-surface-base`,
	unlinked: `${pillBox} border border-border-default text-brand-dark`,
	unavailable: `${pillBox} border border-dashed border-border-input text-text-secondary`,
};
const pillText = "flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1";
const roundTag = "rounded-pill bg-brand-dark px-2 text-small text-surface-base";
const detailText = "wrap-anywhere text-text-secondary-on-soft";

/** The link a pill is, with how it opens, or undefined for a pill that leads nowhere. */
function linkOf(evidence: EvidencePill) {
	switch (evidence.kind) {
		case "file":
			return { href: evidence.href, download: evidence.filename };
		case "external":
			return { href: evidence.href, target: "_blank", rel: "noopener" };
		case "page":
		case "contact":
			return { href: evidence.href };
		default:
			return undefined;
	}
}
---

{pills.length > 0 && (
	<ul class="flex flex-wrap gap-2">
		{pills.map((evidence) => {
			const link = linkOf(evidence);
			const Pill = link ? "a" : "span";
			return (
				<li class="max-w-full">
					<Pill
						class={
							link
								? pillLooks.link
								: pillLooks[evidence.kind === "unavailable" ? "unavailable" : "unlinked"]
						}
						{...link}
					>
						{evidence.kind === "file" && <Download class="shrink-0 text-brand-primary" size={20} />}
						<span class={pillText}>
							{evidence.round && <span class={roundTag}>{evidence.round}</span>}
							<span class="wrap-anywhere">
								{evidence.label}
								{"note" in evidence && evidence.note && ` (${evidence.note})`}
							</span>
							{"detail" in evidence && (
								<span class={detailText}>
									{evidence.detail}
									{evidence.kind === "external" && " (เว็บไซต์ภายนอก)"}
								</span>
							)}
							{evidence.kind === "unavailable" && (
								<>
									<span class="font-semibold text-brand-dark">{FILE_UNAVAILABLE}</span>
									<a class="text-brand-primary underline underline-offset-4" href="/contact">
										ติดต่อเรา
									</a>
								</>
							)}
							{"current" in evidence && evidence.current && (
								<StatusLabel attention>ข้อมูลปัจจุบัน</StatusLabel>
							)}
						</span>
						{evidence.kind === "external" && (
							<>
								<span class="sr-only">(เปิดในแท็บใหม่)</span>
								<ArrowUpRight class="shrink-0" size={16} />
							</>
						)}
						{evidence.kind === "page" && <ChevronRight class="shrink-0" size={16} />}
					</Pill>
				</li>
			);
		})}
	</ul>
)}
