---
// A Document's file (Feature 003 #55; spec #51 "Shared building blocks", `03` §17): a download
// link at EmDash's own media URL that names the file's type and size and offers the uploaded
// file's name, or, when the file cannot be served, the unavailable state. That state names nothing
// about storage and points to the office (#51 user story 49).
import type { FileValue } from "emdash";
import { downloadableFile } from "../lib/media";

interface Props {
	file: FileValue | null | undefined;
}

const file = await downloadableFile(Astro.props.file, Astro.locals.emdash);
---

{file ? (
	<a
		class="inline-flex min-h-11 items-center gap-2 self-start rounded-pill bg-brand-primary px-6 py-2 text-label text-surface-base hover:bg-brand-dark"
		href={file.href}
		download={file.filename}
	>
		<svg
			class="size-5 shrink-0"
			aria-hidden="true"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M12 3v12" />
			<path d="M7 10l5 5 5-5" />
			<path d="M5 21h14" />
		</svg>
		<span>ดาวน์โหลดเอกสาร ({[file.type, file.size].filter(Boolean).join(", ")})</span>
	</a>
) : (
	<div class="flex flex-col items-start gap-2 rounded-24 bg-surface-soft p-5">
		<p class="font-semibold text-brand-dark">ไฟล์ไม่พร้อมให้บริการ</p>
		<p class="text-text-secondary-on-soft">หากต้องการเอกสารนี้ โปรดติดต่อสำนักงาน</p>
		<a class="text-label text-brand-primary underline underline-offset-4" href="/contact">
			ติดต่อเรา
		</a>
	</div>
)}
