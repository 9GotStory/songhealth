---
// A Document's file (Feature 003 #55, #59; spec #51 "Shared building blocks", `03` §17): a
// download link at EmDash's own media URL that names the file's type and size and offers the
// uploaded file's name, or, when the file cannot be served, the unavailable state
// (UnavailableNotice.astro). A page whose Document row already says the file is unavailable, such
// as a Health Report's, asks for the link alone.
import type { FileValue } from "emdash";
import { FILE_UNAVAILABLE, downloadableFile } from "../lib/media";
import UnavailableNotice from "./UnavailableNotice.astro";

interface Props {
	file: FileValue | null | undefined;
	/** Show the unavailable state when the file cannot be served (the default), or nothing. */
	unavailableNotice?: boolean;
}

const { unavailableNotice = true } = Astro.props;
const file = await downloadableFile(Astro.props.file, Astro.locals.emdash);
---

{file ? (
	<a
		class="inline-flex min-h-11 items-center gap-2 self-start rounded-pill bg-brand-primary px-6 py-2 text-label text-surface-base hover:bg-brand-dark"
		href={file.href}
		download={file.filename}
	>
		<svg
			class="size-5 shrink-0"
			aria-hidden="true"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M12 3v12" />
			<path d="M7 10l5 5 5-5" />
			<path d="M5 21h14" />
		</svg>
		<span>ดาวน์โหลดเอกสาร ({file.label})</span>
	</a>
) : (
	unavailableNotice && <UnavailableNotice message={FILE_UNAVAILABLE} />
)}
