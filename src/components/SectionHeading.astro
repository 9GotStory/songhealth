---
// A Homepage section's heading (Feature 008 #241; spec #239 "Section headings"): an icon tile, a
// small label between slashes, the section's H2, and, for a section with a list of its own, a
// link to that list (SectionListLink). The section takes its name from the H2 through `id`. A
// section that shows a lead builds it, and its link, beside the heading, as the Current
// Announcements do (src/pages/index.astro).
//
// The icon comes through the `icon` slot, a Lucide icon at 24 px, and is decorative: the tile is
// hidden from assistive technology. On a dark surface the tile is accent-warm, the H2 is
// surface-base. The label is accent-warm on brand-dark (7.75:1) and surface-base on the
// deep field, where the field is as light as brand-primary under it and accent-warm, 4.10:1 there,
// is below the 4.5:1 its small text needs (measured at 3.93:1 at 320 px with nothing Featured,
// scripts/measure-text-contrast.ts), in place of the prototype's accent-warm (Product Owner,
// 2026-11-11: #242 comment 6797113372, item 1).
import SectionListLink from "./SectionListLink.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	/** The H2's id, unique on the page, which the section names itself by. */
	id: string;
	/** The small label above the H2. */
	label: string;
	title: string;
	/** The address of the section's own list. */
	href?: string;
	/** The dark surface the section is on: brand-dark, or the Homepage's deep field. */
	surface?: "dark" | "field";
	/** The heading's own classes, such as its reveal as it comes into the window. */
	class?: string;
}

const { id, label, title, href, surface, class: className } = Astro.props;
const onDark = surface !== undefined;
/** The label's colour, which keeps 4.5:1 on its surface. */
const labelColor = {
	light: "text-brand-primary",
	dark: "text-accent-warm",
	field: "text-surface-base",
}[surface ?? "light"];
---

<div class:list={["flex items-center justify-between gap-4 sm:items-end sm:gap-6", className]}>
	<div class="flex min-w-0 items-center gap-3.5 sm:gap-5">
		<span
			aria-hidden="true"
			class:list={[
				"flex size-13 shrink-0 items-center justify-center rounded-16 sm:size-18 sm:rounded-22",
				onDark
					? "bg-accent-warm text-brand-dark"
					: "bg-linear-140 from-brand-primary to-brand-dark text-accent-warm shadow-tile",
			]}
		>
			<slot name="icon" />
		</span>
		<div class="min-w-0">
			<p
				class:list={[
					"mb-1.5 text-label font-semibold tracking-[0.02em]",
					"before:mr-2.5 before:opacity-55 before:content-['/'] after:ml-2.5 after:opacity-55 after:content-['/']",
					labelColor,
				]}
			>
				{label}
			</p>
			<h2
				id={id}
				class:list={[
					"section-title wrap-anywhere",
					onDark ? "text-surface-base" : "text-text-primary",
				]}
			>
				<ThaiTitle text={title} />
			</h2>
		</div>
	</div>
	{href && <SectionListLink href={href} title={title} tone={onDark ? "dark" : "outline"} />}
</div>
