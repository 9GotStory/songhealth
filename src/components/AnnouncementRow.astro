---
// An Announcement as a row, the Homepage's Current Announcements' and the Announcements list's
// (Feature 008 #245; spec #239 "Current Announcements"; Feature 010 #314, spec #311 "The
// Announcements list"): a white row with a date tile, the category as a badge, the title in two
// lines at most, the status line when the Announcement has open or close dates, and from `sm` an
// arrow. `kind` says where it shows: on the Homepage its title is an H3 under the section's H2; on
// the list an H2 under the page's H1, and the list's first row lies over the deep field's lower
// edge, so its focus ring has a white band on both sides (`focus-ring-banded`; Product Owner,
// 2026-11-13: #283 comment 6854670042), as the list cards' does.
//
// The date is the one the list orders by (src/lib/announcements.ts announcementDate), on the rows'
// light tile (RowTile; Feature 014 #419, spec #417 decisions 1 and 12): the day large in
// brand-primary, the month and the year under it in brand-dark, whatever the Announcement's status.
// The tile stays read by assistive technology, since the row says the date nowhere else (Product
// Owner, 2026-11-23: #419 comment 7100237929). A closed Announcement, which only the list shows,
// has the tile white with a border-default edge and its day and month in text-secondary (spec #417
// decision 13); its status label stays status-closed with text-primary. The readings are in
// docs/design/DESIGN.md §3.2 and §8.7.
//
// The category is the first `announcement_type` term, in the colour
// src/lib/announcement-category.ts gives it: procurement in procurement-text on topic-blue with a
// procurement-border edge, recruitment in brand-dark on accent-warm, any other in brand-primary on
// surface-soft (docs/design/DESIGN.md §3.2 has each ratio). The status line is
// AnnouncementStatusLine, its label after a dot.
//
// The row is the one a Health Report's and a search result's rows share (LinkRow; Feature 015
// #434): a native link named by the title covers the whole row; the date, the category and the
// status stay readable outside the link's name (WCAG 2.2 SC 2.5.3; #193; #190 comment 6707205912).
// The arrow is arrow-right, the Homepage's arrow for a card (Product Owner, 2026-11-11: #241
// comment 6791096480, item 1), and decorative.
//
// Under the pointer the arrow's circle turns accent-warm, and the row moves 10 px to the right
// with the `deep` shadow, only under `prefers-reduced-motion: no-preference` (spec #239 "Motion
// and loading"); while it has moved, a press on the 10 px it left still opens the Announcement
// (LinkRow; HomeServiceCard does the same below a card that rises).
import { categoryTone } from "../lib/announcement-category";
import {
	announcementDate,
	announcementPath,
	isClosed,
	type AnnouncementEntry,
} from "../lib/announcements";
import { termsOf } from "../lib/terms";
import { thaiDateParts } from "../lib/thai-date";
import AnnouncementStatusLine from "./AnnouncementStatusLine.astro";
import LinkRow from "./LinkRow.astro";
import RowTile from "./RowTile.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	announcement: AnnouncementEntry;
	/** The instant the page decides every Announcement's status at. */
	now: Date;
	/** The Homepage's Current Announcements, or the Announcements list. */
	kind: "home" | "list";
}

const { announcement, now, kind } = Astro.props;
const data = announcement.data;
const category = termsOf(data, "announcement_type")[0];
const listedAt = announcementDate(data);
const date = listedAt ? new Date(listedAt) : undefined;
const dateParts = date && thaiDateParts(date);
const closed = isClosed(data, now);
const titleId = `announcement-${crypto.randomUUID()}`;
const Heading = kind === "home" ? "h3" : "h2";
const badge = {
	procurement: "bg-topic-blue text-procurement-text ring-1 ring-procurement-border ring-inset",
	recruitment: "bg-accent-warm text-brand-dark",
	general: "bg-surface-soft text-brand-primary",
};
---

<LinkRow
	href={announcementPath(announcement.id)}
	titleId={titleId}
	surfaceTestId="announcement-surface"
	banded={kind === "list"}
>
	{dateParts && (
		<RowTile read closed={closed}>
			<time datetime={date?.toISOString()} class="flex flex-col items-center">
				<span class="text-h3/7 font-bold sm:text-h2/9.5">{dateParts.day}</span>{" "}
				<span class:list={["text-small", !closed && "text-brand-dark"]}>
					{dateParts.monthAndYear}
				</span>
			</time>
		</RowTile>
	)}
	<div class="min-w-0 flex-1">
		{category && (
			<p class="mb-1.5 flex">
				<span
					class:list={[
						"rounded-pill px-3 py-0.5 text-small font-semibold wrap-anywhere",
						badge[categoryTone(category.slug)],
					]}
				>
					{category.label}
				</span>
			</p>
		)}
		<Heading
			id={titleId}
			class="line-clamp-2 text-body font-semibold wrap-anywhere sm:text-body-large"
		>
			<ThaiTitle text={data.title} />
		</Heading>
		<AnnouncementStatusLine data={data} now={now} class="mt-1.5" />
	</div>
</LinkRow>
