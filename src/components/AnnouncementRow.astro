---
// An Announcement in a list (Feature 003 #56; spec #51 "Shared building blocks"): its type and
// date, its title linking to its own page, and, when it has open or close dates, its status with
// those dates (AnnouncementStatusLine).
import {
	announcementDate,
	announcementPath,
	type AnnouncementEntry,
	type AnnouncementStatus as Status,
} from "../lib/announcements";
import { termsOf } from "../lib/terms";
import AnnouncementStatusLine from "./AnnouncementStatusLine.astro";
import MetaLine from "./MetaLine.astro";

interface Props {
	announcement: AnnouncementEntry;
	status: Status | undefined;
}

const { announcement, status } = Astro.props;
const data = announcement.data;
const type = termsOf(data, "announcement_type")[0];
const date = announcementDate(data);
---

<article class="flex flex-col gap-2 rounded-24 bg-surface-base p-5 shadow-card">
	<MetaLine facts={[type && { text: type.label }, date && { date }]} />
	<h2 class="text-body-large font-semibold wrap-anywhere text-brand-dark">
		<a
			class="underline-offset-4 hover:text-brand-primary hover:underline"
			href={announcementPath(announcement.id)}
		>
			{data.title}
		</a>
	</h2>
	{status && <AnnouncementStatusLine data={data} status={status} />}
</article>
