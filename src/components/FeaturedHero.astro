---
// The Featured hero (Feature 003 #65; spec #51 "Homepage (`04`, Figma order)" and "Shared building
// blocks"; docs/design/homepage-concept-v1.md §3): the Featured item's title, its summary or the
// start of an Announcement's details, and its picture, with a primary link to the item and a
// secondary ค้นหาบริการ link to the Service catalog. V1 shows the one item and no carousel (`04` §5).
// The eyebrow, the link labels and the visual's caption are the frame's text. The caption keeps
// "ใกล้บ้าน": `00` §13 and GLOSSARY.md keep the word out of a Health Service's name, to which they
// limit #51's copy rule, and the caption names none (Product Owner, 2026-10-31: #65 comment
// 6538358352).
//
// The title is the section's H2, beside the other sections' H2s; the site title stays the page's H1
// (src/pages/index.astro). The primary link's label does not say which item it opens, so it takes
// the title as its context (ActionLink).
//
// The picture is decorative, because the title names the item, and it goes through EmDash's Image
// as a card picture does (src/components/ContentCard.astro says why), with `priority`, which loads
// it at once with a high fetch priority, since the hero is in view when the page opens (emdash
// 1.1.0 src/components/EmDashImage.astro). An item without a picture, or whose picture's media item
// was deleted in Admin (src/lib/media.ts), shows the frame's visual instead, decoration too.
//
// The picture shows whole at its own aspect ratio, never cropped (Feature 006 #146; spec #144
// "Homepage (`04`)"): the office's landscape pictures are text banners, and its portrait ones are
// One Pages. It fills its column's width up to the frame's height, 408 px. A picture that would be
// taller at that width, such as a One Page, shows at the frame's height, narrower and centred on
// the band. The picture's box takes its shape from the size EmDash keeps with the image, before the
// file loads (emdash 1.1.0):
// - an upload records the image's width and height (src/astro/routes/api/media.ts,
//   src/media/enrich.ts enrichImageMetadata);
// - saving an entry fills them into an image field saved as `{ id }` (src/emdash-runtime.ts
//   normalizeImageValue, src/media/normalize.ts mergeProviderData);
// - its Image writes them as the `width` and `height` attributes (src/components/EmDashImage.astro
//   resolveImage).
// The width at the frame's height caps a wrapper, so the image's box is the picture itself. Image
// shows the picture's placeholder as the image's inline background, which a wider box would show
// beside a One Page instead of the band, and a `style` given to Image would replace it (same file).
// Without a stored size the picture still fits the frame whole. Below 640 px the lead is clamped to
// three lines, to keep the phone Homepage short.
//
// The title is H1 size from `lg` (46 px) where the Figma frame has Display (60 px), on the Product
// Owner's "หัวข้อเรื่องเด่นเล็กลง" (spec #144 "Homepage (`04`)" and Further Notes), so the hero
// leaves room on the first screen. It also keeps "ความดันโลหิตสูง", the longest word a title keeps
// whole (about 318 px at 46 px), inside the 366 px text column at 1024 px (#146 comment
// 6625101174).
import { Image } from "emdash/ui";
import type { FeaturedView } from "../lib/homepage-curation";
import { availableMedia } from "../lib/media";
import { SERVICES_PATH } from "../lib/service-catalog";
import ActionLink from "./ActionLink.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	featured: FeaturedView;
}

/**
 * The picture's width: the 450 px column of the frame from `lg`, the card's width below it. A
 * picture shown at the frame's height, such as a One Page, is narrower, so the browser may pick a
 * larger rendition than it shows. Only the development runtime makes renditions: production serves
 * the original file (ADR 0003).
 */
const PICTURE_SIZES = "(min-width: 64rem) 28.125rem, 100vw";
/** The frame's height, the tallest the picture shows (`max-h-102`). */
const FRAME_HEIGHT = "25.5rem";

const { featured } = Astro.props;
const image = await availableMedia(featured.image, Astro.locals.emdash);
/** The picture's width at the frame's height, from its stored size; unknown without one. */
const widthAtFrameHeight =
	image?.width && image.height
		? `calc(${FRAME_HEIGHT} * ${image.width} / ${image.height})`
		: undefined;
---

<section aria-labelledby="home-featured" class="page-container pt-6 pb-10 lg:pt-8 lg:pb-16">
	<div class="grid items-center gap-8 rounded-32 bg-brand-dark p-6 text-surface-base sm:p-10 lg:grid-cols-[minmax(0,1fr)_28.125rem] lg:gap-12 lg:p-14">
		<div class="flex min-w-0 flex-col items-start gap-5.5">
			<p class="rounded-pill bg-hero-chip px-3.5 py-2 text-label">เรื่องเด่นจากอำเภอสอง</p>
			<h2 id="home-featured" class="text-h3 wrap-anywhere text-balance sm:text-h2 lg:text-h1">
				<ThaiTitle text={featured.title} />
			</h2>
			{featured.lead && (
				<p class="line-clamp-4 text-body-large max-sm:line-clamp-3">{featured.lead}</p>
			)}
			<div class="flex flex-wrap gap-3">
				<ActionLink href={featured.href} variant="primary" context={featured.title} onDark>
					ดูเรื่องเด่น
				</ActionLink>
				<ActionLink href={SERVICES_PATH} onDark>
					ค้นหาบริการ
				</ActionLink>
			</div>
		</div>
		{image ? (
			<div
				class="w-full justify-self-center"
				style={widthAtFrameHeight && `max-width: ${widthAtFrameHeight}`}
			>
				<Image
					image={image}
					alt=""
					sizes={PICTURE_SIZES}
					priority
					class="h-auto max-h-102 w-full rounded-26 object-contain"
				/>
			</div>
		) : (
			<div
				aria-hidden="true"
				data-testid="featured-visual"
				class="flex aspect-16/9 w-full flex-col items-center justify-center gap-3 rounded-26 bg-linear-to-r from-hero-visual-from to-hero-visual-to p-4 text-center text-label text-brand-dark lg:aspect-auto lg:h-102 lg:gap-6 lg:text-h3"
			>
				<span class="size-16 shrink-0 rounded-pill bg-surface-base sm:size-24 lg:size-52.5"></span>
				ชุมชน • สุขภาพ • ใกล้บ้าน
			</div>
		)}
	</div>
</section>
