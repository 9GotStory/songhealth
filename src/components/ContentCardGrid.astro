---
// A page of News or Health Content as a grid of cards (Feature 003 #54, #59), shared by the News,
// Health News and Health Content lists. Each card is the list's ContentCard (Feature 009 #283; spec
// #280 "The cards"), carries one term of `labelTaxonomy` as its label, shows `icon` in place of a
// missing picture and links to the address `pathOf` gives the entry's slug. The cards go three to
// a row from `lg`, two from `sm` and in rows below, 24 px apart from `sm` and 14 px below; a last
// row may hold fewer, and no cell is filled. The first row is in view when the page opens, so its
// pictures load at once; the rest load lazily. Each card reveals as it comes into the window
// (`scroll-reveal`, src/styles/global.css; spec #280 "Motion").
import type { TaxonomyTerm } from "emdash";
import type { ImageFieldValue } from "../lib/news";
import { termsOf } from "../lib/terms";
import ContentCard from "./ContentCard.astro";

/** The fields a content card shows, which News and Health Content share. */
interface CardEntry {
	/** The entry's slug. */
	id: string;
	data: {
		title: string;
		summary?: string;
		featured_image?: ImageFieldValue;
		publishedAt?: Date | string | null;
		terms?: Record<string, TaxonomyTerm[]>;
	};
}

interface Props {
	entries: CardEntry[];
	labelTaxonomy: string;
	/** The list's icon: `message-square` on `/news`, `heart-pulse` on the two health lists. */
	icon: "message-square" | "heart-pulse";
	/** The entry's own address, from its slug. */
	pathOf: (slug: string) => string;
}

const { entries, labelTaxonomy, icon, pathOf } = Astro.props;
/** Cards per row at the widest layout (lg:grid-cols-3). */
const FIRST_ROW = 3;
---

<ul class="grid gap-3.5 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
	{entries.map((entry, index) => (
		<li class="scroll-reveal min-w-0">
			<ContentCard
				kind="list"
				href={pathOf(entry.id)}
				title={entry.data.title}
				label={termsOf(entry.data, labelTaxonomy)[0]?.label}
				date={entry.data.publishedAt}
				summary={entry.data.summary}
				image={entry.data.featured_image}
				icon={icon}
				eager={index < FIRST_ROW}
			/>
		</li>
	))}
</ul>
