---
// The Documents a page links to (Feature 003 #56, #58; spec #51 "Public reads"): a "เอกสารที่เกี่ยวข้อง"
// section, shown only when there is one. Announcement, Service and Basic Pages show it.
//
// It is Feature 010's section (#316; spec #311 "The card over the field's edge", decisions 2 and
// 10), which a Service's page (Feature 011 #344; spec #338 decision 3) and every Basic Page
// (Feature 012 #368; spec #365 decision 3) take too: the Homepage's section heading on the page's
// colour (the gradient folder-open tile, the label "เอกสารเผยแพร่" and the H2), then the Document
// rows with their downloads, titles H3, 14 px apart and 24 px under the heading below `sm` and
// 28 px from `sm`, as an Activity's photos are under theirs (DESIGN.md §9.2). The rows show at
// once, with no reveal (spec #311 and spec #365 "Motion").
import FolderOpen from "@lucide/astro/icons/folder-open";
import type { DocumentEntry } from "../lib/documents";
import DocumentDownloadRow from "./DocumentDownloadRow.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
	documents: DocumentEntry[];
}

const { documents } = Astro.props;
---

{documents.length > 0 && (
	<section aria-labelledby="related-documents" class="flex flex-col gap-6 sm:gap-7">
		<SectionHeading id="related-documents" label="เอกสารเผยแพร่" title="เอกสารที่เกี่ยวข้อง">
			<FolderOpen slot="icon" class="shrink-0" size={24} />
		</SectionHeading>
		<ul class="flex flex-col gap-3.5">
			{documents.map((document) => (
				<li>
					<DocumentDownloadRow document={document} headingLevel={3} />
				</li>
			))}
		</ul>
	</section>
)}
