---
// The deep green field (src/styles/global.css deep-field), which ends with rounded lower corners.
// Its text is surface-base, and its focus ring is the one for dark surfaces, accent-warm.
//
// - `home`, the Homepage's (Feature 008 #242; spec #239 "Solution", "Frequently Used Services"):
//   one field under the hero and the Frequently Used Services.
// - `list`, the field under a list's heading (Feature 009 #281; spec #280 "The field under a
//   heading"). Its heading is short and its text small, so from `sm` its glow is small and in the
//   upper right corner, and it has the large ring alone, from `lg`: with the Homepage's glows and
//   rings a lead read 3.42:1 and an outlined link's words 2.47:1 (spec #280 "Measured in the
//   prototype"). It has no surface-soft glow either, as the prototype's field (Product Owner,
//   2026-11-13: #281 comment 6847783611, item 2).
// - `post`, the field under a Post page's header (Feature 009 #285; spec #280 "The field under a
//   heading"): the list's glow and no decoration, since a ring crossed the summary of a post
//   without a picture, 4.35:1 (spec #280 "Measured in the prototype").
//
// The decorations lie in a layer of their own, which clips them to the field and its corners. They
// are hidden from assistive technology and take no pointer events (spec #239 "Accessibility").
// On the Homepage the warm glow is left out below `lg`, so white text keeps 4.5:1 on the hero's
// chip and headline, which it would lie behind. The field also clips what is wider than it, such
// as the tilted Featured card's sheet on a phone, so nothing on it widens the page; it does not
// clip downwards, because the Services extend below it, and what follows a list's heading lies
// over its lower edge.
//
// `extended` leaves room under the field, from `sm`, for the part of its last section that extends
// below it, --field-overhang (src/styles/global.css), so what follows the field is not covered.

interface Props {
	/** What the field lies under: the Homepage's hero and Services, a list's heading or a post's. */
	kind?: keyof typeof FIELDS;
	/** The field's last section extends --field-overhang below it from `sm`. */
	extended?: boolean;
	/** The field's place in its parent, such as a grid's row. */
	class?: string;
}

/** The small glow in the field's upper right corner from `sm`, under a heading. */
const CORNER_GLOW = "sm:[--deep-field-glow:28%_12rem_at_100%_0%]";

/** Each field's own glow, where it differs from the utility's, and its decorations' classes. */
const FIELDS = {
	home: {
		glow: undefined,
		decorations: [
			"-top-30 -right-20 size-105 bg-accent-warm/38 blur-3xl max-lg:hidden",
			"top-75 -left-35 size-90 bg-surface-soft/16 blur-3xl",
			"top-15 -right-42.5 size-130 border-[1.5px] border-surface-base/18 max-sm:hidden",
			"top-13.5 left-[46%] size-40 border-[1.5px] border-accent-warm/50 max-lg:hidden",
		],
	},
	list: {
		glow: CORNER_GLOW,
		decorations: [
			"top-15 -right-42.5 size-130 border-[1.5px] border-surface-base/18 max-lg:hidden",
		],
	},
	post: { glow: CORNER_GLOW, decorations: [] },
};

const { kind = "home", extended = false, class: className } = Astro.props;
const { glow, decorations } = FIELDS[kind];
---

<div
	data-testid="deep-field"
	class:list={[
		"deep-field focus-ring-on-dark relative overflow-x-clip rounded-b-24 text-surface-base sm:rounded-b-32",
		glow,
		extended && "sm:mb-(--field-overhang)",
		className,
	]}
>
	<div
		aria-hidden="true"
		class="pointer-events-none absolute inset-0 overflow-clip rounded-b-[inherit]"
	>
		{decorations.map((decoration) => (
			<span class:list={["absolute rounded-pill", decoration]} />
		))}
	</div>
	<slot />
</div>
