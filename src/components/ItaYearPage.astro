---
// A fiscal year's page, /ita/{fiscal-year} (Feature 004 #124; spec #121 "Public routes", ADR 0006):
// the year's published MOITs by number (src/lib/ita.ts inMoitOrder), each leading to its page.
// src/pages/ita/[slug].astro renders this for a year that has a published MOIT. Its heading names
// the assessment and the year, as a MOIT page's header does, and its crumb the year alone (Product
// Owner, 2026-11-02: #124 comment 6577248920).
//
// The page opens on the deep field as the lists do (Feature 013 #394; spec #392 "A fiscal year's
// page", decisions 2 and 12; ListHeading): the label "ITA", the main navigation's word, with the
// calendar-check icon over its H1, and the lead. The MOITs follow over the field's lower edge in an
// ordered list, a row each (ItaMoitRow), 14 px apart, each revealed as it comes into the window
// (`scroll-reveal`). A year's page always holds a MOIT, so it has no empty state.
import CalendarCheck from "@lucide/astro/icons/calendar-check";
import SiteLayout from "../layouts/SiteLayout.astro";
import { inMoitOrder, itaYearLabel, itaYearPath, itaYearTitle } from "../lib/ita";
import type { MoitEntry } from "../lib/moits";
import ItaMoitRow from "./ItaMoitRow.astro";
import ListBody from "./ListBody.astro";
import ListHeading from "./ListHeading.astro";

interface Props {
	year: number;
	/** The year's published MOITs, in any order. */
	moits: MoitEntry[];
}

const { year, moits } = Astro.props;
const title = itaYearTitle(year);
const lead = `ตัวชี้วัด MOIT ${moits.length} รายการของปีงบประมาณ พ.ศ. ${year} พร้อมหลักฐานที่เผยแพร่`;
---

<SiteLayout title={title} section="ita" description={lead} canonical={itaYearPath(year)}>
	<ListHeading
		section="ita"
		crumbs={[{ label: itaYearLabel(year) }]}
		label="ITA"
		title={title}
		lead={lead}
	>
		<CalendarCheck slot="icon" class="shrink-0" size={24} />
	</ListHeading>
	<ListBody>
		<ol class="flex flex-col gap-3.5">
			{inMoitOrder(moits).map((moit) => (
				<li class="scroll-reveal">
					<ItaMoitRow moit={moit} />
				</li>
			))}
		</ol>
	</ListBody>
</SiteLayout>
