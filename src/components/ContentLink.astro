---
// A link to an address staff entered in a url field, such as a Service's external link or one of
// its channels (Feature 003 #58, #105; spec #51 "Public reads" (Services)). The address is linked
// only while it is one EmDash itself accepts for an href: http, https, mailto, tel or a
// site-relative path (emdash 1.1.0 src/utils/url.ts isSafeHref); otherwise the text shows as plain
// text. A link to another website says in text that it leaves the site and opens in a new tab with
// rel="noopener" (#51 user story 38), as the map link does. It ends in arrow-up-right, the site's
// icon for a link that leaves it (Product Owner, 2026-10-31: #51 comment 6536052180), which is
// decorative (docs/agents/lucide-astro-1.59.0.md). A link on this site, an email address or a
// telephone number opens in place.
//
// A compact link, such as one of the footer's official channels, keeps that note for screen readers
// only and shows just the icon: the network's name already says it is another website (Product
// Owner, 2026-10-30: #62 comment 6516956505). The icon is `inline`, because such a link runs in a
// line of text and Tailwind's preflight makes an svg a block (tailwindcss 4.3.3 preflight.css).
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { isSafeHref } from "emdash";
import { isExternalHref } from "../lib/links";

interface Props {
	href: string;
	class?: string;
	/** Say "(เว็บไซต์ภายนอก)" to screen readers only. */
	compact?: boolean;
}

const { href, class: className, compact = false } = Astro.props;
const linked = isSafeHref(href);
const external = linked && isExternalHref(href, Astro.url.origin);
---

{!linked ? (
	<slot />
) : external ? (
	<a class={className} href={href} target="_blank" rel="noopener">
		{compact ? (
			<>
				<slot />
				<span class="sr-only">(เว็บไซต์ภายนอก) (เปิดในแท็บใหม่)</span>
			</>
		) : (
			<>
				<slot /> (เว็บไซต์ภายนอก)
				<span class="sr-only">(เปิดในแท็บใหม่)</span>
			</>
		)}
		<ArrowUpRight class="inline shrink-0" size={16} />
	</a>
) : (
	<a class={className} href={href}>
		<slot />
	</a>
)}
