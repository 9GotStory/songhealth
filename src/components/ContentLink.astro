---
// A link to an address staff entered in a url field, such as a Service's external link or one of
// its channels (Feature 003 #58; spec #51 "Public reads" (Services)). The address is linked only
// while it is one EmDash itself accepts for an href: http, https, mailto, tel or a site-relative
// path (emdash 1.1.0 src/utils/url.ts isSafeHref); otherwise the text shows as plain text. A link
// to another website says in text that it leaves the site and opens in a new tab with
// rel="noopener" (#51 user story 38), as the map link does. A link on this site, an email address
// or a telephone number opens in place.
import { isSafeHref } from "emdash";
import { isExternalHref } from "../lib/links";

interface Props {
	href: string;
	class?: string;
}

const { href, class: className } = Astro.props;
const linked = isSafeHref(href);
const external = linked && isExternalHref(href, Astro.url.origin);
---

{!linked ? (
	<slot />
) : external ? (
	<a class={className} href={href} target="_blank" rel="noopener">
		<slot /> (เว็บไซต์ภายนอก)
		<span class="sr-only">(เปิดในแท็บใหม่)</span>
		<span aria-hidden="true">↗</span>
	</a>
) : (
	<a class={className} href={href}>
		<slot />
	</a>
)}
