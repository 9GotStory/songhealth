---
// A Document in a list (Feature 003 #55; spec #51 "Shared building blocks"): its title linking to
// its own page, its type, Document date and fiscal year, the file's type and size, and a status
// that needs attention (superseded or expired). A file that cannot be served reads as unavailable
// here as it does on the Document's page (src/lib/media.ts). Its title is a heading one level below
// the list's own: H2 on the repository, H3 under another page's "related Documents" heading.
import { documentPath, listedDomainStatus, type DocumentEntry } from "../lib/documents";
import { FILE_UNAVAILABLE, downloadableFile } from "../lib/media";
import { termsOf } from "../lib/terms";
import DocumentStatus from "./DocumentStatus.astro";
import MetaLine from "./MetaLine.astro";

interface Props {
	document: DocumentEntry;
	headingLevel?: 2 | 3;
}

const { document, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const data = document.data;
const type = termsOf(data, "document_type")[0];
const file = await downloadableFile(data.file, Astro.locals.emdash);
const status = listedDomainStatus(data.domain_status);
---

<article class="flex flex-col gap-2 rounded-24 bg-surface-base p-5 shadow-card">
	<MetaLine
		facts={[
			type && { text: type.label },
			data.document_at && { date: data.document_at },
			data.fiscal_year && { text: `ปีงบประมาณ ${data.fiscal_year}` },
		]}
	/>
	<Heading class="text-body-large font-semibold wrap-anywhere text-brand-dark">
		<a
			class="underline-offset-4 hover:text-brand-primary hover:underline"
			href={documentPath(document.id)}
		>
			{data.title}
		</a>
	</Heading>
	{data.summary && <p class="line-clamp-2 text-text-secondary">{data.summary}</p>}
	<p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-small text-text-secondary">
		<span>{file ? `ไฟล์ ${file.label}` : FILE_UNAVAILABLE}</span>
		{status && <DocumentStatus status={status} />}
	</p>
</article>
