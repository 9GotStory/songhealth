---
// A Document in a list (Feature 003 #55; spec #51 "Shared building blocks"): its title linking to
// its own page, its type, Document date and fiscal year, the file's type and size, and a status
// that needs attention (superseded or expired). The Document repository and the About Document
// pages show DocumentDownloadRow instead (Feature 010 #315; Feature 012 #366); a Basic Page's
// related Documents keep this row until #368 (spec #365 decision 3). A file that cannot
// be served reads as unavailable here as it does on the Document's page (src/lib/media.ts). Its
// title is an H3 under the page's "related Documents" heading.
import { documentRowParts, type DocumentEntry } from "../lib/documents";
import { FILE_UNAVAILABLE } from "../lib/media";
import DocumentFacts from "./DocumentFacts.astro";
import DocumentStatus from "./DocumentStatus.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	document: DocumentEntry;
	headingLevel?: 2 | 3;
}

const { document, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const data = document.data;
const { href, file, status } = await documentRowParts(document, Astro.locals.emdash);
---

<article class="flex flex-col gap-2 rounded-24 bg-surface-base p-5 shadow-card">
	<DocumentFacts data={data} />
	<Heading class="text-body-large font-semibold wrap-anywhere text-brand-dark">
		<a class="underline-offset-4 hover:text-brand-primary hover:underline" href={href}>
			<ThaiTitle text={data.title} />
		</a>
	</Heading>
	{data.summary && <p class="line-clamp-2 text-text-secondary">{data.summary}</p>}
	<p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-small text-text-secondary">
		<span>{file ? `ไฟล์ ${file.label}` : FILE_UNAVAILABLE}</span>
		{status && <DocumentStatus status={status} />}
	</p>
</article>
