---
// A row's tile, the one every row that has a tile shares (Feature 014 #418; spec #417 "The light
// row tile", decision 12, prototype P1 A): flat `surface-soft`, 68 px with radius 14 below `sm` and
// 92 px with radius 18 from `sm`, its lines centred one under another. Its first line (an icon, a
// MOIT's number) is `brand-primary`, which the tile gives its children; its second line (the
// file's type, "MOIT", a report's fiscal year) sets `brand-dark` itself. Each line keeps its own
// size and weight. The Document row's file tile (FileTile), a MOIT's row (ItaMoitRow), a Health
// Report's row (HealthReportRow) and a Health Service's row (HealthServiceMapRow) show it. It is
// decorative, since the words beside it say what it says: hidden from assistive technology. It
// stays as it is under the pointer and under focus (spec #417 decision 3).

interface Props {
	/** The gap between its lines, such as `gap-1`; none where its lines touch. */
	class?: string;
}

const { class: className } = Astro.props;
---

<p
	aria-hidden="true"
	class:list={[
		"flex size-17 shrink-0 flex-col items-center justify-center rounded-14 bg-surface-soft text-brand-primary sm:size-23 sm:rounded-18",
		className,
	]}
>
	<slot />
</p>
