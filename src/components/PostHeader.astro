---
// A post page's header, on the deep field (Feature 006 #147; Feature 009 #285; spec #280 "Post
// page: the header"), 48 rem wide at most: the page's breadcrumb in white, then 24 px under it a
// row with "เผยแพร่" and the publication date in an accent-warm pill and a News item's category in
// an outlined white pill, both with a 1 px edge so they are as high and share a line, the title as
// the page's one H1, and the summary under it, so a story told only in its One Page is in words too
// (grill Q14). A page's other dates, such as when Health Content was last reviewed, follow in the
// default slot. An Announcement's and a Document's page take the same header, though neither is a
// Post page (Feature 010 #316, #317; spec #311 "An Announcement's page and a Document's page: the
// header", decision 9): an Announcement's type in the outlined pill, and no summary
// (src/pages/announcements/[slug].astro); a Document's type in the outlined pill, then
// "ถูกแทนที่แล้ว" or "หมดอายุแล้ว" in an accent-warm pill, and no publication date
// (src/pages/documents/[slug].astro). A Health Report's page takes it too (Feature 011 #343; spec
// #338 "The three pages: the header", decision 9): "วันที่รายงาน" and its report date in the
// accent-warm pill, never its publication date, then its Report Type outlined, and its summary
// (src/pages/health/reports/[slug].astro). A Service's page takes it too (#344; spec #338 decision
// 10): an outlined pill for each of its Service Categories, as text, with no date, and its summary
// (src/pages/services/[slug].astro; Product Owner, #344 comment 6979384685, item 2).
// The summary keeps the line breaks staff typed, and an unbroken run of characters in it, such as a
// long web address, wraps anywhere rather than pass the field's edge, which would clip it (Product
// Owner, #368 comment 7028435491, item 2). A part the post lacks is left out, and so is the
// row when it holds no pill, as a draft's preview has no publication date. Its
// text takes the field's surface-base (DeepField.astro).
//
// A Basic Page takes it too (Feature 012 #368; spec #365 "A Basic Page", decision 2): its title
// and summary alone, with no row of pills, and on /pages/{slug} no section
// (src/components/BasicPageContent.astro); on /about, on a list's field before its tiles (#371;
// src/pages/about/index.astro).
//
// A MOIT's page takes it too (Feature 013 #395; spec #392 "A MOIT's page: the header", decisions 3,
// 8 and 13): its fiscal year's title in the outlined pill, "MOIT n" opening the H1 in accent-warm
// (`lead`), the H1 no larger than H2 size from `lg` (`largest`), since a title of the length the
// office has published ran to six lines at H1 size, its summary, and its counts line in the default
// slot (src/components/MoitPage.astro).
//
// The page passes no `crumbs` to the shell, which then shows no breadcrumb above the page
// (src/layouts/SiteLayout.astro), and gives them here with its section, as ListHeading.astro does.
//
// With motion allowed the header's text rises in as the page opens, as the hero's does
// (`hero-enter`, src/styles/global.css; spec #280 "Motion"). The breadcrumb shows at once, so
// nothing the keyboard reaches first is held back, as on a list's heading.
import { breadcrumbTrail, type Crumb, type NavigationSection } from "../lib/navigation";
import type { Instant } from "../lib/dated-lists";
import Breadcrumb from "./Breadcrumb.astro";
import DateText from "./DateText.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	/**
	 * The main-navigation section the page belongs to, which its breadcrumb goes through; none for
	 * a page in no section, such as a Basic Page on /pages/{slug}.
	 */
	section?: NavigationSection;
	/** The page's own crumbs, as the shell takes them (src/layouts/SiteLayout.astro). */
	crumbs: Crumb[];
	title: string;
	summary?: string | null;
	/** The accent-warm pill's date: the publication date, or a Health Report's report date. */
	date?: Instant;
	/** The words before the date in its pill. */
	dateWords?: "เผยแพร่" | "วันที่รายงาน";
	/**
	 * The outlined pill's words beside the date, such as a News item's category or an Announcement's
	 * type, or a list of them, one pill each, such as a Service's categories.
	 */
	outlined?: string | string[];
	/** An accent-warm pill's words after the outlined one, such as a Document's status. */
	attention?: string;
	/** Words that open the title in accent-warm, such as a MOIT's "MOIT n". */
	lead?: string;
	/** The title's largest size: H1 from `lg`, or H2, as a MOIT's (H2 from `sm` either way). */
	largest?: "h1" | "h2";
}

const {
	section,
	crumbs,
	title,
	summary,
	date,
	dateWords = "เผยแพร่",
	outlined,
	attention,
	lead,
	largest = "h1",
} = Astro.props;
const outlinedPills = [outlined ?? []].flat().filter(Boolean);
/** An accent-warm pill, its edge transparent so it is as high as the outlined one. */
const warmPill =
	"rounded-pill border border-transparent bg-accent-warm px-3 py-0.5 text-brand-dark";
---

<header class="flex max-w-3xl flex-col gap-6">
	<Breadcrumb onField items={breadcrumbTrail(section, crumbs)} />
	<div class="hero-enter flex flex-col gap-3">
		{(date || outlinedPills.length > 0 || attention) && (
			<p class="flex flex-wrap items-center gap-2 text-small font-semibold">
				{date && (
					<span class={warmPill}>
						{dateWords} <DateText value={date} />
					</span>
				)}
				{outlinedPills.map((words) => (
					<span class="rounded-pill border border-surface-base/40 px-3 py-0.5 wrap-anywhere">
						{words}
					</span>
				))}
				{attention && <span class={warmPill}>{attention}</span>}
			</p>
		)}
		<h1 class:list={["text-h3 wrap-anywhere sm:text-h2", largest === "h1" && "lg:text-h1"]}>
			{lead && (
				<>
					<span class="text-accent-warm">{lead}</span>{" "}
				</>
			)}
			<ThaiTitle text={title} />
		</h1>
		{summary && <p class="text-body-large wrap-anywhere whitespace-pre-line">{summary}</p>}
		<slot />
	</div>
</header>
