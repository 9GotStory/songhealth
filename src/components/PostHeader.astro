---
// A post page's header, on the deep field (Feature 006 #147; Feature 009 #285; spec #280 "Post
// page: the header"), 48 rem wide at most: the page's breadcrumb in white, then 24 px under it a
// row with "เผยแพร่" and the publication date in an accent-warm pill and a News item's category in
// an outlined white pill, both with a 1 px edge so they are as high and share a line, the title as
// the page's one H1, and the summary under it, so a story told only in its One Page is in words too
// (grill Q14). A page's other dates, such as when Health Content was last reviewed, follow in the
// default slot. The summary keeps the line breaks staff typed. A part the post lacks is left out,
// and so is the row when it holds neither pill, as a draft's preview has no publication date. Its
// text takes the field's surface-base (DeepField.astro).
//
// The page passes no `crumbs` to the shell, which then shows no breadcrumb above the page
// (src/layouts/SiteLayout.astro), and gives them here with its section, as ListHeading.astro does.
//
// With motion allowed the header's text rises in as the page opens, as the hero's does
// (`hero-enter`, src/styles/global.css; spec #280 "Motion"). The breadcrumb shows at once, so
// nothing the keyboard reaches first is held back, as on a list's heading.
import { breadcrumbTrail, type Crumb, type NavigationSection } from "../lib/navigation";
import type { Instant } from "../lib/dated-lists";
import Breadcrumb from "./Breadcrumb.astro";
import DateText from "./DateText.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	/** The main-navigation section the page belongs to, which its breadcrumb goes through. */
	section: NavigationSection;
	/** The page's own crumbs, as the shell takes them (src/layouts/SiteLayout.astro). */
	crumbs: Crumb[];
	title: string;
	summary?: string | null;
	publishedAt?: Instant;
	/** A News item's category, in a pill beside the date. */
	category?: string;
}

const { section, crumbs, title, summary, publishedAt, category } = Astro.props;
---

<header class="flex max-w-3xl flex-col gap-6">
	<Breadcrumb onField items={breadcrumbTrail(section, crumbs)} />
	<div class="hero-enter flex flex-col gap-3">
		{(publishedAt || category) && (
			<p class="flex flex-wrap items-center gap-2 text-small font-semibold">
				{publishedAt && (
					<span class="rounded-pill border border-transparent bg-accent-warm px-3 py-0.5 text-brand-dark">
						เผยแพร่ <DateText value={publishedAt} />
					</span>
				)}
				{category && (
					<span class="rounded-pill border border-surface-base/40 px-3 py-0.5 wrap-anywhere">
						{category}
					</span>
				)}
			</p>
		)}
		<h1 class="text-h3 wrap-anywhere sm:text-h2 lg:text-h1">
			<ThaiTitle text={title} />
		</h1>
		{summary && <p class="text-body-large whitespace-pre-line">{summary}</p>}
		<slot />
	</div>
</header>
