---
// A person's picture in a circle inside a ring (Feature 008 #243, the Homepage's Leadership strip;
// Feature 012 #367, the Leadership page; spec #365 "Scope of the change"): the circle, a gap, then
// the ring. Each place picks its circle's size, which sets the gap, and its ring:
// - 60 px, 76 px from `sm`, with a 4 px gap: the strip's people and a leader's card;
// - 96 px, 128 px from `sm`, with a 6 px gap: the featured first leader on the Leadership page;
// - 52 px, 60 px from `sm`, with a 2 px gap: a person's row in a unit's panel on the Personnel page
//   (Feature 012 #370; UnitPanel.astro);
// - the `warm` ring is 3 px of `accent-warm`, the strip's first person and the featured leader's;
//   the `plain` ring 2 px of `border-default`, everyone else's.
//
// The picture is decorative, because the name beside it says who it is. One whose media item was
// deleted in Admin is left out for a plain `surface-soft` circle (src/lib/media.ts), as a card
// without a picture shows.
//
// The picture covers its circle from its top, where a portrait's face is, or around the focal
// point its field's value carries (Product Owner, 2026-11-15: #298 comment 6892189972, decision 2).
// EmDash's Image writes that focal point as the picture's inline `object-position`, which wins over
// the class's top. The picture takes no placeholder, whose blurhash would have browsers drop that
// `object-position` (emdash 1.1.0 src/components/EmDashImage.astro resolveImage;
// src/components/ContentCard.astro says how).
import { Image } from "emdash/ui";
import { availableMedia } from "../lib/media";
import type { PersonnelEntry } from "../lib/personnel";

interface Props {
	/** The person's profile image, as their entry holds it. */
	picture: PersonnelEntry["data"]["profile_image"];
	/** The circle's width below `sm`, in px. */
	size: 52 | 60 | 96;
	ring: "warm" | "plain";
	/** Classes for the ring's box, such as its place in a layout. */
	class?: string;
}

const { picture: value, size, ring, class: className } = Astro.props;
const image = await availableMedia(value, Astro.locals.emdash);

const SIZES = {
	52: {
		circle: "size-13 sm:size-15",
		gap: "p-0.5",
		/** The picture's width: 3.25rem, and 3.75rem from `sm`. */
		sizes: "(min-width: 40rem) 3.75rem, 3.25rem",
	},
	60: {
		circle: "size-15 sm:size-19",
		gap: "p-1",
		/** The picture's width: 3.75rem, and 4.75rem from `sm`. */
		sizes: "(min-width: 40rem) 4.75rem, 3.75rem",
	},
	96: {
		circle: "size-24 sm:size-32",
		gap: "p-1.5",
		/** The picture's width: 6rem, and 8rem from `sm`. */
		sizes: "(min-width: 40rem) 8rem, 6rem",
	},
} as const;
const { circle, gap, sizes } = SIZES[size];
---

<span
	data-testid="person-picture"
	class:list={[
		"block shrink-0 rounded-full",
		gap,
		ring === "warm" ? "ring-3 ring-accent-warm" : "ring-2 ring-border-default",
		className,
	]}
>
	{image ? (
		<Image
			image={image}
			alt=""
			sizes={sizes}
			placeholder={false}
			class:list={[circle, "rounded-full object-cover object-top"]}
		/>
	) : (
		<span
			aria-hidden="true"
			data-testid="person-visual"
			class:list={[circle, "block rounded-full bg-surface-soft"]}
		/>
	)}
</span>
