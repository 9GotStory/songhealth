---
// The "เปิดแผนที่" link (Feature 003 #57, #105; spec #51 "Maps", "Shared building blocks"): it
// opens the place in a map app in a new tab, built from its coordinates (src/lib/map-link.ts), and
// renders nothing without both. Its accessible name says it opens a new tab. It ends in
// arrow-up-right, the site's icon for a link that leaves it (Product Owner, 2026-10-31: #51 comment
// 6536052180), which is decorative (docs/agents/lucide-astro-1.59.0.md). On a dark surface, the
// Homepage's contact card, it is surface-base underlined text in place of the outlined pill
// (Feature 008 #247): accent-warm small text is below 4.5:1 on the card's brand-primary end.
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { mapHref } from "../lib/map-link";

interface Props {
	latitude: number | null | undefined;
	longitude: number | null | undefined;
	/** The link sits on a dark surface. */
	onDark?: boolean;
}

const { latitude, longitude, onDark = false } = Astro.props;
const href = mapHref(latitude, longitude);
---

{href && (
	<a
		class:list={[
			"inline-flex min-h-11 items-center",
			onDark
				? "gap-1 font-semibold text-surface-base underline underline-offset-4"
				: "gap-2 rounded-pill border border-border-input px-5 text-label text-brand-primary hover:bg-surface-soft",
		]}
		href={href}
		target="_blank"
		rel="noopener"
	>
		เปิดแผนที่
		<span class="sr-only">(เปิดในแท็บใหม่)</span>
		<ArrowUpRight class="shrink-0" size={16} />
	</a>
)}
