---
// A Quick Access shortcut on the Homepage (Feature 008 #247; spec #239 "Quick Access"): a label
// and an arrow on the Homepage's card surface, white with the `card` shadow and no border, the
// whole card one link to a page on this site. The Homepage has its own card, and /about, /health
// and the ITA landing keep QuickLinkCard (spec #239 "Scope of the change").
//
// The arrow is arrow-right, the Homepage's arrow for a card (Product Owner, 2026-11-11: #241
// comment 6791096480, item 1), and decorative: the label names the link. Below `sm`, where the
// cards go two to a row, the label lies across the card's width at body size and the arrow on a
// row of its own at the lower right, at least 8 px below it; the card grows with its label
// (Feature 007 #194, #190 comment 6707205912, Quick Access B).
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a
	class="flex h-full min-h-22 items-center justify-between gap-4 rounded-22 bg-surface-base px-5.5 pt-5.5 pb-5 text-h3 text-text-primary shadow-card hover:text-brand-primary hover:shadow-deep motion-safe:transition-shadow max-sm:min-h-14 max-sm:flex-col max-sm:items-stretch max-sm:gap-2 max-sm:rounded-18 max-sm:px-3 max-sm:py-3 max-sm:text-body max-sm:font-semibold max-sm:[&>svg]:self-end"
	href={href}
>
	<span class="min-w-0 wrap-anywhere">
		<ThaiTitle text={label} />
	</span>
	<ArrowRight class="shrink-0 text-brand-primary" size={24} />
</a>
