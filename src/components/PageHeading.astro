---
// The heading of an inner page (Feature 003 #54): the page's one H1 and an optional lead.
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	title: string;
	lead?: string;
}

const { title, lead } = Astro.props;
---

<div class="flex flex-col gap-3">
	<h1 class="text-h3 wrap-anywhere text-brand-dark sm:text-h2 lg:text-h1">
		<ThaiTitle text={title} />
	</h1>
	{lead && <p class="max-w-prose text-body-large text-text-secondary">{lead}</p>}
</div>
