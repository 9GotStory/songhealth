---
// PROTOTYPE (throwaway, branch prototype/design): variant 3's Homepage, ชุมชน เน้นภาพ. Pictures
// lead: the Featured item's photo fills the top with a light-yellow panel over its foot, the
// newest News shows its One Page beside its story, and the Activities make a wall of One Pages
// (frame) or warm text cards (text). Large Mitr headings over Noto Sans Thai Looped text, leaf
// green with light yellow, in the `04` §3 order.
import ArrowRight from "@lucide/astro/icons/arrow-right";
import HandHeart from "@lucide/astro/icons/hand-heart";
import Search from "@lucide/astro/icons/search";
import { Image } from "emdash/ui";
import AnnouncementStatusLine from "../../../AnnouncementStatusLine.astro";
import DateText from "../../../DateText.astro";
import OfficeContactDetails from "../../../OfficeContactDetails.astro";
import Frame from "../Frame.astro";
import type { HomeProps } from "../home";
import { ACTIVITIES_PATH, activityDate, activityPath } from "../../../../lib/activities";
import { ANNOUNCEMENTS_PATH, announcementPath } from "../../../../lib/announcements";
import { HEALTH_CONTENT_PATH } from "../../../../lib/health";
import { healthContentPath } from "../../../../lib/health-content";
import {
	FILTER_LABELS,
	FILTER_PARAMS,
	directoryPath,
} from "../../../../lib/health-service-directory";
import { availableMedia } from "../../../../lib/media";
import { newsPath } from "../../../../lib/news";
import { isPortrait, thaiDateOf, thaiTitleHtml } from "../../../../lib/prototype-design";
import { MAX_QUERY_LENGTH, QUERY_PARAM } from "../../../../lib/search-matcher";
import { SERVICES_PATH, servicePath } from "../../../../lib/service-catalog";
import { termsOf } from "../../../../lib/terms";

type Props = HomeProps;
const {
	identity,
	featured,
	services,
	quickAccess,
	news,
	announcements,
	healthContent,
	directory,
	activities,
	contact,
	now,
	onepage,
	officeSummary,
} = Astro.props;
const media = Astro.locals.emdash;
const featuredImage = await availableMedia(featured?.image, media);
const lead = news[0];
const leadImage = await availableMedia(lead?.data.featured_image, media);
const activityImages = await Promise.all(
	activities.map((activity) => availableMedia(activity.data.featured_image, media)),
);
const framed = onepage === "frame";

const h2 = "font-v3-head text-v3-section-sm font-medium text-v3-forest lg:text-v3-section";
const more =
	"inline-flex min-h-11 w-fit items-center font-v3-head font-medium text-v3-leaf underline decoration-2 underline-offset-6 hover:decoration-v3-yellow";
const titleLink = "underline-offset-4 hover:text-v3-leaf hover:underline";
const control =
	"min-h-12 w-full min-w-0 rounded-pill border-2 border-v3-input bg-surface-base px-5 text-v3-body";
---

{featured ? (
	<>
		<h1 class="sr-only">{identity.title}</h1>
		<section aria-labelledby="home-featured" class="lg:page-container lg:pt-8">
			{featuredImage && !isPortrait(featuredImage) ? (
				<div class="overflow-hidden bg-v3-yellow-light lg:grid lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)] lg:items-center lg:rounded-32">
					<Image
						image={featuredImage}
						alt=""
						sizes="(min-width: 75rem) 44rem, 100vw"
						priority
						class="aspect-video w-full object-cover"
					/>
					<div class="flex flex-col items-start gap-3 p-5 sm:p-7 lg:p-10">
						<p class="rounded-pill bg-v3-forest px-3 py-1 font-v3-head text-v3-meta text-v3-yellow-light">
							เรื่องเด่นจากอำเภอสอง
						</p>
						<h2
							id="home-featured"
							class="font-v3-head text-[1.625rem] leading-9 font-medium text-balance text-v3-forest lg:text-[2.5rem] lg:leading-[3.25rem]"
							set:html={thaiTitleHtml(featured.title)}
						/>
						{featured.lead && <p class="line-clamp-3 text-v3-ink">{featured.lead}</p>}
						<a
							href={featured.href}
							class="inline-flex min-h-12 items-center gap-2 rounded-pill bg-v3-forest px-6 font-v3-head font-medium text-surface-base hover:bg-v3-leaf"
						>
							อ่านเรื่องนี้<span class="sr-only"> {featured.title}</span>
							<ArrowRight class="shrink-0" size={20} />
						</a>
					</div>
				</div>
			) : (
				<div class="mx-4 mt-4 grid items-center gap-6 rounded-24 bg-v3-yellow-light p-5 sm:grid-cols-[minmax(0,1fr)_14rem] lg:mx-0 lg:mt-0 lg:p-10">
					<div class="flex flex-col items-start gap-3">
						<p class="rounded-pill bg-v3-forest px-3 py-1 font-v3-head text-v3-meta text-v3-yellow-light">
							เรื่องเด่นจากอำเภอสอง
						</p>
						<h2
							id="home-featured"
							class="font-v3-head text-[1.625rem] leading-9 font-medium text-v3-forest lg:text-[2.5rem] lg:leading-[3.25rem]"
							set:html={thaiTitleHtml(featured.title)}
						/>
						{featured.lead && <p class="line-clamp-3">{featured.lead}</p>}
						<a
							href={featured.href}
							class="inline-flex min-h-12 items-center gap-2 rounded-pill bg-v3-forest px-6 font-v3-head font-medium text-surface-base"
						>
							อ่านเรื่องนี้<span class="sr-only"> {featured.title}</span>
							<ArrowRight class="shrink-0" size={20} />
						</a>
					</div>
					{featuredImage && (
						<Frame
							image={featuredImage}
							sizes="14rem"
							eager
							class="aspect-[210/297] w-full rounded-12 bg-surface-base"
						/>
					)}
				</div>
			)}
		</section>
	</>
) : (
	<div class="page-container pt-8">
		<h1 class="font-v3-head text-v3-display-sm font-medium text-v3-forest lg:text-v3-display">
			{identity.title}
		</h1>
	</div>
)}

<section aria-labelledby="home-search" class="page-container pt-8 lg:pt-12">
	<form
		role="search"
		method="get"
		action="/search"
		class="flex flex-col gap-3 lg:flex-row lg:items-center lg:gap-6"
	>
		<h2
			id="home-search"
			class="font-v3-head text-[1.375rem] leading-8 font-medium text-v3-forest lg:shrink-0"
		>
			<label for="home-search-query">คุณกำลังมองหาอะไร?</label>
		</h2>
		<div class="flex flex-1 gap-2">
			<input
				id="home-search-query"
				name={QUERY_PARAM}
				type="search"
				maxlength={MAX_QUERY_LENGTH}
				placeholder="บริการ ข่าว เอกสาร หรือหน่วยบริการ"
				class={control}
			/>
			<button
				type="submit"
				class="inline-flex size-12 shrink-0 cursor-pointer items-center justify-center rounded-pill bg-v3-yellow text-v3-forest sm:w-auto sm:gap-2 sm:px-6"
			>
				<Search class="shrink-0" size={20} />
				<span class="sr-only font-v3-head font-medium sm:not-sr-only">ค้นหา</span>
			</button>
		</div>
	</form>
</section>

{services.length > 0 && (
	<section
		aria-labelledby="home-services"
		class="page-container flex flex-col gap-5 pt-12 lg:pt-16"
	>
		<h2 id="home-services" class={h2}>
			วันนี้คุณต้องการทำอะไร?
		</h2>
		<ul class="grid grid-cols-2 gap-3 lg:grid-cols-3 lg:gap-4">
			{services.map((service) => (
				<li>
					<a
						href={servicePath(service.id)}
						class="flex h-full flex-col items-start gap-2 rounded-16 border-2 border-v3-line bg-surface-base p-3 hover:border-v3-leaf sm:flex-row sm:items-center sm:gap-3 lg:p-4"
					>
						<span
							aria-hidden="true"
							class="flex size-10 shrink-0 items-center justify-center rounded-pill bg-v3-yellow-light text-v3-leaf"
						>
							<HandHeart class="shrink-0" size={20} />
						</span>
						<span class="min-w-0 font-v3-head text-[0.9375rem] leading-6 text-v3-forest lg:text-[1.0625rem]">
							{service.data.title}
						</span>
					</a>
				</li>
			))}
		</ul>
		<a class={more} href={SERVICES_PATH}>
			ดูบริการทั้งหมด
		</a>
	</section>
)}

{(lead || announcements.length > 0) && (
	<section aria-labelledby="home-news" class="page-container flex flex-col gap-5 pt-12 lg:pt-16">
		<h2 id="home-news" class={h2}>
			เรื่องใหม่ในอำเภอสอง
		</h2>
		<div class="grid gap-6 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-10">
			{lead && (
				<article
					class:list={[
						"grid gap-4 rounded-24 bg-v3-yellow-light p-4 sm:p-6",
						framed && leadImage
							? "grid-cols-[8.5rem_minmax(0,1fr)] sm:grid-cols-[13rem_minmax(0,1fr)]"
							: "",
					]}
				>
					{framed && leadImage && (
						<Frame
							image={leadImage}
							sizes="13rem"
							class="aspect-[210/297] w-full rounded-12 bg-surface-base shadow-card"
						/>
					)}
					<div class="flex min-w-0 flex-col gap-2">
						<p class="text-v3-meta text-v3-muted">
							ข่าวล่าสุด
							{lead.data.publishedAt && (
								<>
									{" "}
									<DateText value={lead.data.publishedAt} />
								</>
							)}
						</p>
						<h3 class="font-v3-head text-[1.1875rem] leading-7 font-medium text-v3-forest sm:text-[1.625rem] sm:leading-9">
							<a
								class={titleLink}
								href={newsPath(lead.id)}
								set:html={thaiTitleHtml(lead.data.title)}
							/>
						</h3>
						{lead.data.summary && (
							<p class="line-clamp-4 text-v3-ink sm:line-clamp-5">{lead.data.summary}</p>
						)}
						<a class={more} href="/news">
							ข่าวทั้งหมด
						</a>
					</div>
				</article>
			)}
			{announcements.length > 0 && (
				<div class="flex flex-col gap-2">
					<h3
						id="home-announcements"
						class="font-v3-head text-[1.375rem] leading-8 font-medium text-v3-forest"
					>
						ประกาศ
					</h3>
					<ul
						aria-labelledby="home-announcements"
						class="flex flex-col divide-y-2 divide-dashed divide-v3-line"
					>
						{announcements.map((announcement) => (
							<li class="flex flex-col gap-1 py-3">
								<a
									class:list={[titleLink, "font-semibold"]}
									href={announcementPath(announcement.id)}
									set:html={thaiTitleHtml(announcement.data.title)}
								/>
								<AnnouncementStatusLine data={announcement.data} now={now} />
							</li>
						))}
					</ul>
					<a class={more} href={ANNOUNCEMENTS_PATH}>
						ประกาศทั้งหมด
					</a>
				</div>
			)}
		</div>
	</section>
)}

{healthContent.length > 0 && (
	<section aria-labelledby="home-health" class="page-container flex flex-col gap-5 pt-12 lg:pt-16">
		<h2 id="home-health" class={h2}>
			ความรู้ใกล้ตัว
		</h2>
		<ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4">
			{healthContent.map((item, index) => {
				const topic = termsOf(item.data, "topic")[0];
				return (
					<li
						class:list={[
							"flex flex-col gap-2 rounded-16 p-4 lg:p-5",
							index % 2 === 0 ? "bg-v3-yellow-light" : "border-2 border-v3-line",
						]}
					>
						{topic && <p class="text-v3-meta font-semibold text-v3-leaf">{topic.label}</p>}
						<h3 class="font-v3-head text-[1.125rem] leading-7 font-medium text-v3-forest">
							<a
								class={titleLink}
								href={healthContentPath(item.id)}
								set:html={thaiTitleHtml(item.data.title)}
							/>
						</h3>
						{item.data.summary && (
							<p class="hidden text-v3-meta text-v3-muted sm:line-clamp-2">{item.data.summary}</p>
						)}
					</li>
				);
			})}
		</ul>
		<a class={more} href={HEALTH_CONTENT_PATH}>
			ความรู้สุขภาพทั้งหมด
		</a>
	</section>
)}

{directory.hasHealthServices && (
	<section aria-labelledby="home-discovery" class="mt-12 bg-v3-yellow py-8 lg:mt-16 lg:py-12">
		<div class="page-container flex flex-col gap-4 lg:flex-row lg:items-end lg:gap-10">
			<h2
				id="home-discovery"
				class="font-v3-head text-v3-section-sm font-medium text-v3-forest lg:max-w-sm"
			>
				ค้นหาหน่วยบริการสุขภาพในอำเภอสอง
			</h2>
			<form
				method="get"
				action={directoryPath()}
				aria-label="ค้นหาหน่วยบริการ"
				class="grid flex-1 gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
			>
				<div class="flex flex-col gap-1">
					<label class="text-v3-meta font-semibold text-v3-forest" for="discovery-area">
						{FILTER_LABELS.area}
					</label>
					<select id="discovery-area" name={FILTER_PARAMS.area} class={control}>
						<option value="">{FILTER_LABELS.anyArea}</option>
						{directory.areas.map((area) => (
							<option value={area.slug}>{area.label}</option>
						))}
					</select>
				</div>
				<div class="flex flex-col gap-1">
					<label class="text-v3-meta font-semibold text-v3-forest" for="discovery-name">
						{FILTER_LABELS.name}
					</label>
					<input id="discovery-name" name={FILTER_PARAMS.name} type="search" class={control} />
				</div>
				<button
					type="submit"
					class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-pill bg-v3-forest px-6 font-v3-head font-medium text-surface-base"
				>
					ค้นหาหน่วยบริการ
				</button>
			</form>
		</div>
	</section>
)}

{activities.length > 0 && (
	<section
		aria-labelledby="home-activities"
		class="page-container flex flex-col gap-5 pt-12 lg:pt-16"
	>
		<h2 id="home-activities" class={h2}>
			สุขภาพเกิดขึ้นในชุมชน
		</h2>
		{framed ? (
			<ul class="grid grid-cols-2 gap-x-3 gap-y-6 lg:grid-cols-4 lg:gap-x-6">
				{activities.map((activity, index) => (
					<li>
						<article class="flex flex-col gap-2">
							<Frame
								image={activityImages[index]}
								sizes="(min-width: 64rem) 17rem, 50vw"
								class="aspect-[210/297] w-full rounded-16 bg-v3-yellow-light shadow-card"
							/>
							<p class="text-v3-meta text-v3-muted">{thaiDateOf(activityDate(activity.data))}</p>
							<h3 class="font-v3-head text-[1rem] leading-6 font-medium text-v3-forest lg:text-[1.1875rem] lg:leading-7">
								<a
									class={titleLink}
									href={activityPath(activity.id)}
									set:html={thaiTitleHtml(activity.data.title)}
								/>
							</h3>
						</article>
					</li>
				))}
			</ul>
		) : (
			<ul class="grid gap-3 sm:grid-cols-2 lg:gap-4">
				{activities.map((activity, index) => (
					<li>
						<article class="flex h-full gap-4 rounded-16 bg-v3-yellow-light p-4">
							<div class="flex min-w-0 flex-1 flex-col gap-1.5">
								<p class="text-v3-meta text-v3-muted">{thaiDateOf(activityDate(activity.data))}</p>
								<h3 class="font-v3-head text-[1.0625rem] leading-7 font-medium text-v3-forest">
									<a
										class={titleLink}
										href={activityPath(activity.id)}
										set:html={thaiTitleHtml(activity.data.title)}
									/>
								</h3>
								{activity.data.summary && (
									<p class="line-clamp-3 text-v3-meta text-v3-ink">{activity.data.summary}</p>
								)}
							</div>
							{activityImages[index] && (
								<Frame
									image={activityImages[index]}
									sizes="4.5rem"
									class="aspect-[210/297] w-16 rounded-8 bg-surface-base"
								/>
							)}
						</article>
					</li>
				))}
			</ul>
		)}
		<a class={more} href={ACTIVITIES_PATH}>
			ดูกิจกรรมทั้งหมด
		</a>
	</section>
)}

{quickAccess.length > 0 && (
	<section
		aria-labelledby="home-quick-access"
		class="page-container flex flex-col gap-3 pt-10 lg:flex-row lg:items-center lg:gap-6"
	>
		<h2
			id="home-quick-access"
			class="font-v3-head text-[1.375rem] leading-8 font-medium text-v3-forest"
		>
			ทางลัด
		</h2>
		<ul class="flex flex-wrap gap-2.5">
			{quickAccess.map((item) => (
				<li>
					<a
						href={item.href}
						class="inline-flex min-h-11 items-center rounded-pill border-2 border-v3-forest px-5 font-v3-head text-v3-forest hover:bg-v3-yellow-light"
					>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</section>
)}

<section aria-labelledby="home-contact" class="page-container pt-12 pb-14 lg:pt-16 lg:pb-20">
	<div class="grid gap-6 rounded-24 border-2 border-v3-line p-5 sm:p-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12 lg:p-10">
		<div class="flex flex-col gap-3">
			<h2
				id="home-contact"
				class="font-v3-head text-[1.625rem] leading-9 font-medium text-v3-forest lg:text-[2.25rem] lg:leading-[3rem]"
				set:html={thaiTitleHtml(identity.title)}
			/>
			<p class="text-v3-muted">{officeSummary}</p>
		</div>
		<div class="flex flex-col gap-2">
			<OfficeContactDetails contact={contact} summary />
			<a class={more} href="/contact">
				ดูข้อมูลติดต่อทั้งหมด
			</a>
		</div>
	</div>
</section>
