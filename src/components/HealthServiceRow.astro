---
// A Health Service as a summary (Feature 003 #57; spec #51 "Shared building blocks", the Health
// Service summary): its type and Area, its shown name linking to its own page, its official name
// when the display name differs, its address, and a status that should stop a citizen from
// travelling there (temporarily closed or inactive). The directory shows HealthServiceMapRow
// instead (Feature 011 #341); a Service's page keeps this row, its names H3 under the page's
// heading for the Health Services that offer it, until #344 (spec #338 "Decisions", 3).
import { healthServiceRowParts, type HealthServiceEntry } from "../lib/health-services";
import HealthServiceStatus from "./HealthServiceStatus.astro";
import MetaLine from "./MetaLine.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	healthService: HealthServiceEntry;
	headingLevel?: 2 | 3;
}

const { healthService, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const data = healthService.data;
const { name, href, facts, status } = healthServiceRowParts(healthService);
---

<article class="flex flex-col gap-2 rounded-24 bg-surface-base p-5 shadow-card">
	<MetaLine facts={facts} />
	<Heading class="text-body-large font-semibold wrap-anywhere text-brand-dark">
		<a class="underline-offset-4 hover:text-brand-primary hover:underline" href={href}>
			<ThaiTitle text={name} />
		</a>
	</Heading>
	{name !== data.title && <p class="text-small wrap-anywhere text-text-secondary">{data.title}</p>}
	{data.address && (
		<p class="line-clamp-2 wrap-anywhere whitespace-pre-line text-text-secondary">{data.address}</p>
	)}
	{status && (
		<p>
			<HealthServiceStatus status={status} />
		</p>
	)}
</article>
