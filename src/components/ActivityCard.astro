---
// The Activity card (Feature 003 #64; spec #51 "Shared building blocks"; Figma Card/Activity 4:48,
// docs/design/homepage-concept-v1.md §9): the Activity's picture, or the design's visual when it
// has none, then "กิจกรรม • date" by when it was held, else its publication (`04` §10), and its
// title. Its whole surface links to its page (#193; #190 comment 6707205912). The Activities
// list shows every Activity with it, adding the summary (Product Owner, 2026-10-30: #64 comment
// 6526131459); the Homepage has its own tile (HomeActivityTile, Feature 008 #247). The title is
// an H2, one level below the list's H1.
//
// The picture goes through EmDash's Image with a `sizes` for the card's box, as ContentCard's does
// (src/components/ContentCard.astro says why). A `loading` attribute overrides the component's lazy
// default, which emdash 1.1.0 src/components/EmDashImage.astro sets before the attributes it is
// given. It is decorative, because the title names the link. A picture whose media item was
// deleted in Admin is left out for the visual (src/lib/media.ts). The visual's caption is
// decoration too: the line under it says กิจกรรม.
//
// A title-named native link covers the whole surface. Metadata and summaries remain readable
// outside its label (WCAG 2.5.3; #193; #190 comment 6707205912).
import { Image } from "emdash/ui";
import { activityDate, activityPath, type ActivityEntry } from "../lib/activities";
import { CARD_PICTURE_SIZES, availableMedia } from "../lib/media";
import MetaLine from "./MetaLine.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	activity: ActivityEntry;
	/** Show the Activity's summary under its title, as the Activities list does. */
	showSummary?: boolean;
	/** Load the picture at once, for a card in view when the page opens. */
	eager?: boolean;
}

const { activity, showSummary = false, eager = false } = Astro.props;
const image = await availableMedia(activity.data.featured_image, Astro.locals.emdash);
const date = activityDate(activity.data);
const summary = showSummary ? activity.data.summary : undefined;
const titleId = `activitycard-${crypto.randomUUID()}`;
---

<article class="group relative h-full">
	<div class="flex h-full flex-col overflow-hidden rounded-22 border border-border-default bg-surface-base">
		{image ? (
			<Image
				image={image}
				alt=""
				sizes={CARD_PICTURE_SIZES}
				loading={eager ? "eager" : "lazy"}
				class="aspect-16/9 w-full object-cover"
			/>
		) : (
			<div
				aria-hidden="true"
				data-testid="activity-visual"
				class="flex aspect-16/9 w-full items-center justify-center bg-linear-to-r from-activity-visual-from to-activity-visual-to text-label text-brand-dark"
			>
				กิจกรรมในชุมชน
			</div>
		)}
		<div class="flex flex-1 flex-col gap-2 px-5 py-4.5">
			<MetaLine facts={[{ text: "กิจกรรม" }, date && { date }]} />
			<h2
				id={titleId}
				class="text-h3 wrap-anywhere text-text-primary underline-offset-4 group-hover:text-brand-primary group-hover:underline"
			>
				<ThaiTitle text={activity.data.title} />
			</h2>
			{summary && <p class="line-clamp-3 text-text-secondary">{summary}</p>}
		</div>
	</div>
	<a
		href={activityPath(activity.id)}
		aria-labelledby={titleId}
		class="absolute inset-0 rounded-22 hover:ring-2 hover:ring-brand-primary"
	/>
</article>
