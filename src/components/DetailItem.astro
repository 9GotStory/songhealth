---
// One detail of a record page, inside a <dl> (Feature 003 #55): its name and, in the slot, its
// value. The pair is grouped in a <div>, which HTML allows in a <dl>.
interface Props {
	term: string;
}

const { term } = Astro.props;
---

<div class="flex flex-col gap-1 sm:flex-row sm:gap-6">
	<dt class="text-label text-text-secondary sm:w-44 sm:shrink-0">{term}</dt>
	<dd class="wrap-anywhere">
		<slot />
	</dd>
</div>
