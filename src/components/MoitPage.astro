---
// A MOIT's page, /ita/{slug} (Feature 004 #123, #124; spec #121 "Public routes", ADR 0006; Feature
// 013 #395, #396; spec #392 "A MOIT's page: the header", "A MOIT's page: the body over the field's
// edge", decisions 3, 8 and 13). src/pages/ita/[slug].astro reads the entry and renders this for
// it.
//
// - The page opens on the deep field (DeepField.astro, the `post` field) with the Post page's
//   header (PostHeader.astro): the breadcrumb, the fiscal year's title in the outlined pill, the H1
//   with "MOIT n" in accent-warm and no larger than H2 size, the summary, and a line with how much
//   Evidence it holds, how many of its files cannot be served, and "ปรับปรุงล่าสุด" when staff set
//   it: EmDash's own timestamps do not say when the live version changed
//   (docs/agents/emdash-1.1.0.md "Public reads").
// - While the MOIT has a Requirement or Evidence, its body lies over the field's lower edge as a
//   list's does (ListBody.astro): the header ends 96 px above the edge below `sm` and 128 px from
//   `sm`, and the body starts 64 px and 88 px above it. A MOIT whose Requirements hold no Evidence
//   lies over the edge too (Product Owner, #396 comment 7080124411, item 1). A MOIT without any
//   block has nothing over the edge: its field ends 40 px under the header below `sm` and 48 px
//   from `sm`, as a Post page's without a picture, and its neighbour links follow 32 px under the
//   field below lg and 40 px from lg, or nothing does.
// - Below lg the table of contents' panel comes first, then the cards, 20 px apart; from lg two
//   columns 32 px apart, the panel 19 rem wide at the left and the cards in the rest. The panel is
//   white with the `deep` shadow, radius 24 and 12 px of padding, 16 px from `sm`, and opens with
//   "สารบัญ" after a 20 px list-checks, decorative. Below lg its links are a row that scrolls
//   sideways, each a 44 px box with a 1 px `border-default` edge and radius 14, showing the
//   Requirement's number in a `surface-soft` pill and its count, with the title naming the link for
//   assistive technology alone; from lg they are a column 4 px apart, without an edge, showing the
//   title on two lines at most, on `surface-soft` under the pointer. A Requirement without a number
//   shows "–". A link's ring stays inside the white panel, so it needs no band.
// - Each top-level Requirement is a card (RequirementCard.astro), 16 px apart. Evidence before the
//   first Requirement lies in a white card with radius 24 and 20 px of padding, 24 px from `sm`:
//   first in the cards' column with the `card` shadow, or alone over the edge with the `deep`
//   shadow where the MOIT has no Requirement, and then the page has no table of contents.
//   src/lib/ita.ts groups the blocks and src/components/EvidencePills.astro shows the Evidence; a
//   file is offered only while src/lib/media.ts downloadableFile can serve it.
// - The links to the MOITs before and after it (MoitNeighbours.astro) follow 24 px under the body.
// - The body shows at once, with motion allowed too: the table of contents jumps into the cards,
//   so a card it leads to is never held back (spec #392 "Motion").
//
// The page belongs to the ITA section, and its breadcrumb steps through its fiscal year's page
// while that page exists: an address can name the year (src/lib/ita.ts hasYearAddress) and the
// year has a published MOIT, which a draft in preview may lack. That is the rule by which
// src/pages/ita/[slug].astro serves the year's page, so the two change together. Otherwise the
// crumb is left out, not shown as text, because src/components/Breadcrumb.astro marks a crumb
// without an address as the current page.
// The entry is read by its slug, as EmDash resolves the collection's URL pattern, so the MOIT's
// number and fiscal year come from its fields.
import ListChecks from "@lucide/astro/icons/list-checks";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
	hasYearAddress,
	itaYearLabel,
	itaYearPath,
	itaYearTitle,
	moitEvidence,
	moitLabel,
	moitNeighbours,
	moitPath,
} from "../lib/ita";
import { downloadableFile } from "../lib/media";
import { publishedMoits, type MoitEntry } from "../lib/moits";
import DateText from "./DateText.astro";
import DeepField from "./DeepField.astro";
import EvidencePills from "./EvidencePills.astro";
import ListBody from "./ListBody.astro";
import MoitNeighbours from "./MoitNeighbours.astro";
import PostHeader from "./PostHeader.astro";
import RequirementCard from "./RequirementCard.astro";

interface Props {
	entry: MoitEntry;
	/** The request carries a signed preview of the entry's draft. */
	isPreview: boolean;
}

const { entry, isPreview } = Astro.props;
const moit = entry.data;
const label = moitLabel(moit.number);
const [evidence, yearMoits] = await Promise.all([
	moitEvidence(moit.evidence, {
		siteOrigin: Astro.url.origin,
		readFile: (file) => downloadableFile(file, Astro.locals.emdash),
	}),
	publishedMoits(moit.fiscal_year),
]);
const { cards } = evidence;
const counts = [
	`หลักฐาน ${evidence.total} รายการ${cards.length > 0 ? ` ใน ${cards.length} ข้อ` : ""}`,
	evidence.unavailable > 0 && `ไฟล์ที่ไม่พร้อมให้บริการ ${evidence.unavailable}`,
].filter(Boolean);
const { previous, next } = moitNeighbours(yearMoits, entry);
const hasYearPage = hasYearAddress(moit.fiscal_year) && yearMoits.length > 0;
/** Whether the body lies over the field's edge: the MOIT has a Requirement or Evidence. */
const hasCards = cards.length > 0;
const overEdge = hasCards || evidence.lead.length > 0;
---

<SiteLayout
	title={moit.seo?.title || `${label} ${moit.title} · ITA ปีงบประมาณ ${moit.fiscal_year}`}
	section="ita"
	description={moit.summary ?? undefined}
	canonical={moitPath(entry.id)}
	entry={{ collection: "moit", id: moit.id, slug: entry.id, publishedAt: moit.publishedAt }}
	noindex={isPreview}
>
	<article class:list={[!overEdge && "pb-16 lg:pb-20"]}>
		<DeepField kind="post">
			<div
				class:list={[
					"page-container relative pt-6",
					overEdge ? "pb-24 sm:pb-32" : "pb-10 sm:pb-12",
				]}
			>
				<PostHeader
					section="ita"
					crumbs={[
						...(hasYearPage
							? [{ label: itaYearLabel(moit.fiscal_year), href: itaYearPath(moit.fiscal_year) }]
							: []),
						{ label },
					]}
					title={moit.title}
					titlePrefix={label}
					largest="h2"
					outlined={itaYearTitle(moit.fiscal_year)}
					summary={moit.summary}
				>
					<p class="wrap-anywhere">
						{counts.join(" · ")}
						{moit.updated_on && (
							<>
								{" · ปรับปรุงล่าสุด "}
								<DateText value={moit.updated_on} />
							</>
						)}
					</p>
				</PostHeader>
			</div>
		</DeepField>
		{overEdge ? (
			<ListBody>
				<div class="flex flex-col gap-6">
					<div
						class:list={[
							hasCards &&
								"flex flex-col gap-5 lg:grid lg:grid-cols-[19rem_minmax(0,1fr)] lg:items-start lg:gap-8",
						]}
					>
						{hasCards && (
							/* From lg the panel scrolls on its own when it is taller than the window. Focus
							scrolls a link's box into view, not its ring, so 0.5rem kept clear at each end
							(scroll-padding) leaves room for the ring of the link at the fold (#247 retro). */
							<nav
								aria-label="สารบัญข้อกำหนด"
								class="rounded-24 bg-surface-base p-3 shadow-deep sm:p-4 lg:sticky lg:top-[calc(var(--header-offset)+1.5rem)] lg:max-h-[calc(100dvh-var(--header-offset)-3rem)] lg:scroll-py-2 lg:overflow-y-auto"
							>
								<p class="mb-2 flex items-center gap-2 px-1.5 text-label font-semibold text-brand-primary">
									<ListChecks class="shrink-0" size={20} />
									สารบัญ
								</p>
								{/* Below lg the row scrolls. Chromium leaves a focused link where it is while
								about 32 px of it shows, cut through its middle (observed with Playwright
								1.63.0's Chromium); keeping 5rem clear at each end (scroll-padding) makes focus
								scroll the link into full view. */}
								<ol class="flex scroll-px-20 gap-2 overflow-x-auto p-1.5 lg:flex-col lg:gap-1 lg:overflow-visible">
									{cards.map((card, index) => (
										<li class="shrink-0 lg:shrink">
											<a
												href={`#requirement-${index + 1}`}
												class="relative flex min-h-11 items-center gap-3 rounded-14 border border-border-default px-3 py-2 text-label text-brand-dark hover:border-brand-primary lg:border-transparent lg:px-2 lg:hover:border-transparent lg:hover:bg-surface-soft"
											>
												<span class="inline-flex min-w-7 shrink-0 items-center justify-center rounded-pill bg-surface-soft px-1.5 py-0.5 font-semibold text-brand-primary">
													{card.number || "–"}
												</span>
												{/* Below lg the link shows the number alone; the title still names it. The
										link is relative, so this text stays inside the row that scrolls, not past
										the page. */}
												<span class="sr-only lg:not-sr-only lg:grow">
													<span class="line-clamp-2">{card.title}</span>
												</span>
												<span class="shrink-0 text-text-secondary">
													{card.count}
													<span class="sr-only">{" รายการ"}</span>
												</span>
											</a>
										</li>
									))}
								</ol>
							</nav>
						)}
						<div class="flex min-w-0 flex-col gap-4">
							{evidence.lead.length > 0 && (
								<div
									data-testid="lead-evidence"
									class:list={[
										"rounded-24 bg-surface-base p-5 sm:p-6",
										hasCards ? "shadow-card" : "shadow-deep",
									]}
								>
									<EvidencePills pills={evidence.lead} />
								</div>
							)}
							{cards.map((card, index) => (
								<RequirementCard card={card} place={index + 1} />
							))}
						</div>
					</div>
					<MoitNeighbours previous={previous} next={next} />
				</div>
			</ListBody>
		) : (
			(previous || next) && (
				<div class="page-container pt-8 lg:pt-10">
					<MoitNeighbours previous={previous} next={next} />
				</div>
			)
		)}
	</article>
</SiteLayout>
