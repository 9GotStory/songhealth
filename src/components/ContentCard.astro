---
// The News card of the Homepage's Latest News (Feature 008 #244; spec #239 "Latest News") and the
// card of the News, Health News and Health Content lists (Feature 009 #283; spec #280 "The cards"),
// one piece for both (spec #280 "Scope of the change"). `kind` says where it stands: "home" under a
// Homepage section's H2, its title an H3; "list" on a list page, its title an H2 under the page's
// H1. A list's card shows three lines of title where the Homepage's small card shows two, and adds
// its label and its summary.
//
// The large card, the Homepage's newest News and the newest item of a list's first page (Feature
// 009 #284; spec #280 "The cards"), is its picture with the date in an accent-warm pill and the
// title over a brand-dark gradient (the date as the prototype shows it: Product Owner, 2026-11-12,
// #244 comment 6809892992, item 1). On a list the label follows the date in an outlined white pill
// filled with brand-dark at 40 %, which keeps its small words at 4.5:1 or more where the gradient
// is lightest (Product Owner, 2026-11-14: #284 comment 6870867641, item 1), and from `sm` the
// summary follows the title in two lines at most. The text is surface-base on the
// gradient, which is brand-dark at 80 % or more under the title's three lines at most, so it reads
// over any picture (measured with scripts/measure-text-contrast.ts over a white picture;
// docs/design/DESIGN.md §7.3, §8.6). Without a picture it shows the deep green visual (item 2) with
// an accent-warm tile near its top, in front of the gradient, which holds a 24 px icon (Product
// Owner, 2026-11-12: #244 comment 6810203896; the icon sizes of docs/design/DESIGN.md §5). The
// visual takes no pointer events (spec #239 "Accessibility"), so a press on the tile reaches the
// card's link.
//
// A small card is white: from `sm` a 16:9 picture above its text; below `sm` a compact row, a
// 120 px picture at 4:3 with the text beside it (item 3), which leaves 130 px for the title at
// 320 px, enough for "ความดันโลหิตสูง" (107 px). Its text is the date and, on a list, its label:
// from `sm` a dot and the label on the date's line, and below `sm`, where the row's 130 px hold no
// label beside the date, the whole label on the next line without the dot (Product Owner,
// 2026-11-13: #283 comment 6855983271); the title; and on a list from `sm` the summary in two lines
// at most.
// Without a picture it shows the plain visual in the picture's place, with a green tile and its
// 24 px icon, as the Featured card's does (HomeHero): the Homepage's heart, a list's own icon.
//
// One native link named by the title covers the whole card; the date, the label and the summary
// stay readable outside the link's name (WCAG 2.2 SC 2.5.3; #193; #190 comment 6707205912). The
// picture is decorative, because the title names the link, and covers its box from its middle, or
// around its focal point (docs/design/DESIGN.md §7.3). The picture takes no placeholder: EmDash
// writes the blurhash placeholder, which has no closing `;`, and the focal point's
// `object-position` as one inline declaration browsers drop, so with it the crop stays on the
// middle (emdash 1.1.0 src/components/EmDashImage.astro resolveImage;
// @unpic/placeholder/dist/index.js blurhashToImageCssString, version 0.1.2;
// docs/agents/emdash-1.1.0.md "Media"; Product Owner, 2026-11-14: #284 comment 6870867641,
// item 2; the other components: #298).
//
// Images go through EmDash's Image component (emdash 1.1.0 src/components/EmDashImage.astro). It
// gives a responsive srcset where Astro's image service may transform the media, which is the
// development server; a production build authorizes no media source, so the image service
// returns the original file and sharp is never used (src/astro/integration/index.ts
// buildImageRemotePatterns; astro 7.3.5 dist/assets/services/service.js getURL). Either way the
// card's CSS sets the picture's box, so a large or odd-shaped image never changes the card.
// `sizes` tells the browser how wide the card is, so it picks a rendition near that width rather
// than the full image (Astro keeps a given `sizes`: astro 7.3.5 dist/assets/internal.js), and a
// `loading` attribute overrides the component's lazy default. The Homepage's sizes are for the
// grid of five; with fewer than five a card can be wider from `lg`, and only the development
// runtime makes renditions (ADR 0003). A picture whose media item was deleted in Admin is left out
// and the card shows its visual, so the card never shows a broken image (src/lib/media.ts).
//
// The picture's zoom and a small card's lift under the pointer move only under
// `prefers-reduced-motion: no-preference` (spec #239 "Motion and loading"; spec #280 "The cards").
// The article keeps its place and its
// surface lifts inside it, as HomeServiceCard's does; the link covers the article, so a press on
// the strip the surface left still opens the item. As the page opens a picture's box shimmers, and
// stands plain with reduced motion preferred (`picture-shimmer`, src/styles/global.css; Feature
// 008 #249). A list's card lies over the deep field's lower edge in its first row on `/news`, so
// its focus ring has a white band on both sides (`focus-ring-banded`; Product Owner, 2026-11-13:
// #283 comment 6854670042), the large card's too.
import Heart from "@lucide/astro/icons/heart";
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import MessageSquare from "@lucide/astro/icons/message-square";
import { Image } from "emdash/ui";
import { availableMedia } from "../lib/media";
import type { ImageFieldValue } from "../lib/news";
import DateText from "./DateText.astro";
import ThaiTitle from "./ThaiTitle.astro";

/** The icons a visual can hold in place of a missing picture. */
const ICONS = { heart: Heart, "heart-pulse": HeartPulse, "message-square": MessageSquare };

interface Props {
	kind: "home" | "list";
	href: string;
	title: string;
	date?: Date | string | null;
	image?: ImageFieldValue;
	/** A list's label after the date: the News category, or the first Health Topic. */
	label?: string;
	/** A list's summary, under the title from `sm`. */
	summary?: string;
	/** The icon of the visual that stands in for a missing picture. */
	icon: keyof typeof ICONS;
	/** The large card, for the Homepage's newest News and a list's first page's newest item. */
	large?: boolean;
	/** The picture's `sizes`, where the card is wider than its kind's: a list's large card. */
	sizes?: string;
	/** Load the picture at once, for a card in view when the page opens. */
	eager?: boolean;
	/** The article's own classes, such as the large card's least height in its grid. */
	class?: string;
}

/**
 * The Homepage's large card's picture: its column beside the four small cards from `lg`, the row
 * below.
 */
const LARGE_SIZES = "(min-width: 64rem) 27rem, 100vw";

/**
 * What differs between the Homepage's small card and a list's: the title's level and its lines, the
 * picture's width (a column of the Homepage's grid of five, or of a list's three, from `lg`, half
 * the row from `sm` and 120 px below), and the link's focus ring.
 */
const KINDS = {
	home: {
		heading: "h3",
		clamp: "line-clamp-2",
		sizes: "(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 7.5rem",
		ring: undefined,
	},
	list: {
		heading: "h2",
		clamp: "line-clamp-3",
		sizes: "(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 7.5rem",
		ring: "focus-ring-banded",
	},
} as const;

const {
	kind,
	href,
	title,
	date,
	label,
	summary,
	large = false,
	eager = false,
	class: className,
} = Astro.props;
const image = await availableMedia(Astro.props.image, Astro.locals.emdash);
const Icon = ICONS[Astro.props.icon];
const { heading: Heading, clamp, ring } = KINDS[kind];
const sizes = Astro.props.sizes ?? (large ? LARGE_SIZES : KINDS[kind].sizes);
const titleId = `content-card-${crypto.randomUUID()}`;
const loading = eager ? "eager" : "lazy";
const zoom =
	"motion-safe:transition-transform motion-safe:duration-600 motion-safe:group-hover:scale-106";
---

{large ? (
	<article class:list={["group relative h-full", className]}>
		<div
			class:list={[
				"absolute inset-0 overflow-hidden rounded-24 shadow-card",
				image ? "picture-shimmer" : "bg-surface-soft",
			]}
		>
			{image ? (
				<Image
					image={image}
					alt=""
					sizes={sizes}
					loading={loading}
					placeholder={false}
					class:list={["absolute inset-0 size-full object-cover", zoom]}
				/>
			) : (
				<div
					aria-hidden="true"
					data-testid="news-visual"
					class="deep-visual pointer-events-none absolute inset-0 flex justify-center pt-10"
				>
					<span class="relative z-10 flex size-18 items-center justify-center rounded-22 bg-accent-warm text-brand-dark">
						<Icon class="shrink-0" size={24} />
					</span>
				</div>
			)}
			<div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-brand-dark/96 via-brand-dark/80 via-60% to-transparent px-5 pt-24 pb-5 text-surface-base sm:px-6.5 sm:pb-6">
				{label ? (
					<p class="mb-2.5 flex flex-wrap items-center gap-2 text-small font-semibold">
						{date && (
							<span class="rounded-pill bg-accent-warm px-3 py-0.5 text-brand-dark">
								<DateText value={date} />
							</span>
						)}
						<span class="rounded-pill border border-surface-base/40 bg-brand-dark/40 px-3 py-0.5 wrap-anywhere">
							{label}
						</span>
					</p>
				) : (
					date && (
						<p class="mb-2.5 inline-block rounded-pill bg-accent-warm px-3 py-0.5 text-small font-semibold text-brand-dark">
							<DateText value={date} />
						</p>
					)
				)}
				<Heading
					id={titleId}
					class="line-clamp-3 text-body-large font-semibold wrap-anywhere sm:text-h3"
				>
					<ThaiTitle text={title} />
				</Heading>
				{summary && <p class="mt-2 line-clamp-2 max-sm:hidden">{summary}</p>}
			</div>
		</div>
		<a href={href} aria-labelledby={titleId} class:list={["absolute inset-0 rounded-24", ring]} />
	</article>
) : (
	<article class:list={["group relative h-full", className]}>
		<div
			data-testid="news-surface"
			class="flex h-full items-center overflow-hidden rounded-22 bg-surface-base shadow-card motion-safe:transition motion-safe:duration-300 motion-safe:group-hover:-translate-y-1.5 motion-safe:group-hover:shadow-deep sm:flex-col sm:items-stretch"
		>
			<div
				class:list={[
					"relative m-2.5 aspect-4/3 w-30 shrink-0 overflow-hidden rounded-14 sm:m-0 sm:aspect-video sm:w-auto sm:rounded-none",
					image ? "picture-shimmer" : "bg-surface-soft",
				]}
			>
				{image ? (
					<Image
						image={image}
						alt=""
						sizes={sizes}
						loading={loading}
						placeholder={false}
						class:list={["absolute inset-0 size-full object-cover", zoom]}
					/>
				) : (
					<div
						aria-hidden="true"
						data-testid="news-visual"
						class="plain-visual absolute inset-0 flex items-center justify-center"
					>
						<span class="flex size-12 items-center justify-center rounded-14 bg-linear-140 from-brand-primary to-brand-dark text-accent-warm shadow-tile">
							<Icon class="shrink-0" size={24} />
						</span>
					</div>
				)}
			</div>
			<div class="min-w-0 py-2.5 pr-3.5 pl-1 sm:px-5 sm:pt-4 sm:pb-5">
				{date && (
					<p class="text-small font-semibold text-brand-primary">
						<DateText value={date} />
						{label && (
							<>
								<span aria-hidden="true" class="mx-1.5 text-text-secondary max-sm:hidden">
									·
								</span>
								<span class="font-normal wrap-anywhere text-text-secondary max-sm:block">
									{label}
								</span>
							</>
						)}
					</p>
				)}
				<Heading
					id={titleId}
					class:list={["mt-0.5 text-body font-semibold wrap-anywhere sm:text-body-large", clamp]}
				>
					<ThaiTitle text={title} />
				</Heading>
				{summary && (
					<p class="mt-1.5 line-clamp-2 text-label text-text-secondary max-sm:hidden">{summary}</p>
				)}
			</div>
		</div>
		<a href={href} aria-labelledby={titleId} class:list={["absolute inset-0 rounded-22", ring]} />
	</article>
)}
