---
// News, Health News and Health Content list cards (#193; #190 comment 6707205912).
// One title-named native link covers the whole surface. Other card text stays outside the link
// so it stays readable without becoming its visible label (WCAG 2.5.3). Pictures are decorative.
//
// Images go through EmDash's Image component (emdash 1.1.0 src/components/EmDashImage.astro). It
// gives a responsive srcset where Astro's image service may transform the media, which is the
// development server; a production build authorizes no media source, so the image service
// returns the original file and sharp is never used (src/astro/integration/index.ts
// buildImageRemotePatterns; astro 7.3.5 dist/assets/services/service.js getURL). Either way the
// card's CSS sets the picture's box, so a large or odd-shaped image never changes the card.
// `sizes` tells the browser how wide the card is, so it picks a rendition near that width rather
// than the full image (Astro keeps a given `sizes`: astro 7.3.5 dist/assets/internal.js), and a
// `loading` attribute overrides the component's lazy default.
//
// A picture whose media item was deleted in Admin is left out and the card shows its plain visual,
// so the card never shows a broken image (src/lib/media.ts).
import { Image } from "emdash/ui";
import { CARD_PICTURE_SIZES, availableMedia } from "../lib/media";
import type { ImageFieldValue } from "../lib/news";
import MetaLine from "./MetaLine.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	href: string;
	title: string;
	/** A short classification shown above the title, such as the News category. */
	label?: string;
	date?: Date | string | null;
	summary?: string;
	image?: ImageFieldValue;
	/** Load the picture at once, for a card in view when the page opens. */
	eager?: boolean;
}

const { href, title, label, date, summary, eager = false } = Astro.props;
const image = await availableMedia(Astro.props.image, Astro.locals.emdash);
const titleId = `contentcard-${crypto.randomUUID()}`;
---

<article class="group relative h-full">
	<div class="flex h-full flex-col overflow-hidden rounded-24 bg-surface-base shadow-card">
		{image ? (
			<Image
				image={image}
				alt=""
				sizes={CARD_PICTURE_SIZES}
				loading={eager ? "eager" : "lazy"}
				class="aspect-16/10 w-full object-cover"
			/>
		) : (
			<div
				aria-hidden="true"
				data-testid="card-visual"
				class="aspect-16/10 w-full bg-surface-soft"
			/>
		)}
		<div class="flex flex-1 flex-col gap-2 p-5">
			<MetaLine facts={[label && { text: label }, date && { date }]} />
			<h2
				id={titleId}
				class="text-body-large font-semibold wrap-anywhere text-brand-dark underline-offset-4 group-hover:text-brand-primary group-hover:underline"
			>
				<ThaiTitle text={title} />
			</h2>
			{summary && <p class="line-clamp-3 text-text-secondary">{summary}</p>}
		</div>
	</div>
	<a
		href={href}
		aria-labelledby={titleId}
		class="absolute inset-0 rounded-24 hover:ring-2 hover:ring-brand-primary"
	/>
</article>
