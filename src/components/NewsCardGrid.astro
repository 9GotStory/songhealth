---
// A page of News as a grid of content cards, shared by the News and Health News lists. Each card
// carries one term of `labelTaxonomy` as its label. The first row is in view when the page
// opens, so its pictures load at once; the rest load lazily.
import { newsPath, type NewsEntry } from "../lib/news";
import { termsOf } from "../lib/terms";
import ContentCard from "./ContentCard.astro";

interface Props {
	entries: NewsEntry[];
	labelTaxonomy: string;
}

const { entries, labelTaxonomy } = Astro.props;
/** Cards per row at the widest layout (lg:grid-cols-3). */
const FIRST_ROW = 3;
---

<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
	{entries.map((entry, index) => (
		<li>
			<ContentCard
				href={newsPath(entry.id)}
				title={entry.data.title}
				label={termsOf(entry.data, labelTaxonomy)[0]?.label}
				date={entry.data.publishedAt}
				summary={entry.data.summary}
				image={entry.data.featured_image}
				eager={index < FIRST_ROW}
			/>
		</li>
	))}
</ul>
