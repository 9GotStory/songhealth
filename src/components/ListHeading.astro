---
// A list page's heading on the deep field (Feature 009 #281; spec #280 "List heading", "The field
// under a heading"): the page's breadcrumb in white, the Homepage's section heading block with the
// page's H1 (SectionHeading: an accent-warm icon tile, the slashed label and the title in the
// section title's type), the lead, and, where the page has one, a pill link to a related list.
// The page passes no `crumbs` to the shell, which then shows no breadcrumb above the page
// (src/layouts/SiteLayout.astro), and gives them here with its section.
//
// The field's content ends 96 px above the field's lower edge below `sm` and 128 px from `sm`:
// the room ListBody.astro lies over. That block, what follows the heading, starts 64 px and 88 px
// above the edge. A page with nothing over the edge, /contact with no Office Contact set (Feature
// 012 #369; spec #365 decision 9), and /search in its start state (#433), pass `overEdge={false}`:
// the field then ends 40 px under its last part, the lead or /search's pill, below `sm` and 48 px
// from `sm`, as a header's field without a card does (CardOverField).
//
// The link is a white pill with brand-primary words (DESIGN.md §3.2) and a 16 px arrow-right, the
// Homepage's arrow for a heading's link (CODING_STANDARDS "Public pages"); an outlined pill's words
// read below 4.5:1 on this field (DESIGN.md §7.8). From `sm` it sits at the
// heading's right, level with the heading's top, as the prototype the look was picked from has it
// (Product Owner, 2026-11-13: #281 comment 6846855734); below `sm` it follows the lead.
//
// Links under the lead, `leadLinks`, are a list's related pages that are not its own items, such
// as /services' Health Service Directory and guides and forms (Feature 011 #339; spec #338 "The
// Service catalog", decision 15), in FieldLinks' look.
//
// /search (Feature 015 #433; spec #432 "`/search`: on the field") shows its lead in the start
// state alone, and lays the site's search pill on the field under the heading block through the
// default slot, 24 px under it below `sm` and 32 px from `sm`, as the breadcrumb is above it.
//
// The 404 page (Feature 015 #435; spec #432 "The 404 page", decisions 6 and 11) is this heading
// without a breadcrumb: it passes `crumbs={null}`. Its heading block starts 40 px under the header
// below `sm`, 56 px from `sm` and 72 px from `lg`, and with nothing over the field's edge the field
// ends 48 px, 64 px and 80 px under its last part, the links it lays under the search pill in the
// default slot (FieldLinks).
//
// With motion allowed the heading block and then the lead rise in as the page opens, as the
// hero's text does (`hero-enter`, src/styles/global.css; spec #280 "Motion"). The breadcrumb, the
// link and the links under the lead show at once, so the keyboard's first stops are never held
// back. /search's pill and the 404 page's rise in after the lead, held back for their 0.22 s as the
// hero's search is (SearchPill.astro; spec #432 "Motion"); the 404 page's links show at once.
import ArrowRight from "@lucide/astro/icons/arrow-right";
import { breadcrumbTrail, type Crumb, type NavigationSection } from "../lib/navigation";
import Breadcrumb from "./Breadcrumb.astro";
import DeepField from "./DeepField.astro";
import FieldLinks from "./FieldLinks.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
	/**
	 * The main-navigation section the page belongs to, which its breadcrumb goes through; none for
	 * a page in no section, such as /contact.
	 */
	section?: NavigationSection;
	/**
	 * The page's own crumbs, as the shell takes them (src/layouts/SiteLayout.astro); null for the
	 * 404 page, which has no breadcrumb. A list page always gives its own, so one left out does not
	 * type-check, and only the null chooses the 404 page's room.
	 */
	crumbs: Crumb[] | null;
	/** The small label above the H1. */
	label: string;
	title: string;
	/** The sentence under the H1: /search shows it in its start state alone. */
	lead?: string;
	/** A related list the heading links to, such as Health News from /news. */
	link?: { href: string; label: string };
	/** Related pages linked under the lead, in order. */
	leadLinks?: ReadonlyArray<{ href: string; label: string }>;
	/** What follows the heading lies over the field's lower edge, as on every list. */
	overEdge?: boolean;
}

const { section, crumbs, label, title, lead, link, leadLinks = [], overEdge = true } = Astro.props;
---

<DeepField kind="list">
	<div
		class:list={[
			"page-container relative flex flex-col gap-6 sm:gap-8",
			crumbs ? "pt-6" : "pt-10 sm:pt-14 lg:pt-18",
			overEdge ? "pb-24 sm:pb-32" : crumbs ? "pb-10 sm:pb-12" : "pb-12 sm:pb-16 lg:pb-20",
		]}
	>
		{crumbs && <Breadcrumb onField items={breadcrumbTrail(section, crumbs)} />}
		<div class="flex flex-col gap-5 sm:flex-row sm:justify-between sm:gap-6">
			<div class="flex min-w-0 flex-col gap-4">
				<SectionHeading level={1} surface="field" label={label} title={title} class="hero-enter">
					<slot name="icon" slot="icon" />
				</SectionHeading>
				{lead && (
					<p class="hero-enter max-w-prose text-body-large [--hero-enter-delay:0.1s]">{lead}</p>
				)}
				{leadLinks.length > 0 && <FieldLinks links={leadLinks} />}
			</div>
			{link && (
				<a
					href={link.href}
					class="inline-flex h-11 shrink-0 items-center justify-center gap-2 self-start rounded-pill border-[1.5px] border-surface-base bg-surface-base px-5 text-body font-semibold text-brand-primary hover:border-accent-warm hover:bg-accent-warm hover:text-brand-dark motion-safe:transition-colors sm:h-13 sm:px-7"
				>
					{link.label}
					<ArrowRight class="shrink-0" size={16} />
				</a>
			)}
		</div>
		<slot />
	</div>
</DeepField>
