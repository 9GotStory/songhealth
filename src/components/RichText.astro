---
// A Portable Text field rendered through EmDash's own renderer (Feature 003 #54; spec #51
// "Shared building blocks"), which brings EmDash's components for images, galleries, tables,
// embeds and the rest. The page's title is its one H1 (#51 user story 8), and the Admin editor
// offers H1 in the body too (@emdash-cms/admin 1.1.0 dist/index.js, the editor's heading levels
// 1–6), so a body H1 renders as an H2. The `rich-text` styles in src/styles/global.css set the
// typography.
import { PortableText, type PortableTextBlock } from "emdash/ui";
import BodyHeading from "./BodyHeading.astro";

interface Props {
	value: PortableTextBlock[];
}

const { value } = Astro.props;
---

<div class="rich-text">
	<PortableText value={value} components={{ block: { h1: BodyHeading } }} />
</div>
