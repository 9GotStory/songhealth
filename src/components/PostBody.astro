---
// A News or Health Content post's text after its header and picture (Feature 006 #147; spec #144
// "Post pages: News, Activity and Health Content"; Feature 009 #285): its body, its source when
// staff named one, and its Health Topics, each linking to the list it filters (TopicPills.astro),
// 2 rem apart. With none of the three it renders nothing, so PostColumns.astro leaves out the text
// (#198; #190 comment 6707205912).
import type { PortableTextBlock, TaxonomyTerm } from "emdash";
import RichText from "./RichText.astro";
import TopicPills from "./TopicPills.astro";

interface Props {
	body?: PortableTextBlock[];
	source?: string;
	topics: TaxonomyTerm[];
	/** The address of the list filtered by the topic with this slug. */
	topicHref: (slug: string) => string;
}

const { body, source, topics, topicHref } = Astro.props;
const hasBody = body && body.length > 0;
---

{(hasBody || source || topics.length > 0) && (
	<div class="flex max-w-3xl flex-col gap-8">
		{hasBody && <RichText value={body} />}
		{source && <p class="text-text-secondary">แหล่งที่มา: {source}</p>}
		<TopicPills topics={topics} href={topicHref} />
	</div>
)}
