---
// A News item in the Homepage's Latest News (Feature 008 #244; spec #239 "Latest News"). The
// Homepage has its own card, and the News lists keep ContentCard (spec #239 "Scope of the
// change").
//
// The large card, the newest News, is its picture with the date in an accent-warm pill and the
// title over a brand-dark gradient (the date as the prototype shows it: Product Owner, 2026-11-12,
// #244 comment 6809892992, item 1). The title is surface-base on the gradient, which is brand-dark
// at 80 % or more under the title's three lines at most, so it reads over any picture (measured
// with scripts/measure-text-contrast.ts over a white picture; docs/design/DESIGN.md §8.6). Without
// a picture it shows the deep green visual (item 2) with an accent-warm tile near its top, in
// front of the gradient, which holds a 24 px icon (Product Owner, 2026-11-12: #244 comment
// 6810203896; the icon sizes of docs/design/DESIGN.md §5). The visual takes no pointer events
// (spec #239 "Accessibility"), so a press on the tile reaches the card's link.
//
// A small card is a 16:9 picture, the date and the title in two lines at most. Below `sm` it is a
// compact row: a 120 px picture at 4:3 with the date and the title beside it (item 3), which leaves
// 130 px for the title at 320 px, enough for "ความดันโลหิตสูง" (107 px). Without a picture it
// shows the plain visual in the picture's place, with a green tile and its 24 px icon, as the
// Featured card's does (HomeHero).
//
// The title is an H3 under the section's H2, and a native link named by it covers the whole card;
// the date stays readable outside the link's name (WCAG 2.2 SC 2.5.3; #193; #190 comment
// 6707205912). The picture is decorative, because the title names the link, and covers its box
// from its middle, as cards show pictures (docs/design/DESIGN.md §7.3). It goes through EmDash's
// Image with a `sizes` for the card's box in the grid of five (src/components/ContentCard.astro
// says why); with fewer than five a card can be wider from `lg`, and only the development runtime
// makes renditions (ADR 0003). A picture whose media item was deleted in Admin is left out for the
// visual (src/lib/media.ts).
//
// The picture's zoom and a small card's lift under the pointer move only under
// `prefers-reduced-motion: no-preference` (spec #239 "Motion and loading"). The article keeps its
// place and its surface lifts inside it, as HomeServiceCard's does; the link covers the article,
// so a press on the strip the surface left still opens the News.
import Heart from "@lucide/astro/icons/heart";
import { Image } from "emdash/ui";
import { availableMedia } from "../lib/media";
import { newsPath, type NewsEntry } from "../lib/news";
import DateText from "./DateText.astro";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	news: NewsEntry;
	/** The large card, for the newest News. */
	large?: boolean;
	/** The article's own classes, such as the large card's least height in its grid. */
	class?: string;
}

/** The large card's width: its column beside the four small cards from `lg`, the row below. */
const LARGE_PICTURE_SIZES = "(min-width: 64rem) 27rem, 100vw";
/** A small card's width: a column of the grid of five from `lg`, half the row from `sm`. */
const SMALL_PICTURE_SIZES = "(min-width: 64rem) 22rem, (min-width: 40rem) 50vw, 7.5rem";

const { news, large = false, class: className } = Astro.props;
const image = await availableMedia(news.data.featured_image, Astro.locals.emdash);
const date = news.data.publishedAt;
const titleId = `home-news-${crypto.randomUUID()}`;
const zoom =
	"motion-safe:transition-transform motion-safe:duration-600 motion-safe:group-hover:scale-106";
---

{large ? (
	<article class:list={["group relative h-full", className]}>
		<div class="absolute inset-0 overflow-hidden rounded-24 bg-surface-soft shadow-card">
			{image ? (
				<Image
					image={image}
					alt=""
					sizes={LARGE_PICTURE_SIZES}
					class:list={["absolute inset-0 size-full object-cover", zoom]}
				/>
			) : (
				<div
					aria-hidden="true"
					data-testid="news-visual"
					class="deep-visual pointer-events-none absolute inset-0 flex justify-center pt-10"
				>
					<span class="relative z-10 flex size-18 items-center justify-center rounded-22 bg-accent-warm text-brand-dark">
						<Heart class="shrink-0" size={24} />
					</span>
				</div>
			)}
			<div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-brand-dark/96 via-brand-dark/80 via-60% to-transparent px-5 pt-24 pb-5 text-surface-base sm:px-6.5 sm:pb-6">
				{date && (
					<p class="mb-2.5 inline-block rounded-pill bg-accent-warm px-3 py-0.5 text-small font-semibold text-brand-dark">
						<DateText value={date} />
					</p>
				)}
				<h3
					id={titleId}
					class="line-clamp-3 text-body-large font-semibold wrap-anywhere sm:text-h3"
				>
					<ThaiTitle text={news.data.title} />
				</h3>
			</div>
		</div>
		<a href={newsPath(news.id)} aria-labelledby={titleId} class="absolute inset-0 rounded-24" />
	</article>
) : (
	<article class:list={["group relative h-full", className]}>
		<div
			data-testid="news-surface"
			class="flex h-full items-center overflow-hidden rounded-22 bg-surface-base shadow-card motion-safe:transition motion-safe:duration-300 motion-safe:group-hover:-translate-y-1.5 motion-safe:group-hover:shadow-deep sm:flex-col sm:items-stretch"
		>
			<div class="relative m-2.5 aspect-4/3 w-30 shrink-0 overflow-hidden rounded-14 bg-surface-soft sm:m-0 sm:aspect-video sm:w-auto sm:rounded-none">
				{image ? (
					<Image
						image={image}
						alt=""
						sizes={SMALL_PICTURE_SIZES}
						class:list={["absolute inset-0 size-full object-cover", zoom]}
					/>
				) : (
					<div
						aria-hidden="true"
						data-testid="news-visual"
						class="plain-visual absolute inset-0 flex items-center justify-center"
					>
						<span class="flex size-12 items-center justify-center rounded-14 bg-linear-140 from-brand-primary to-brand-dark text-accent-warm shadow-tile">
							<Heart class="shrink-0" size={24} />
						</span>
					</div>
				)}
			</div>
			<div class="min-w-0 py-2.5 pr-3.5 pl-1 sm:px-5 sm:pt-4 sm:pb-5">
				{date && (
					<p class="text-small font-semibold text-brand-primary">
						<DateText value={date} />
					</p>
				)}
				<h3
					id={titleId}
					class="mt-0.5 line-clamp-2 text-body font-semibold wrap-anywhere sm:text-body-large"
				>
					<ThaiTitle text={news.data.title} />
				</h3>
			</div>
		</div>
		<a href={newsPath(news.id)} aria-labelledby={titleId} class="absolute inset-0 rounded-22" />
	</article>
)}
