---
// A text link to another page on this site, ending in the "→" mark (Feature 003 #64;
// docs/design/homepage-concept-v1.md "Shared patterns": Label in brand-primary, ending in "→"),
// such as ดูกิจกรรมทั้งหมด. The mark is decorative. A label that does not say by itself where the
// link goes, such as อ่านข่าว under a News item's title, takes that title as `context`: assistive
// technology reads it after the label, and it stays out of sight (WCAG 2.2 SC 2.4.4), so the name
// still begins with the label a citizen sees (SC 2.5.3). On a dark surface it takes the light text
// and the focus ring for dark surfaces (src/styles/global.css focus-ring-on-dark).
interface Props {
	href: string;
	/** Read after the label by assistive technology only, such as the title of the item it opens. */
	context?: string;
	/** The link sits on brand-primary or brand-dark. */
	onDark?: boolean;
	/** Where the link sits in its parent, such as `mt-auto`. */
	class?: string;
}

const { href, context, onDark = false, class: className } = Astro.props;
---

<a
	class:list={[
		"inline-flex min-h-11 items-center gap-1.5 self-start text-label underline-offset-4 hover:underline",
		onDark ? "focus-ring-on-dark text-surface-base" : "text-brand-primary",
		className,
	]}
	href={href}
>
	<slot />
	{context && <span class="sr-only">{context}</span>}
	<span aria-hidden="true">→</span>
</a>
