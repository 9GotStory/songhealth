---
// Office Contact as details (Feature 003 #62; spec #51 "Public reads" (Contact)): the address
// with the "เปิดแผนที่" link built from the coordinates, the telephone number, the email address
// and the opening hours, each only when it is set, and nothing at all while none is. The telephone
// number and the email address are links while each is one number or one address
// (src/lib/contact-links.ts), and plain text otherwise. /contact shows them in a card; the
// Homepage's Contact Summary has its own card (HomeContactCard, Feature 008 #247).
import { emailHref, telephoneHref } from "../lib/contact-links";
import { mapHref } from "../lib/map-link";
import type { OfficeContact } from "../lib/office-contact-settings";
import DetailItem from "./DetailItem.astro";
import MapLink from "./MapLink.astro";

interface Props {
	contact: OfficeContact;
}

const { contact } = Astro.props;
const email = contact.email;
const hasMap = mapHref(contact.latitude, contact.longitude) !== undefined;
const telephoneLink = contact.telephone && telephoneHref(contact.telephone);
const emailLink = email && emailHref(email);
const shown =
	!!contact.address || hasMap || !!contact.telephone || !!email || !!contact.openingHours;

const linkClass =
	"inline-flex min-h-11 items-center text-brand-primary underline underline-offset-4";
---

{shown && (
	<dl class="flex max-w-3xl flex-col gap-3 rounded-24 bg-surface-base p-5 shadow-card">
		{(contact.address || hasMap) && (
			<DetailItem term="ที่ตั้ง">
				<div class="flex flex-col items-start gap-3">
					{contact.address && <p class="whitespace-pre-line">{contact.address}</p>}
					<MapLink latitude={contact.latitude} longitude={contact.longitude} />
				</div>
			</DetailItem>
		)}
		{contact.telephone && (
			<DetailItem term="โทรศัพท์">
				{telephoneLink ? (
					<a class={linkClass} href={telephoneLink}>
						{contact.telephone}
					</a>
				) : (
					contact.telephone
				)}
			</DetailItem>
		)}
		{email && (
			<DetailItem term="อีเมล">
				{emailLink ? (
					<a class={`${linkClass} wrap-anywhere`} href={emailLink}>
						{email}
					</a>
				) : (
					email
				)}
			</DetailItem>
		)}
		{contact.openingHours && (
			<DetailItem term="เวลาทำการ">
				<p class="whitespace-pre-line">{contact.openingHours}</p>
			</DetailItem>
		)}
	</dl>
)}
