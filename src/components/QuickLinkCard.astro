---
// A Quick Link card (Feature 003 #60, #105; Figma Card / Quick Link 4:43,
// docs/design/homepage-concept-v1.md §10): a label and the chevron-right icon, the whole card one
// link to a page on this site. /about links to its sub-pages with it. The icon is decorative
// (docs/agents/lucide-astro-1.59.0.md): the label names the link.
import ChevronRight from "@lucide/astro/icons/chevron-right";

interface Props {
	href: string;
	label: string;
}

const { href, label } = Astro.props;
---

<a
	class="flex h-full min-h-22 items-center justify-between gap-4 rounded-18 border border-border-default bg-surface-base px-5.5 pt-5.5 pb-5 text-h3 text-text-primary shadow-card hover:border-brand-primary hover:text-brand-primary"
	href={href}
>
	<span class="wrap-anywhere">{label}</span>
	<ChevronRight class="shrink-0 text-brand-primary" size={24} />
</a>
