---
// A list's filter form (Feature 003 #54, #57; spec #51 "Lists and filters"). It is a plain GET
// form, so it works without JavaScript and the chosen filters stay in the address. Submitting
// starts the list again from its first page, since the form carries no page number. A field is a
// select of options, or a text field such as the directory's name.
interface Option {
	value: string;
	label: string;
}

interface SelectField {
	/** The query parameter the field sets. */
	name: string;
	label: string;
	options: Option[];
	/** The current value; empty means no filter. */
	value: string;
	/** The label of the empty "any" choice. */
	anyLabel: string;
}

interface TextField {
	kind: "text";
	/** The query parameter the field sets. */
	name: string;
	label: string;
	/** The current value; empty means no filter. */
	value: string;
}

interface Props {
	/** The form's accessible name. */
	label: string;
	/** The list's address. */
	action: string;
	fields: (SelectField | TextField)[];
}

const { label, action, fields } = Astro.props;
const filtered = fields.some((field) => field.value !== "");
---

<form
	method="get"
	action={action}
	aria-label={label}
	class="flex flex-col gap-4 rounded-24 bg-surface-base p-5 shadow-card sm:flex-row sm:flex-wrap sm:items-end"
>
	{fields.map((field) => (
		<div class="flex min-w-0 flex-col gap-1.5 sm:w-72">
			<label class="text-label" for={`filter-${field.name}`}>
				{field.label}
			</label>
			{"kind" in field ? (
				<input
					id={`filter-${field.name}`}
					name={field.name}
					type="search"
					value={field.value}
					class="min-h-11 w-full min-w-0 rounded-14 border border-border-input bg-surface-base px-3 text-body"
				/>
			) : (
				<select
					id={`filter-${field.name}`}
					name={field.name}
					class="min-h-11 w-full min-w-0 rounded-14 border border-border-input bg-surface-base px-3 text-body"
				>
					<option value="">{field.anyLabel}</option>
					{field.options.map((option) => (
						<option value={option.value} selected={option.value === field.value}>
							{option.label}
						</option>
					))}
				</select>
			)}
		</div>
	))}
	<div class="flex flex-wrap items-center gap-4">
		<button
			type="submit"
			class="inline-flex min-h-11 cursor-pointer items-center rounded-pill bg-brand-primary px-6 text-label text-surface-base hover:bg-brand-dark"
		>
			แสดงผล
		</button>
		{filtered && (
			<a class="text-label text-brand-primary underline underline-offset-4" href={action}>
				ล้างตัวกรอง
			</a>
		)}
	</div>
</form>
