---
// The Service card (Feature 003 #58, #105; spec #51 "Shared building blocks"; Figma Card/Service
// 4:36, docs/design/homepage-concept-v1.md): the one uniform Service icon (approved Q12; Lucide's
// hand-heart, Product Owner, 2026-10-31: #51 comment 6536052180), the Service's name linking to its
// page and its summary. The Service catalog shows it, and the Homepage's Frequently Used Services
// reuse it (#64, #65). The icons are decorative (docs/agents/lucide-astro-1.59.0.md), because the
// title names the whole-card link (#193; #190 comment 6707205912).
// The corner icon is chevron-right, the site's icon for a link on this
// site, where the frame has "↗"; arrow-up-right marks a link that leaves it. The name is a heading
// one level below its list's own: H2 in the catalog, H3 under a Homepage section.
//
// On the Homepage, where the Frequently Used Services go two to a row below 640 px, the card takes
// its compact form there: less padding, a smaller icon box, the name at body size and no summary
// (Feature 006 #146; spec #144 "Homepage (`04`)"). Its 12 px side padding leaves "ความดันโลหิตสูง",
// the longest word a title keeps whole (107 px at body size), inside the 112 px it has at 320 px.
// The catalog keeps the full card.
// A title-named native link covers the whole surface. Metadata and summaries remain readable
// outside its label (WCAG 2.5.3; #193; #190 comment 6707205912).
import ChevronRight from "@lucide/astro/icons/chevron-right";
import HandHeart from "@lucide/astro/icons/hand-heart";
import { servicePath } from "../lib/service-catalog";
import type { ServiceEntry } from "../lib/services";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	service: ServiceEntry;
	headingLevel?: 2 | 3;
	/** The Homepage's compact form below 640 px. */
	compact?: boolean;
}

const { service, headingLevel = 2, compact = false } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
const titleId = `servicecard-${crypto.randomUUID()}`;
---

<article class="group relative h-full">
	<div
		class:list={[
			"flex h-full flex-col gap-3.5 rounded-20 border border-border-default bg-surface-base px-6 pt-6 pb-5.5 shadow-card",
			compact && "max-sm:gap-2 max-sm:rounded-16 max-sm:px-3 max-sm:pt-3.5 max-sm:pb-3",
		]}
	>
		<div class="flex items-center justify-between text-brand-primary">
			<span
				data-testid="service-icon"
				aria-hidden="true"
				class:list={[
					"flex size-11 items-center justify-center rounded-14 bg-surface-soft",
					compact && "max-sm:size-9",
				]}
			>
				<HandHeart class="shrink-0" size={24} />
			</span>
			<ChevronRight class="shrink-0" size={24} />
		</div>
		<Heading
			id={titleId}
			class:list={[
				"text-h3 wrap-anywhere text-text-primary underline-offset-4 group-hover:text-brand-primary group-hover:underline",
				compact && "max-sm:text-body max-sm:font-semibold",
			]}
		>
			<ThaiTitle text={service.data.title} />
		</Heading>
		{service.data.summary && (
			<p class:list={["line-clamp-3 text-small text-text-secondary", compact && "max-sm:hidden"]}>
				{service.data.summary}
			</p>
		)}
	</div>
	<a
		href={servicePath(service.id)}
		aria-labelledby={titleId}
		class:list={[
			"absolute inset-0 rounded-20 hover:ring-2 hover:ring-brand-primary",
			compact && "max-sm:rounded-16",
		]}
	/>
</article>
