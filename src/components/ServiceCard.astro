---
// The Service card (Feature 003 #58; spec #51 "Shared building blocks"; Figma Card/Service 4:36,
// docs/design/homepage-concept-v1.md): the one uniform Service icon (approved Q12), the Service's
// name linking to its page and its summary. The Service catalog shows it, and the Homepage's
// Frequently Used Services reuse it (#64, #65). The icon and the arrow are decorative, hidden
// from assistive technology, because the name already names the link. The arrow is "→", the
// site's mark for a link on this site; "↗" marks a link that leaves it.
import { servicePath } from "../lib/service-catalog";
import type { ServiceEntry } from "../lib/services";

interface Props {
	service: ServiceEntry;
}

const { service } = Astro.props;
---

<article class="flex h-full flex-col gap-3.5 rounded-20 border border-border-default bg-surface-base px-6 pt-6 pb-5.5 shadow-card">
	<div class="flex items-center justify-between text-h3 text-brand-primary">
		<span
			data-testid="service-icon"
			aria-hidden="true"
			class="flex size-11 items-center justify-center rounded-14 bg-surface-soft"
		>
			+
		</span>
		<span aria-hidden="true">→</span>
	</div>
	<h2 class="text-h3 wrap-anywhere text-text-primary">
		<a
			class="underline-offset-4 hover:text-brand-primary hover:underline"
			href={servicePath(service.id)}
		>
			{service.data.title}
		</a>
	</h2>
	{service.data.summary && (
		<p class="line-clamp-3 text-small text-text-secondary">{service.data.summary}</p>
	)}
</article>
