---
// The Service card (Feature 003 #58, #105; spec #51 "Shared building blocks"; Figma Card/Service
// 4:36, docs/design/homepage-concept-v1.md): the one uniform Service icon (approved Q12; Lucide's
// hand-heart, Product Owner, 2026-10-31: #51 comment 6536052180), the Service's name linking to its
// page and its summary. The Service catalog shows it, and the Homepage's Frequently Used Services
// reuse it (#64, #65). The icons are decorative (docs/agents/lucide-astro-1.59.0.md), because the
// name already names the link. The corner icon is chevron-right, the site's icon for a link on this
// site, where the frame has "↗"; arrow-up-right marks a link that leaves it. The name is a heading
// one level below its list's own: H2 in the catalog, H3 under a Homepage section.
import ChevronRight from "@lucide/astro/icons/chevron-right";
import HandHeart from "@lucide/astro/icons/hand-heart";
import { servicePath } from "../lib/service-catalog";
import type { ServiceEntry } from "../lib/services";

interface Props {
	service: ServiceEntry;
	headingLevel?: 2 | 3;
}

const { service, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h2";
---

<article class="flex h-full flex-col gap-3.5 rounded-20 border border-border-default bg-surface-base px-6 pt-6 pb-5.5 shadow-card">
	<div class="flex items-center justify-between text-brand-primary">
		<span
			data-testid="service-icon"
			aria-hidden="true"
			class="flex size-11 items-center justify-center rounded-14 bg-surface-soft"
		>
			<HandHeart class="shrink-0" size={24} />
		</span>
		<ChevronRight class="shrink-0" size={24} />
	</div>
	<Heading class="text-h3 wrap-anywhere text-text-primary">
		<a
			class="underline-offset-4 hover:text-brand-primary hover:underline"
			href={servicePath(service.id)}
		>
			{service.data.title}
		</a>
	</Heading>
	{service.data.summary && (
		<p class="line-clamp-3 text-small text-text-secondary">{service.data.summary}</p>
	)}
</article>
