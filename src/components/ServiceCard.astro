---
// The Service card (Feature 003 #58, #105; spec #51 "Shared building blocks"; Figma Card/Service
// 4:36, docs/design/homepage-concept-v1.md): the one uniform Service icon (approved Q12; Lucide's
// hand-heart, Product Owner, 2026-10-31: #51 comment 6536052180), the Service's name linking to its
// page and its summary. The Service catalog shows it; the Homepage's Frequently Used Services have
// their own card (HomeServiceCard). The icons are decorative (docs/agents/lucide-astro-1.59.0.md),
// because the title names the whole-card link (#193; #190 comment 6707205912).
// The corner icon is chevron-right, the site's icon for a link on this
// site, where the frame has "↗"; arrow-up-right marks a link that leaves it. The name is an H2,
// one level below the catalog's H1.
// A title-named native link covers the whole surface. Metadata and summaries remain readable
// outside its label (WCAG 2.5.3; #193; #190 comment 6707205912).
import ChevronRight from "@lucide/astro/icons/chevron-right";
import HandHeart from "@lucide/astro/icons/hand-heart";
import { servicePath } from "../lib/service-catalog";
import type { ServiceEntry } from "../lib/services";
import ThaiTitle from "./ThaiTitle.astro";

interface Props {
	service: ServiceEntry;
}

const { service } = Astro.props;
const titleId = `servicecard-${crypto.randomUUID()}`;
---

<article class="group relative h-full">
	<div class="flex h-full flex-col gap-3.5 rounded-20 border border-border-default bg-surface-base px-6 pt-6 pb-5.5 shadow-card">
		<div class="flex items-center justify-between text-brand-primary">
			<span
				data-testid="service-icon"
				aria-hidden="true"
				class="flex size-11 items-center justify-center rounded-14 bg-surface-soft"
			>
				<HandHeart class="shrink-0" size={24} />
			</span>
			<ChevronRight class="shrink-0" size={24} />
		</div>
		<h2
			id={titleId}
			class="text-h3 wrap-anywhere text-text-primary underline-offset-4 group-hover:text-brand-primary group-hover:underline"
		>
			<ThaiTitle text={service.data.title} />
		</h2>
		{service.data.summary && (
			<p class="line-clamp-3 text-small text-text-secondary">{service.data.summary}</p>
		)}
	</div>
	<a
		href={servicePath(service.id)}
		aria-labelledby={titleId}
		class="absolute inset-0 rounded-20 hover:ring-2 hover:ring-brand-primary"
	/>
</article>
