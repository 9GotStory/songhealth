---
// The breadcrumb on inner pages (Feature 003 #54; spec #51 user story 5, `03` §14).
//
// It follows the public information hierarchy, root first, and ends with the current page, which
// is text marked aria-current rather than a link. The separators are decorative.
export interface Crumb {
	label: string;
	/** The crumb's address; the current page, last, has none. */
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="เส้นทางนำทาง">
	<ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-text-secondary">
		{items.map((item, index) => (
			<li class="flex min-w-0 items-center gap-2">
				{index > 0 && (
					<svg
						class="size-4 shrink-0"
						aria-hidden="true"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M9 6l6 6-6 6" />
					</svg>
				)}
				{item.href === undefined ? (
					<span aria-current="page" class="wrap-anywhere text-text-primary">
						{item.label}
					</span>
				) : (
					<a
						class="text-brand-primary underline underline-offset-4 hover:text-brand-dark"
						href={item.href}
					>
						{item.label}
					</a>
				)}
			</li>
		))}
	</ol>
</nav>
