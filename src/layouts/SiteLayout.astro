---
// Songhealth public page shell (Feature 003 #52; spec #51 Presentation, ADR 0001).
//
// Every public page renders inside this layout: the utility bar, the header
// with the site identity and the main navigation (`03` §2), the page's own
// main content, and the footer. The page passes its title and the
// main-navigation section it belongs to; the shell marks that section.
//
// The layout is mobile-first and ships no client JavaScript. Below the `lg`
// breakpoint the main navigation sits in a native <details> disclosure that
// opens without JavaScript; from `lg` up it is a row in the header. Both
// placements render the same MAIN_NAVIGATION, and CSS shows exactly one. The
// menu button sits in the identity row, and the opened menu flows in the page
// and pushes it down. Without JavaScript the menu closes only from its own
// button, never with Escape or when focus moves on, so an overlay would cover
// the content focus moves on to (WCAG 2.2 SC 2.4.11).
//
// The head's metadata comes from EmDash's own EmDashHead (emdash 1.1.0
// src/components/EmDashHead.astro): the description, canonical link, Open
// Graph and Twitter tags, the default OG image from the site settings, and the
// favicon. For a page that renders a content entry it lays the entry's SEO
// panel over what the page passed, so an editor's SEO description wins over
// the summary. The <title> stays the page's own (src/page/seo-contributions.ts).
//
// An inner page passes its own crumbs, and the shell shows its breadcrumb above
// the page's main content: หน้าแรก and the page's section, then those crumbs
// (src/lib/navigation.ts breadcrumbTrail).
//
// The footer links to the reserved Basic Pages `privacy` and `accessibility`
// while they are published, before ติดต่อเรา (src/lib/basic-pages.ts). Above
// them it lists the official channels that are set (#62,
// src/lib/office-contact.ts), each a compact link to another website.
import { Font } from "astro:assets";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContentLink from "../components/ContentLink.astro";
import {
	MAIN_NAVIGATION,
	UTILITY_LINKS,
	breadcrumbTrail,
	currentMark,
	type Crumb,
	type NavigationSection,
} from "../lib/navigation";
import { footerPageLinks } from "../lib/basic-pages";
import { readOfficeContact } from "../lib/office-contact";
import { OFFICE_NAME, getSiteIdentity } from "../lib/site-identity";

interface Props {
	/** The page's own title. The Homepage passes none and is titled by the site title alone. */
	title?: string;
	/** The main-navigation section this page belongs to; none marks no section. */
	section?: NavigationSection;
	/** The page's meta description. */
	description?: string;
	/** The page's canonical address on this site, a path with any query string. */
	canonical?: string;
	/**
	 * The page's own crumbs, after หน้าแรก and its section: any page between the section and this
	 * one, then this page's title. A section's landing page passes an empty list, and its
	 * breadcrumb ends at the section. A page that omits `crumbs` has no breadcrumb.
	 */
	crumbs?: Crumb[];
	/** The content entry the page renders, by its database id and slug. */
	entry?: { collection: string; id: string; slug: string; publishedAt?: Date | string | null };
	/** Keep the page out of search engines, as for a draft preview. */
	noindex?: boolean;
}

const { title, section, description, canonical, crumbs, entry, noindex } = Astro.props;
const [identity, footerPages, { channels }] = await Promise.all([
	getSiteIdentity(Astro.url),
	footerPageLinks(),
	readOfficeContact(),
]);
const footerLinks = [...footerPages, { label: "ติดต่อเรา", href: "/contact" }];
const pageTitle =
	title === undefined ? identity.title : `${title}${identity.titleSeparator}${identity.title}`;
const publishedAt = entry?.publishedAt ? new Date(entry.publishedAt).toISOString() : undefined;
const pageContext = createPublicPageContext({
	Astro,
	kind: entry ? "content" : "custom",
	title: pageTitle,
	pageTitle: title ?? identity.title,
	description,
	canonical: canonical === undefined ? null : `${identity.origin}${canonical}`,
	content: entry && { collection: entry.collection, id: entry.id, slug: entry.slug },
	seo: noindex ? { robots: "noindex, nofollow" } : undefined,
	articleMeta: publishedAt ? { publishedTime: publishedAt } : undefined,
	siteName: identity.title,
	siteUrl: identity.origin,
});
const { pathname } = Astro.url;
const navigation = MAIN_NAVIGATION.map((item) => ({
	...item,
	current: currentMark(item, section, pathname),
}));
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<Font cssVariable="--font-noto-sans-thai" preload={[{ weight: "400" }]} />
		<EmDashHead page={pageContext} />
		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col bg-bg-page text-body text-text-primary">
		<a
			href="#main"
			class="focus-ring-on-dark absolute top-2 left-4 z-30 -translate-y-[200%] rounded-14 bg-accent-warm px-4 py-3 text-label text-text-primary focus:translate-y-0"
		>
			ข้ามไปยังเนื้อหาหลัก
		</a>
		<header class="bg-surface-base">
			<div class="focus-ring-on-dark bg-brand-dark text-small text-surface-base">
				<div class="page-container flex min-h-10.5 flex-wrap items-center justify-between gap-x-6 gap-y-1 py-1.5">
					<p>{OFFICE_NAME}</p>
					<ul class="flex gap-5">
						{UTILITY_LINKS.map((link) => (
							<li>
								<a class="underline-offset-4 hover:underline" href={link.href}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
			<div class="relative">
				<div class="page-container flex items-start justify-between gap-4 py-3 lg:min-h-22 lg:items-center">
					<a href="/" class="mr-28 flex min-w-0 items-start gap-3 lg:mr-0 lg:items-center">
						{/* The logo or mark is decorative: the title beside it names the link. */}
						{identity.logo ? (
							<img
								class="size-11 shrink-0 object-contain lg:size-12"
								src={identity.logo.url}
								alt=""
								width={identity.logo.width ?? 48}
								height={identity.logo.height ?? 48}
							/>
						) : (
							<span
								data-testid="placeholder-mark"
								aria-hidden="true"
								class="flex size-11 shrink-0 items-center justify-center rounded-16 bg-brand-primary text-surface-base lg:size-12"
							>
								<svg class="size-6 lg:size-7" viewBox="0 0 24 24" fill="currentColor">
									<path d="M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z" />
								</svg>
							</span>
						)}
						<span class="flex min-w-0 flex-col pt-2 lg:pt-0">
							<span class="text-body font-semibold wrap-anywhere text-brand-dark sm:text-body-large lg:text-h3">
								{identity.title}
							</span>
							{identity.tagline && (
								<span class="text-small wrap-anywhere text-text-secondary">{identity.tagline}</span>
							)}
						</span>
					</a>
					<nav aria-label="เมนูหลัก" class="hidden shrink-0 lg:block">
						<ul class="flex gap-6 text-label">
							{navigation.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={item.current}
										class:list={[
											"block border-b-3 py-2 hover:text-brand-primary",
											item.current
												? "border-brand-primary text-brand-primary"
												: "border-transparent",
										]}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</div>
				<details class="group lg:hidden">
					<summary class="absolute top-3 right-(--page-gutter) flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-pill border border-border-input bg-surface-base px-4 text-label [&::-webkit-details-marker]:hidden">
						<svg
							class="size-5 group-open:hidden"
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
						>
							<path d="M4 6h16M4 12h16M4 18h16" />
						</svg>
						<svg
							class="hidden size-5 group-open:block"
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
						>
							<path d="M6 6l12 12M18 6L6 18" />
						</svg>
						<span>เมนู</span>
					</summary>
					<nav aria-label="เมนูหลัก" class="border-t border-border-default">
						<ul class="page-container py-2">
							{navigation.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={item.current}
										class:list={[
											"block border-l-4 px-4 py-3 hover:bg-surface-soft",
											item.current
												? "border-brand-primary bg-surface-soft font-semibold text-brand-primary"
												: "border-transparent",
										]}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
			</div>
		</header>
		<main id="main" tabindex="-1" class="flex-1">
			{crumbs && (
				<div class="page-container pt-6">
					<Breadcrumb items={breadcrumbTrail(section, crumbs)} />
				</div>
			)}
			<slot />
		</main>
		<footer class="focus-ring-on-dark bg-brand-dark text-surface-base">
			<div class="page-container flex flex-col gap-6 py-12 lg:flex-row lg:items-start lg:justify-between">
				<div class="flex flex-col gap-1.5">
					<p class="text-h3 wrap-anywhere">{identity.title}</p>
					<p class="text-small">{OFFICE_NAME}</p>
				</div>
				<div class="flex flex-col gap-4 text-small lg:items-end">
					{channels.length > 0 && (
						<div class="flex flex-col gap-2 lg:items-end">
							<p id="footer-channels" class="font-semibold">
								ช่องทางทางการ
							</p>
							<ul aria-labelledby="footer-channels" class="flex flex-wrap gap-x-6 gap-y-2">
								{channels.map((channel) => (
									<li>
										<ContentLink
											compact
											class="underline-offset-4 hover:underline"
											href={channel.href}
										>
											{channel.label}
										</ContentLink>
									</li>
								))}
							</ul>
						</div>
					)}
					<ul class="flex flex-wrap gap-x-6 gap-y-2">
						{footerLinks.map((link) => (
							<li>
								<a class="underline-offset-4 hover:underline" href={link.href}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
		</footer>
	</body>
</html>
