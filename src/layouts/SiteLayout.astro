---
// Songhealth public page shell (Feature 003 #52; spec #51 Presentation, ADR 0001).
//
// Every public page renders inside this layout: the utility bar, the header
// with the site identity and the main navigation (`03` §2), the page's own
// main content, and the footer. The page passes its title and the
// main-navigation section it belongs to; the shell marks that section.
//
// The layout is mobile-first and ships no client JavaScript. Below the `lg`
// breakpoint the main navigation sits in a native <details> disclosure that
// opens without JavaScript; from `lg` up it is a row in the header. Both
// placements render the same MAIN_NAVIGATION, and CSS shows exactly one.
import "../styles/global.css";
import { MAIN_NAVIGATION, UTILITY_LINKS, currentMark, type Section } from "../lib/navigation";
import { OFFICE_NAME, getSiteIdentity } from "../lib/site-identity";

interface Props {
	/** The page's own title. The Homepage passes none and is titled by the site title alone. */
	title?: string;
	/** The main-navigation section this page belongs to; none marks no section. */
	section?: Section;
}

const { title, section } = Astro.props;
const identity = await getSiteIdentity();
const pageTitle = title === undefined ? identity.title : `${title} | ${identity.title}`;
const { pathname } = Astro.url;
const navigation = MAIN_NAVIGATION.map((item) => ({
	...item,
	current: currentMark(item, section, pathname),
}));
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col bg-bg-page text-body text-text-primary">
		<header class="relative bg-surface-base">
			<div class="focus-ring-on-dark bg-brand-dark text-small text-surface-base">
				<div
					class="mx-auto flex min-h-10.5 max-w-content flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-1.5 sm:px-6"
				>
					<p>{OFFICE_NAME}</p>
					<ul class="flex gap-5">
						{UTILITY_LINKS.map((link) => (
							<li>
								<a class="underline-offset-4 hover:underline" href={link.href}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
			</div>
			<div
				class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:min-h-22"
			>
				<a href="/" class="flex min-w-0 items-center gap-3">
					{identity.logo ? (
						<img
							class="size-10 shrink-0 object-contain lg:size-12"
							src={identity.logo.url}
							alt=""
							width={identity.logo.width ?? 48}
							height={identity.logo.height ?? 48}
						/>
					) : (
						<span
							data-testid="placeholder-mark"
							aria-hidden="true"
							class="flex size-10 shrink-0 items-center justify-center rounded-16 bg-brand-primary text-surface-base lg:size-12"
						>
							<svg class="size-6 lg:size-7" viewBox="0 0 24 24" fill="currentColor">
								<path d="M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7z" />
							</svg>
						</span>
					)}
					<span class="flex min-w-0 flex-col">
						<span class="text-body font-semibold wrap-anywhere text-brand-dark sm:text-body-large lg:text-h3">
							{identity.title}
						</span>
						{identity.tagline && (
							<span class="text-small wrap-anywhere text-text-secondary">{identity.tagline}</span>
						)}
					</span>
				</a>
				<nav aria-label="เมนูหลัก" class="hidden shrink-0 lg:block">
					<ul class="flex gap-6 text-label">
						{navigation.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={item.current}
									class:list={[
										"block border-b-3 py-2 hover:text-brand-primary",
										item.current ? "border-brand-primary text-brand-primary" : "border-transparent",
									]}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
				<details class="group shrink-0 lg:hidden">
					<summary
						class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-pill border border-border-input px-4 text-label [&::-webkit-details-marker]:hidden"
					>
						<svg
							class="size-5 group-open:hidden"
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
						>
							<path d="M4 6h16M4 12h16M4 18h16" />
						</svg>
						<svg
							class="hidden size-5 group-open:block"
							aria-hidden="true"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
						>
							<path d="M6 6l12 12M18 6L6 18" />
						</svg>
						<span>เมนู</span>
					</summary>
					<nav
						aria-label="เมนูหลัก"
						class="absolute inset-x-0 top-full z-20 border-y border-border-default bg-surface-base shadow-card"
					>
						<ul class="mx-auto max-w-content px-4 py-2 sm:px-6">
							{navigation.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={item.current}
										class:list={[
											"block border-l-4 px-4 py-3 hover:bg-surface-soft",
											item.current
												? "border-brand-primary bg-surface-soft font-semibold text-brand-primary"
												: "border-transparent",
										]}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				</details>
			</div>
		</header>
		<main id="main" tabindex="-1" class="flex-1">
			<slot />
		</main>
		<footer class="focus-ring-on-dark bg-brand-dark text-surface-base">
			<div
				class="mx-auto flex max-w-content flex-col gap-6 px-4 py-12 sm:px-6 lg:flex-row lg:items-start lg:justify-between"
			>
				<div class="flex flex-col gap-1.5">
					<p class="text-h3 wrap-anywhere">{identity.title}</p>
					<p class="text-small">{OFFICE_NAME}</p>
				</div>
				<ul class="flex flex-wrap gap-x-6 gap-y-2 text-small">
					<li>
						<a class="underline-offset-4 hover:underline" href="/contact">ติดต่อเรา</a>
					</li>
				</ul>
			</div>
		</footer>
	</body>
</html>
