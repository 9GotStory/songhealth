---
// Songhealth public page shell (Feature 003 #52; spec #51 Presentation, ADR 0001; the look of
// Feature 008 #240, spec #239 "Header (every page)" and "Footer (every page)").
//
// Every public page renders inside this layout: the sticky header with the site identity, the
// main navigation (`03` §2) and the search link, the page's own main content, and the footer. The
// page passes its title and the main-navigation section it belongs to; the shell marks that
// section. There is no utility bar: its ค้นหา is the header's search link at every width, and
// /contact is reached from the footer (Product Owner, #239 comment 6786536858).
//
// The layout is mobile-first and ships no client JavaScript. Below the `lg` breakpoint the main
// navigation sits in a native <details> disclosure that opens without JavaScript; from `lg` up it
// is a row in the header. Both placements render the same MAIN_NAVIGATION, and CSS shows exactly
// one. The menu button sits in the header's row, and the opened menu is part of the header's
// flow: at the top of the page it pushes the page down, and it stays with the header while the
// page scrolls. Without JavaScript the menu closes only from its own button, never with Escape or
// when focus moves on, so focus that moves on into the page scrolls to below the open menu
// (src/styles/global.css, scroll-padding-top from --menu-height; WCAG 2.2 SC 2.4.11). The button
// shows Lucide's menu icon while closed and x while open. Screen-reader-only open/close labels
// name its state (#191; PO #190 comment 6707205912, Header B); the icons are decorative
// (docs/agents/lucide-astro-1.59.0.md).
//
// The skip link is the header's first link and shows below the header when it takes focus, so it
// never covers the logo.
//
// The head's metadata comes from EmDash's own EmDashHead (emdash 1.1.0
// src/components/EmDashHead.astro): the description, canonical link, Open
// Graph and Twitter tags, the default OG image from the site settings, and the
// favicon. For a page that renders a content entry it lays the entry's SEO
// panel over what the page passed, so an editor's SEO description wins over
// the summary. The <title> stays the page's own (src/page/seo-contributions.ts).
//
// An inner page passes its own crumbs, and the shell shows its breadcrumb above
// the page's main content: หน้าแรก and the page's section, then those crumbs
// (src/lib/navigation.ts breadcrumbTrail). A page whose heading lies on the deep
// field passes none and shows the same breadcrumb on its field
// (src/components/ListHeading.astro; spec #280 "Scope of the change").
//
// The footer links to the reserved Basic Pages `privacy` and `accessibility`
// while they are published, before ติดต่อเรา (src/lib/basic-pages.ts). Above
// them it lists the official channels that are set (#62,
// src/lib/office-contact.ts), each a compact link to another website, shown as a pill.
import ChevronRight from "@lucide/astro/icons/chevron-right";
import Menu from "@lucide/astro/icons/menu";
import Search from "@lucide/astro/icons/search";
import X from "@lucide/astro/icons/x";
import { Font } from "astro:assets";
import { createPublicPageContext } from "emdash/page";
import { EmDashHead } from "emdash/ui";
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ContentLink from "../components/ContentLink.astro";
import SiteLogo from "../components/SiteLogo.astro";
import ThaiTitle from "../components/ThaiTitle.astro";
import {
	MAIN_NAVIGATION,
	breadcrumbTrail,
	currentMark,
	type Crumb,
	type NavigationSection,
} from "../lib/navigation";
import { footerPageLinks } from "../lib/basic-pages";
import { readOfficeContact } from "../lib/office-contact";
import { OFFICE_AFFILIATION, getSiteIdentity } from "../lib/site-identity";

interface Props {
	/**
	 * The page's title in the browser tab and search results, before the site title: an entry page
	 * passes its SEO title when its SEO panel sets one, else its own title. The page's heading and
	 * its last crumb keep its own title. The Homepage passes none and is titled by the site title
	 * alone.
	 */
	title?: string;
	/** The main-navigation section this page belongs to; none marks no section. */
	section?: NavigationSection;
	/** The page's meta description. */
	description?: string;
	/** The page's canonical address on this site, a path with any query string. */
	canonical?: string;
	/**
	 * The page's own crumbs, after หน้าแรก and its section: any page between the section and this
	 * one, then this page's title. A section's landing page passes an empty list, and its
	 * breadcrumb ends at the section. A page that omits `crumbs` has no breadcrumb from the shell:
	 * the Homepage has none, and a page with its heading on the deep field shows its own there.
	 */
	crumbs?: Crumb[];
	/** The content entry the page renders, by its database id and slug. */
	entry?: { collection: string; id: string; slug: string; publishedAt?: Date | string | null };
	/** Keep the page out of search engines, as for a draft preview. */
	noindex?: boolean;
}

const { title, section, description, canonical, crumbs, entry, noindex } = Astro.props;
const [identity, footerPages, { channels }] = await Promise.all([
	getSiteIdentity(Astro.url),
	footerPageLinks(),
	readOfficeContact(),
]);
const footerLinks = [...footerPages, { label: "ติดต่อเรา", href: "/contact" }];
const pageTitle =
	title === undefined ? identity.title : `${title}${identity.titleSeparator}${identity.title}`;
const publishedAt = entry?.publishedAt ? new Date(entry.publishedAt).toISOString() : undefined;
const pageContext = createPublicPageContext({
	Astro,
	kind: entry ? "content" : "custom",
	title: pageTitle,
	pageTitle: title ?? identity.title,
	description,
	canonical: canonical === undefined ? null : `${identity.origin}${canonical}`,
	content: entry && { collection: entry.collection, id: entry.id, slug: entry.slug },
	seo: noindex ? { robots: "noindex, nofollow" } : undefined,
	articleMeta: publishedAt ? { publishedTime: publishedAt } : undefined,
	siteName: identity.title,
	siteUrl: identity.origin,
});
const { pathname } = Astro.url;
const navigation = MAIN_NAVIGATION.map((item) => ({
	...item,
	current: currentMark(item, section, pathname),
}));
/** A navigation item's look in both placements: the current one a soft green pill. */
const itemState = (current: string | undefined) =>
	current ? "bg-surface-soft font-semibold text-brand-primary" : "font-medium";
// The open menu's height below `lg`: 57 px for each item and 16 px of padding. An item is a 56 px
// row, and each of the panel's 1 px lines, its top border and the separators between rows, makes
// one line for each item. The page's scroll padding adds this height while the menu is open.
const menuHeight = `calc(${navigation.length} * 3.5625rem + 1rem)`;
---

<!doctype html>
<html lang="th" style={`--menu-height:${menuHeight}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<Font cssVariable="--font-noto-sans-thai" preload={[{ weight: "400" }]} />
		<EmDashHead page={pageContext} />
		<slot name="head" />
	</head>
	<body class="flex min-h-dvh flex-col bg-bg-page text-body text-text-primary">
		<header class="sticky top-0 z-20 bg-surface-base/90 shadow-header backdrop-blur-md">
			<a
				href="#main"
				class="pointer-events-none absolute top-full left-(--page-gutter) mt-2 rounded-pill bg-accent-warm px-4 py-2 text-label text-text-primary opacity-0 shadow-card focus:pointer-events-auto focus:opacity-100"
			>
				ข้ามไปยังเนื้อหาหลัก
			</a>
			<div class="page-container flex min-h-17 items-start gap-2.5 py-2.5 sm:min-h-21 sm:gap-4 sm:py-4.5 lg:items-center">
				<a href="/" class="mr-auto flex min-w-0 items-center gap-2.5 self-center sm:gap-3">
					<SiteLogo logo={identity.logo} />
					<span class="flex min-w-0 flex-col">
						<span class="text-body leading-(--text-label--line-height) font-bold wrap-anywhere text-brand-dark sm:text-body-large lg:header-title">
							<ThaiTitle text={identity.title} />
						</span>
						{identity.tagline && (
							<span class="text-small wrap-anywhere text-text-secondary-on-soft">
								{identity.tagline}
							</span>
						)}
					</span>
				</a>
				<nav aria-label="เมนูหลัก" class="hidden shrink-0 lg:block">
					<ul class="flex gap-0.5">
						{navigation.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={item.current}
									class:list={[
										"block rounded-pill py-2 header-nav-item hover:bg-surface-soft hover:text-brand-primary",
										itemState(item.current),
									]}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
				{/* Below `lg` the margin keeps the menu button's place in the row. */}
				<a
					href="/search"
					class="mr-14.5 flex size-12 shrink-0 items-center justify-center rounded-pill bg-surface-soft text-brand-primary hover:bg-brand-primary hover:text-surface-base sm:mr-16 lg:mr-0"
				>
					<Search class="shrink-0" size={20} />
					<span class="sr-only">ค้นหา</span>
				</a>
			</div>
			<details id="site-menu" class="group lg:hidden">
				<summary class="absolute top-2.5 right-(--page-gutter) flex size-12 cursor-pointer list-none items-center justify-center rounded-14 bg-surface-soft text-brand-primary group-open:bg-brand-primary group-open:text-surface-base sm:top-4.5 [&::-webkit-details-marker]:hidden">
					<Menu class="shrink-0 group-open:hidden" size={20} />
					<X class="hidden shrink-0 group-open:block" size={20} />
					<span class="sr-only group-open:hidden">เปิดเมนู</span>
					<span class="sr-only hidden group-open:block">ปิดเมนู</span>
				</summary>
				<nav
					aria-label="เมนูหลัก"
					class="max-h-[calc(100dvh-var(--header-offset))] overflow-y-auto border-t border-border-default bg-surface-base"
				>
					<ul class="page-container py-2">
						{navigation.map((item) => (
							<li class="border-b border-border-default last:border-b-0">
								<a
									href={item.href}
									aria-current={item.current}
									class:list={[
										"flex min-h-14 items-center justify-between gap-3 rounded-14 px-3 text-body-large hover:bg-surface-soft hover:text-brand-primary",
										itemState(item.current),
									]}
								>
									{item.label}
									<ChevronRight class="shrink-0 text-brand-primary" size={16} />
								</a>
							</li>
						))}
					</ul>
				</nav>
			</details>
		</header>
		<main id="main" tabindex="-1" class="flex-1">
			{crumbs && (
				<div class="page-container pt-6">
					<Breadcrumb items={breadcrumbTrail(section, crumbs)} />
				</div>
			)}
			<slot />
		</main>
		<footer class="focus-ring-on-dark rounded-t-24 bg-brand-dark text-surface-base sm:rounded-t-32">
			<div class="page-container flex flex-wrap items-center gap-x-8 gap-y-6 py-9">
				<div class="mr-auto flex min-w-0 items-center gap-3">
					<SiteLogo logo={identity.logo} deep />
					<div class="min-w-0">
						<p class="text-body-large font-bold wrap-anywhere">
							<ThaiTitle text={identity.title} />
						</p>
						<p class="text-small text-surface-base/70">{OFFICE_AFFILIATION}</p>
					</div>
				</div>
				{channels.length > 0 && (
					<div class="flex flex-wrap items-center gap-2 text-label">
						<p id="footer-channels" class="mr-1 text-surface-base/70">
							ช่องทางทางการ
						</p>
						<ul aria-labelledby="footer-channels" class="flex flex-wrap gap-2">
							{channels.map((channel) => (
								<li>
									<ContentLink
										compact
										class="inline-flex items-center gap-1.5 rounded-pill border border-surface-base/20 bg-surface-base/10 px-3.5 py-1.5 hover:border-accent-warm hover:bg-accent-warm hover:text-brand-dark"
										href={channel.href}
									>
										{channel.label}
									</ContentLink>
								</li>
							))}
						</ul>
					</div>
				)}
				<nav
					aria-label="ลิงก์ท้ายหน้า"
					class="basis-full border-t border-surface-base/15 pt-5 text-label"
				>
					<ul class="flex flex-wrap gap-x-7 gap-y-2">
						{footerLinks.map((link) => (
							<li>
								<a
									class="inline-block py-0.5 text-surface-base/85 underline-offset-4 hover:text-accent-warm hover:underline"
									href={link.href}
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</footer>
	</body>
</html>
