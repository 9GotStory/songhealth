---
// Health News, /news/health (Feature 003 #54; spec #51 "Public reads"): published News tagged
// with any Health Topic (`topic` term), newest first. `?topic=<slug>` narrows it to one Health
// Topic. The filter offers only the Health Topics that published News carries (src/lib/terms.ts
// offeredTerms); any other topic simply matches nothing. The unfiltered list asks for the offered
// topics, which select the same News as every topic would, since they are the ones News carries.
//
// The canonical address keeps the chosen Health Topic and a valid page number, so each view stays
// its own address for search engines.
//
// The page opens on the deep field (Feature 009 #282; spec #280 "List heading"; ListHeading), under
// the News section's label "ข่าวสาร" and its H1, with the heart-pulse icon and no link. The filter
// form comes first over the field's lower edge, then the cards or the empty state, then the pager
// (ListBody; spec #280 "What follows a list's heading").
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import ContentCardGrid from "../../components/ContentCardGrid.astro";
import EmptyState from "../../components/EmptyState.astro";
import FilterForm from "../../components/FilterForm.astro";
import ListBody from "../../components/ListBody.astro";
import ListHeading from "../../components/ListHeading.astro";
import Pagination from "../../components/Pagination.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
	HEALTH_NEWS_TITLE,
	NEWS_HEADING,
	healthNewsPath,
	listNews,
	newsPath,
} from "../../lib/news";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../../lib/pagination";
import { TOPIC_PARAM, offeredTerms } from "../../lib/terms";

const title = HEALTH_NEWS_TITLE;
const lead = "ข่าวสารด้านสุขภาพจากสำนักงานสาธารณสุขอำเภอสอง เลือกประเด็นสุขภาพที่สนใจได้";
const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM));
const topic = Astro.url.searchParams.get(TOPIC_PARAM)?.trim() ?? "";
const topics = await offeredTerms("news", "topic");
const { entries, hasMore } = await listNews(
	page,
	topic === "" ? topics.map((term) => term.slug) : [topic],
);
const listUrl = new URL(healthNewsPath(topic), Astro.url);
---

<SiteLayout title={title} section="news" description={lead} canonical={pageHref(listUrl, page)}>
	<ListHeading
		section="news"
		crumbs={[{ label: title }]}
		label={NEWS_HEADING.label}
		title={title}
		lead={lead}
	>
		<HeartPulse slot="icon" class="shrink-0" size={24} />
	</ListHeading>
	<ListBody>
		<FilterForm
			label="กรองข่าวสุขภาพ"
			action={healthNewsPath()}
			fields={[
				{
					name: TOPIC_PARAM,
					label: "ประเด็นสุขภาพ",
					anyLabel: "ทุกประเด็น",
					value: topic,
					options: topics.map((term) => ({ value: term.slug, label: term.label })),
				},
			]}
		/>
		{entries.length > 0 ? (
			<ContentCardGrid entries={entries} labelTaxonomy="topic" pathOf={newsPath} />
		) : page > 1 ? (
			<EmptyState
				message="ไม่พบข่าวในหน้านี้"
				action={{ href: pageHref(listUrl, 1), label: "กลับไปหน้าแรกของรายการ" }}
			/>
		) : topic !== "" ? (
			<EmptyState
				message="ไม่พบข่าวสุขภาพในประเด็นนี้"
				action={{ href: healthNewsPath(), label: "ดูข่าวสุขภาพทุกประเด็น" }}
			/>
		) : (
			<EmptyState message="ยังไม่มีข่าวสุขภาพ" />
		)}
		{entries.length > 0 && <Pagination page={page} hasMore={hasMore} />}
	</ListBody>
</SiteLayout>
