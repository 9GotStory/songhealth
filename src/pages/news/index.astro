---
// The News list, /news (Feature 003 #54; spec #51 "Public reads", `03` §19): published News,
// newest publication first, a fixed number per page with the page number in the query string.
//
// The canonical address keeps a valid page number, so each page of older News stays its own
// address for search engines; a page number that is not one is dropped (src/lib/pagination.ts).
import EmptyState from "../../components/EmptyState.astro";
import NewsCardGrid from "../../components/NewsCardGrid.astro";
import PageHeading from "../../components/PageHeading.astro";
import Pagination from "../../components/Pagination.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { healthNewsPath, listNews } from "../../lib/news";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../../lib/pagination";

const title = "ข่าวสาร";
const lead = "ข่าวและประชาสัมพันธ์จากสำนักงานสาธารณสุขอำเภอสอง";
const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM));
const { entries, hasMore } = await listNews(page);
const listUrl = new URL("/news", Astro.url);
---

<SiteLayout
	title={title}
	section="news"
	description={lead}
	canonical={pageHref(listUrl, page)}
	breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: title }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead}>
			<p>
				<a
					class="text-label text-brand-primary underline underline-offset-4"
					href={healthNewsPath()}
				>
					ดูเฉพาะข่าวสุขภาพ
				</a>
			</p>
		</PageHeading>
		{entries.length > 0 ? (
			<NewsCardGrid entries={entries} labelTaxonomy="news_category" />
		) : page > 1 ? (
			<EmptyState
				message="ไม่พบข่าวในหน้านี้"
				action={{ href: pageHref(listUrl, 1), label: "กลับไปหน้าแรกของรายการ" }}
			/>
		) : (
			<EmptyState message="ยังไม่มีข่าว" />
		)}
		{entries.length > 0 && <Pagination page={page} hasMore={hasMore} />}
	</div>
</SiteLayout>
