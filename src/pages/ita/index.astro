---
// The ITA landing, /ita (Feature 004 #124; spec #121 "Public routes", ADR 0006): what the ITA is,
// in the GLOSSARY's words, and a card for each fiscal year that has a published MOIT, newest
// first, with how many MOITs it has (src/lib/ita.ts itaYears), each leading to the year's page.
// While no MOIT is published it says so. The years come from the published MOITs, as ADR 0006
// keeps no year record (src/lib/moits.ts).
import ChevronRight from "@lucide/astro/icons/chevron-right";
import EmptyState from "../../components/EmptyState.astro";
import PageHeading from "../../components/PageHeading.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { ITA_PATH, itaYearPath, itaYears } from "../../lib/ita";
import { publishedMoits } from "../../lib/moits";

const title = "การประเมินคุณธรรมและความโปร่งใส (ITA)";
const lead =
	"การประเมินคุณธรรมและความโปร่งใส (MOPH ITA) คือการประเมินสำนักงานสาธารณสุขอำเภอสองที่กระทรวงสาธารณสุขจัดทุกปี หน้านี้เผยแพร่หลักฐานการประเมินของแต่ละปีงบประมาณ";
const years = itaYears(await publishedMoits());
---

<SiteLayout title={title} section="ita" description={lead} canonical={ITA_PATH} crumbs={[]}>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		{years.length > 0 ? (
			<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{years.map(({ year, count }) => (
					<li>
						<a
							class="flex h-full items-center justify-between gap-4 rounded-18 border border-border-default bg-surface-base p-5.5 shadow-card hover:border-brand-primary"
							href={itaYearPath(year)}
						>
							<span class="flex flex-col gap-1">
								<span class="text-label text-brand-primary">ปีงบประมาณ</span>
								<span class="text-h2 text-brand-dark">{year}</span>
								<span class="text-small text-text-secondary">ตัวชี้วัด {count} รายการ</span>
							</span>
							<ChevronRight class="shrink-0 text-brand-primary" size={24} />
						</a>
					</li>
				))}
			</ul>
		) : (
			<EmptyState message="ยังไม่มีข้อมูล ITA" />
		)}
	</div>
</SiteLayout>
