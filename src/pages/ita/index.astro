---
// The ITA landing, /ita (Feature 004 #124; spec #121 "Public routes", ADR 0006): what the ITA is,
// in the GLOSSARY's words, and a Quick Link card for each fiscal year that has a published MOIT,
// newest first, with how many MOITs it has (src/lib/ita.ts itaYears), each leading to the year's
// page. While no MOIT is published it says so. The years come from the published MOITs, as ADR
// 0006 keeps no year record (src/lib/moits.ts).
import EmptyState from "../../components/EmptyState.astro";
import PageHeading from "../../components/PageHeading.astro";
import QuickLinkCard from "../../components/QuickLinkCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { ITA_PATH, itaYearPath, itaYears } from "../../lib/ita";
import { publishedMoits } from "../../lib/moits";

const title = "การประเมินคุณธรรมและความโปร่งใส (ITA)";
const lead =
	"การประเมินคุณธรรมและความโปร่งใส (MOPH ITA) คือการประเมินสำนักงานสาธารณสุขอำเภอสองที่กระทรวงสาธารณสุขจัดทุกปี เว็บไซต์นี้เผยแพร่หลักฐานการประเมินของแต่ละปีงบประมาณ";
const years = itaYears(await publishedMoits());
---

<SiteLayout title={title} section="ita" description={lead} canonical={ITA_PATH} crumbs={[]}>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		{years.length > 0 ? (
			<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				{years.map(({ year, count }) => (
					<li>
						<QuickLinkCard
							href={itaYearPath(year)}
							eyebrow="ปีงบประมาณ"
							label={String(year)}
							detail={`ตัวชี้วัด ${count} รายการ`}
						/>
					</li>
				))}
			</ul>
		) : (
			<EmptyState message="ยังไม่มีข้อมูล ITA" />
		)}
	</div>
</SiteLayout>
