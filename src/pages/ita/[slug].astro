---
// /ita/{fiscal-year} and /ita/{slug} (Feature 004 #123, #124; spec #121 "Public routes", ADR 0006).
//
// Both addresses are one path segment under /ita, and Astro answers a path through the one route
// its priority order matches first (astro 7.3.5 dist/core/routing/match.js matchRoute), so this
// page tells them apart. A segment written as a fiscal year whose year has a published MOIT is that
// year's page (src/components/ItaYearPage.astro). Any other segment is read as a MOIT's slug
// (src/components/MoitPage.astro), and so is a year without a published MOIT: a slug that breaks
// the moit-{number}-{fiscal_year} convention still works (spec #121 "Content model"), unless it is
// a year that has a page of its own.
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid signed
// preview token for it (emdash 1.1.0 src/query.ts resolveEmDashEntry). Anything else answers with
// the site 404 page, which EmDash records in its 404 log.
import { getEmDashEntry } from "emdash";
import ItaYearPage from "../../components/ItaYearPage.astro";
import MoitPage from "../../components/MoitPage.astro";
import { fiscalYearOf, type MoitData } from "../../lib/ita";
import { publishedMoits } from "../../lib/moits";

const slug = Astro.params.slug ?? "";
const year = fiscalYearOf(slug);
const yearMoits = year === undefined ? [] : await publishedMoits(year);
const yearPage =
	year !== undefined && yearMoits.length > 0 ? { year, moits: yearMoits } : undefined;
const moit = yearPage ? undefined : await getEmDashEntry<"moit", MoitData>("moit", slug);
if (moit?.error) throw moit.error;
if (!yearPage && !moit?.entry) return Astro.rewrite("/404");
---

{yearPage ? (
	<ItaYearPage {...yearPage} />
) : (
	moit?.entry && <MoitPage entry={moit.entry} isPreview={moit.isPreview} />
)}
