---
// An Activity page, /activities/{slug} (Feature 003 #56; spec #51 "Public reads" (Activities) and
// "Errors, redirects, preview and SEO"): when and where it was held, its description (the
// summary), who took part, its picture and its captioned photos. From lg its header and details
// read beside its picture, and the photos come after both columns, so the picture never covers
// them (Feature 006 #147; spec #144 "Post pages: News, Activity and Health Content";
// src/components/PostColumns.astro). The photos fold after the first eight
// (src/components/ActivityPhotos.astro).
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid
// signed preview token for it (emdash 1.1.0 src/query.ts resolveEmDashEntry). Anything else
// answers with the site 404 page, which EmDash records in its 404 log. A slug that changed is
// redirected by EmDash's middleware before this page runs.
import { getEmDashEntry } from "emdash";
import ActivityPhotos from "../../components/ActivityPhotos.astro";
import DateText from "../../components/DateText.astro";
import DetailItem from "../../components/DetailItem.astro";
import PostColumns from "../../components/PostColumns.astro";
import PostHeader from "../../components/PostHeader.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
	ACTIVITIES_PATH,
	ACTIVITIES_TITLE,
	activityPath,
	type ActivityData,
} from "../../lib/activities";

const slug = Astro.params.slug ?? "";
const { entry, isPreview, error } = await getEmDashEntry<"activities", ActivityData>(
	"activities",
	slug,
);
if (error) throw error;
if (!entry) return Astro.rewrite("/404");

const activity = entry.data;
const hasDetails =
	!!activity.activity_at || !!activity.location_text || !!activity.participants_text;
---

<SiteLayout
	title={activity.seo?.title || activity.title}
	section="news"
	description={activity.summary ?? undefined}
	canonical={activityPath(entry.id)}
	crumbs={[{ label: ACTIVITIES_TITLE, href: ACTIVITIES_PATH }, { label: activity.title }]}
	entry={{
		collection: "activities",
		id: activity.id,
		slug: entry.id,
		publishedAt: activity.publishedAt,
	}}
	noindex={isPreview}
>
	<article class="page-container flex flex-col pt-6 pb-16 lg:pb-20">
		<PostColumns image={activity.featured_image}>
			<PostHeader
				title={activity.title}
				summary={activity.summary}
				publishedAt={activity.publishedAt}
			/>
			{hasDetails && (
				<dl class="flex max-w-3xl flex-col gap-3 rounded-24 bg-surface-base p-5 shadow-card">
					{activity.activity_at && (
						<DetailItem term="วันที่จัดกิจกรรม">
							<DateText value={activity.activity_at} />
						</DetailItem>
					)}
					{activity.location_text && (
						<DetailItem term="สถานที่จัดกิจกรรม">{activity.location_text}</DetailItem>
					)}
					{activity.participants_text && (
						<DetailItem term="ผู้เข้าร่วม">
							<span class="whitespace-pre-line">{activity.participants_text}</span>
						</DetailItem>
					)}
				</dl>
			)}
		</PostColumns>
		<ActivityPhotos gallery={activity.gallery} />
	</article>
</SiteLayout>
