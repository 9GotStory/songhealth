---
// An Activity page, /activities/{slug} (Feature 003 #56; spec #51 "Public reads" (Activities) and
// "Errors, redirects, preview and SEO"): when and where it was held, its description (the
// summary), who took part, its picture and its captioned gallery.
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid
// signed preview token for it (emdash 1.1.0 src/query.ts resolveEmDashEntry). Anything else
// answers with the site 404 page, which EmDash records in its 404 log. A slug that changed is
// redirected by EmDash's middleware before this page runs.
//
// Gallery pictures take their alt text from the media library, as EmDash saves an image inside a
// repeater the way it saves an image field (src/emdash-runtime.ts, the repeater sub-field
// normalisation). A picture whose media item was deleted in Admin is left out (src/lib/media.ts).
import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import DateText from "../../components/DateText.astro";
import DetailItem from "../../components/DetailItem.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { ACTIVITIES_PATH, activityPath, type ActivityData } from "../../lib/activities";
import { availableMedia } from "../../lib/media";

const slug = Astro.params.slug ?? "";
const { entry, isPreview, error } = await getEmDashEntry<"activities", ActivityData>(
	"activities",
	slug,
);
if (error) throw error;
if (!entry) return Astro.rewrite("/404");

const activity = entry.data;
const image = await availableMedia(activity.featured_image, Astro.locals.emdash);
const gallery = (
	await Promise.all(
		(activity.gallery ?? []).map(async (item) => ({
			image: await availableMedia(item.image, Astro.locals.emdash),
			caption: item.caption,
		})),
	)
).filter((item) => item.image !== undefined);
const hasDetails =
	!!activity.activity_at || !!activity.location_text || !!activity.participants_text;

/** A gallery picture's width: three to a row from `lg`, two from `sm`. */
const GALLERY_SIZES = "(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw";
---

<SiteLayout
	title={activity.seo?.title || activity.title}
	section="news"
	description={activity.summary ?? undefined}
	canonical={activityPath(entry.id)}
	breadcrumbs={[
		{ label: "หน้าแรก", href: "/" },
		{ label: "ข่าวสาร", href: "/news" },
		{ label: "กิจกรรม", href: ACTIVITIES_PATH },
		{ label: activity.title },
	]}
	entry={{
		collection: "activities",
		id: activity.id,
		slug: entry.id,
		publishedAt: activity.publishedAt,
	}}
	noindex={isPreview}
>
	<article class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<header class="flex max-w-3xl flex-col gap-3">
			<h1 class="text-h3 wrap-anywhere text-brand-dark sm:text-h2 lg:text-h1">{activity.title}</h1>
			{activity.summary && (
				<p class="text-body-large whitespace-pre-line text-text-secondary">{activity.summary}</p>
			)}
			{activity.publishedAt && (
				<p class="text-small text-text-secondary">
					เผยแพร่ <DateText value={activity.publishedAt} />
				</p>
			)}
		</header>
		{hasDetails && (
			<dl class="flex max-w-3xl flex-col gap-3 rounded-24 bg-surface-base p-5 shadow-card">
				{activity.activity_at && (
					<DetailItem term="วันที่จัดกิจกรรม">
						<DateText value={activity.activity_at} />
					</DetailItem>
				)}
				{activity.location_text && (
					<DetailItem term="สถานที่จัดกิจกรรม">{activity.location_text}</DetailItem>
				)}
				{activity.participants_text && (
					<DetailItem term="ผู้เข้าร่วม">
						<span class="whitespace-pre-line">{activity.participants_text}</span>
					</DetailItem>
				)}
			</dl>
		)}
		{image && (
			<Image
				image={image}
				priority
				sizes="(min-width: 48rem) 48rem, 100vw"
				class="h-auto w-full max-w-3xl rounded-24 bg-surface-soft"
			/>
		)}
		{gallery.length > 0 && (
			<section aria-labelledby="activity-gallery" class="flex flex-col gap-4">
				<h2 id="activity-gallery" class="text-h3 text-brand-dark">
					ภาพกิจกรรม
				</h2>
				<ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{gallery.map((item) => (
						<li>
							<figure class="flex flex-col gap-2">
								<Image
									image={item.image!}
									sizes={GALLERY_SIZES}
									class="h-auto w-full rounded-18 bg-surface-soft"
								/>
								{item.caption && (
									<figcaption class="text-small wrap-anywhere text-text-secondary">
										{item.caption}
									</figcaption>
								)}
							</figure>
						</li>
					))}
				</ul>
			</section>
		)}
	</article>
</SiteLayout>
