---
// The Contact page, /contact (Feature 003 #62; spec #51 "Public reads" (Contact) and "Maps", `01`
// §10, `03` §12).
//
// /contact is the office's canonical contact page. It shows the Office Contact staff keep on the
// Office Contact plugin's settings form (src/lib/office-contact.ts) as OfficeContactDetails does:
// the address with the "เปิดแผนที่" link, the telephone number, the email address and the opening
// hours, each line only when it is set, and none at all while nothing is; the page still answers.
// The official channels follow: the native `social` settings and LINE, each a link to another
// website. Complaints and feedback go through the Service catalog, and the Health Services keep
// their own contacts in the Health Service Directory (`03` §12). No map is embedded (approved
// Q3). The page belongs to no main-navigation section: the utility bar and the footer link here.
import ActionLink from "../components/ActionLink.astro";
import ContentLink from "../components/ContentLink.astro";
import DetailSection from "../components/DetailSection.astro";
import OfficeContactDetails from "../components/OfficeContactDetails.astro";
import PageHeading from "../components/PageHeading.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { directoryPath } from "../lib/health-service-directory";
import { readOfficeContact } from "../lib/office-contact";
import { servicesPath } from "../lib/service-catalog";
import { OFFICE_NAME } from "../lib/site-identity";

const TITLE = "ติดต่อเรา";

const { contact, channels } = await readOfficeContact();

const linkClass =
	"inline-flex min-h-11 items-center text-brand-primary underline underline-offset-4";
---

<SiteLayout
	title={TITLE}
	description={`ที่อยู่ โทรศัพท์ อีเมล เวลาทำการ และช่องทางทางการของ${OFFICE_NAME}`}
	canonical="/contact"
	crumbs={[{ label: TITLE }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={TITLE} lead={`ที่อยู่ เวลาทำการ และช่องทางติดต่อ${OFFICE_NAME}`} />
		<OfficeContactDetails contact={contact} />
		{channels.length > 0 && (
			<DetailSection id="official-channels" heading="ช่องทางทางการ">
				<ul aria-labelledby="official-channels" class="flex flex-col gap-1">
					{channels.map((channel) => (
						<li>
							<ContentLink class={linkClass} href={channel.href}>
								{channel.label}
							</ContentLink>
						</li>
					))}
				</ul>
			</DetailSection>
		)}
		<DetailSection id="complaints" heading="ร้องเรียนและเสนอแนะ">
			<p>ขั้นตอนและช่องทางการร้องเรียน แจ้งเรื่อง หรือเสนอแนะ อยู่ในบริการประชาชน</p>
			<p>
				<ActionLink variant="primary" href={servicesPath()}>
					ดูบริการประชาชน
				</ActionLink>
			</p>
		</DetailSection>
		<DetailSection id="health-service-contacts" heading="ติดต่อหน่วยบริการสุขภาพ">
			<p>
				ที่อยู่ เวลาทำการ และช่องทางติดต่อของโรงพยาบาลและ รพ.สต.
				อยู่ในหน่วยบริการสุขภาพที่เกี่ยวข้อง
			</p>
			<p>
				<ActionLink href={directoryPath()}>ดูหน่วยบริการสุขภาพที่เกี่ยวข้อง</ActionLink>
			</p>
		</DetailSection>
	</div>
</SiteLayout>
