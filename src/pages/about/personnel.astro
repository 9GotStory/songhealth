---
// /about/personnel (Feature 003 #61; spec #51 "Public reads" (About), `03` §5): the publicly
// visible Personnel, a section per organizational unit in Thai order, each unit's people by name
// (src/lib/personnel-directory.ts). The Personnel without a unit come last, under their own
// heading. Everyone is on one page, so that no unit's section is split: the Product Owner made
// this exception to spec #51's fixed page size for a list grouped by unit (#61 comment 6514145827,
// 2026-10-30). Past about 100 people, the agreed next step is links to each unit, not pages.
//
// The page opens on the deep field with the list heading (Feature 012 #370; spec #365 decisions 4,
// 8, 9 and 12; ListHeading), under the label "เกี่ยวกับเรา" with the users-round icon, and no link.
// Over the field's lower edge (ListBody) each unit takes its own white panel, 24 px apart, its
// people inside as compact rows (UnitPanel). Each panel reveals as it comes into the window (spec
// #365 "Motion"); with no one the empty state lies over the edge and shows at once.
import UsersRound from "@lucide/astro/icons/users-round";
import EmptyState from "../../components/EmptyState.astro";
import ListBody from "../../components/ListBody.astro";
import ListHeading from "../../components/ListHeading.astro";
import UnitPanel from "../../components/UnitPanel.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { ABOUT_TITLE, PERSONNEL_PAGE } from "../../lib/about";
import { listPersonnelByUnit } from "../../lib/personnel";

const { path, title, lead } = PERSONNEL_PAGE;
const groups = await listPersonnelByUnit();
---

<SiteLayout title={title} section="about" description={lead} canonical={path}>
	<ListHeading
		section="about"
		crumbs={[{ label: title }]}
		label={ABOUT_TITLE}
		title={title}
		lead={lead}
	>
		<UsersRound slot="icon" class="shrink-0" size={24} />
	</ListHeading>
	<ListBody>
		{groups.length > 0 ? (
			<div class="flex flex-col gap-6">
				{groups.map(({ unit, people }, index) => (
					<UnitPanel unit={unit} people={people} headingId={`unit-${index + 1}`} />
				))}
			</div>
		) : (
			<EmptyState message="ยังไม่มีข้อมูลบุคลากร" />
		)}
	</ListBody>
</SiteLayout>
