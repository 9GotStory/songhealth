---
// An Announcement page, /announcements/{slug} (Feature 003 #56; spec #51 "Public reads"
// (Announcements) and "Errors, redirects, preview and SEO"): its type, its announcement, open and
// close dates, its status in text when it has those dates (ยังไม่เปิด, เปิดอยู่ or ปิดแล้ว), its details,
// and the Documents attached to it.
//
// It opens on the deep field with the Post page's header, though it is not a Post page (Feature 010
// #316; spec #311 "An Announcement's page and a Document's page: the header"): "เผยแพร่" and its
// publication date in an accent-warm pill and its type in an outlined white pill, then its title.
// Its details lie in one white card over the field's lower edge, the status as the Announcements
// list's dotted label, and an Announcement with no details row has none; then its details text and
// "เอกสารที่เกี่ยวข้อง" with each Document's download (spec #311 "The card over the field's edge";
// src/components/CardOverField.astro). The page gives the shell no crumbs, since the header shows
// them on the field.
//
// The attached Documents are read through the reference field in the order staff attached them.
// EmDash resolves a target only while it is published, or a draft in preview, so a draft,
// unpublished or trashed Document is left out (emdash 1.1.0 src/query.ts attachReferences,
// src/references/resolve.ts). A first page holds at most 100 targets
// (src/references/staged.ts REFERENCE_PAGE_MAX_LIMIT), far more than an Announcement attaches.
// The targets come without their taxonomy terms, so their rows are read again with them
// (src/lib/documents.ts documentsById).
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid
// signed preview token for it (src/query.ts resolveEmDashEntry). Anything else answers with the
// site 404 page, which EmDash records in its 404 log. A slug that changed is redirected by
// EmDash's middleware before this page runs.
//
// An Announcement has no summary, so its description is the start of its details, unless its SEO
// panel sets one.
import { getEmDashEntry } from "emdash";
import AnnouncementStatus from "../../components/AnnouncementStatus.astro";
import CardOverField from "../../components/CardOverField.astro";
import DateText from "../../components/DateText.astro";
import DetailItem from "../../components/DetailItem.astro";
import PostHeader from "../../components/PostHeader.astro";
import RelatedDocuments from "../../components/RelatedDocuments.astro";
import RichText from "../../components/RichText.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
	ANNOUNCEMENTS_PATH,
	ANNOUNCEMENTS_TITLE,
	announcementPath,
	detailsExcerpt,
	statusOf,
	type AnnouncementData,
} from "../../lib/announcements";
import { documentsById } from "../../lib/documents";
import { targetIds } from "../../lib/references";
import { termsOf } from "../../lib/terms";

/** The most related Documents one read returns. */
const DOCUMENTS_LIMIT = 100;

const slug = Astro.params.slug ?? "";
const { entry, isPreview, error } = await getEmDashEntry<
	"announcements",
	AnnouncementData,
	{ documents: { limit: number } }
>("announcements", slug, { references: { documents: { limit: DOCUMENTS_LIMIT } } });
if (error) throw error;
if (!entry) return Astro.rewrite("/404");

const announcement = entry.data;
const types = termsOf(announcement, "announcement_type");
const typeLabels = types.map((type) => type.label).join(", ");
const status = statusOf(announcement, new Date());
const documents = await documentsById(targetIds(entry.references?.documents.entries));
const description = detailsExcerpt(announcement.details);
const details = announcement.details ?? [];
const hasDetails =
	types.length > 0 ||
	!!announcement.announcement_at ||
	!!announcement.opens_at ||
	!!announcement.closes_at;
---

<SiteLayout
	title={announcement.seo?.title || announcement.title}
	section="news"
	description={description || undefined}
	canonical={announcementPath(entry.id)}
	entry={{
		collection: "announcements",
		id: announcement.id,
		slug: entry.id,
		publishedAt: announcement.publishedAt,
	}}
	noindex={isPreview}
>
	<article class="pb-16 lg:pb-20">
		<CardOverField>
			<PostHeader
				slot="header"
				section="news"
				crumbs={[
					{ label: ANNOUNCEMENTS_TITLE, href: ANNOUNCEMENTS_PATH },
					{ label: announcement.title },
				]}
				title={announcement.title}
				publishedAt={announcement.publishedAt}
				outlined={typeLabels || undefined}
			/>
			{hasDetails && (
				<dl slot="card" class="flex flex-col gap-3">
					{types.length > 0 && <DetailItem term="ประเภทประกาศ">{typeLabels}</DetailItem>}
					{announcement.announcement_at && (
						<DetailItem term="วันที่ประกาศ">
							<DateText value={announcement.announcement_at} />
						</DetailItem>
					)}
					{announcement.opens_at && (
						<DetailItem term="วันที่เริ่มต้น">
							<DateText value={announcement.opens_at} />
						</DetailItem>
					)}
					{announcement.closes_at && (
						<DetailItem term="วันที่สิ้นสุด">
							<DateText value={announcement.closes_at} />
						</DetailItem>
					)}
					{status && (
						<DetailItem term="สถานะ">
							<span class="text-small">
								<AnnouncementStatus status={status} dotted />
							</span>
						</DetailItem>
					)}
				</dl>
			)}
			{(details.length > 0 || documents.length > 0) && (
				<div class="flex max-w-3xl flex-col gap-8">
					{details.length > 0 && <RichText value={details} />}
					<RelatedDocuments documents={documents} downloads />
				</div>
			)}
		</CardOverField>
	</article>
</SiteLayout>
