---
// A Document page, /documents/{slug} (Feature 003 #55; spec #51 "Public reads" (Documents) and
// "Errors, redirects, preview and SEO", `03` §10 and §17).
//
// The page shows the Document's details that are set, its domain status in text, a link to its
// successor, and its file. The successor is read through the reference field, and EmDash resolves
// it only while it is published, or a draft in preview (emdash 1.1.0 src/query.ts
// attachReferences).
//
// It opens on the deep field with the Post page's header, though it is not a Post page (Feature 010
// #317; spec #311 "An Announcement's page and a Document's page: the header", decision 9): its type
// in an outlined white pill and, when superseded or expired, its status in an accent-warm pill,
// then its title and summary; no publication date. One white card over the field's lower
// edge holds first its file, then a rule and its details, each row only when set (spec #311 "The
// card over the field's edge"; src/components/CardOverField.astro): the file's tile, the H2
// "ไฟล์เอกสาร" with the file's type and size under it, and the download "ดาวน์โหลดเอกสาร", at the
// card's right from `sm` and across the card below; or, when the file cannot be served, the H2 and
// the unavailable notice. A superseded Document's note on its successor follows the card. The page
// gives the shell no crumbs, since the header shows them on the field.
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid
// signed preview token for it (src/query.ts resolveEmDashEntry). Anything else answers with the
// site 404 page, which EmDash records in its 404 log. A slug that changed is redirected by
// EmDash's middleware before this page runs.
import { getEmDashEntry } from "emdash";
import CardOverField from "../../components/CardOverField.astro";
import DateText from "../../components/DateText.astro";
import DetailItem from "../../components/DetailItem.astro";
import DocumentStatus from "../../components/DocumentStatus.astro";
import FileDownloadLink from "../../components/FileDownloadLink.astro";
import FileTile from "../../components/FileTile.astro";
import PostHeader from "../../components/PostHeader.astro";
import ThaiTitle from "../../components/ThaiTitle.astro";
import UnavailableNotice from "../../components/UnavailableNotice.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import {
	DOMAIN_STATUS_LABELS,
	documentPath,
	documentsPath,
	listedDomainStatus,
	type DocumentData,
} from "../../lib/documents";
import { FILE_UNAVAILABLE, downloadableFile } from "../../lib/media";
import { termsOf } from "../../lib/terms";

const slug = Astro.params.slug ?? "";
const { entry, isPreview, error } = await getEmDashEntry<
	"documents",
	DocumentData,
	{ successor: true }
>("documents", slug, { references: { successor: true } });
if (error) throw error;
if (!entry) return Astro.rewrite("/404");

const document = entry.data;
const types = termsOf(document, "document_type");
const typeLabels = types.map((type) => type.label).join(", ");
const attention = listedDomainStatus(document.domain_status);
const topics = termsOf(document, "topic");
const file = await downloadableFile(document.file, Astro.locals.emdash);
const successor = entry.references?.successor.entries[0];
const successorTitle = typeof successor?.data.title === "string" ? successor.data.title : undefined;
const hasDetails =
	types.length > 0 ||
	!!document.document_at ||
	!!document.fiscal_year ||
	!!document.owner_source ||
	!!document.domain_status ||
	topics.length > 0;
---

<SiteLayout
	title={document.seo?.title || document.title}
	section="documents"
	description={document.summary ?? undefined}
	canonical={documentPath(entry.id)}
	entry={{
		collection: "documents",
		id: document.id,
		slug: entry.id,
		publishedAt: document.publishedAt,
	}}
	noindex={isPreview}
>
	<article class="pb-16 lg:pb-20">
		<CardOverField>
			<PostHeader
				slot="header"
				section="documents"
				crumbs={[{ label: document.title }]}
				title={document.title}
				summary={document.summary}
				outlined={typeLabels || undefined}
				attention={attention && DOMAIN_STATUS_LABELS[attention]}
			/>
			<div slot="card" class="flex flex-col gap-5">
				{file ? (
					<section
						aria-labelledby="document-file"
						class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-4 sm:grid-cols-[auto_minmax(0,1fr)_auto]"
					>
						<FileTile type={file.type} />
						<div class="min-w-0">
							<h2 id="document-file" class="text-body-large font-semibold text-brand-dark">
								<ThaiTitle text="ไฟล์เอกสาร" />
							</h2>
							<p class="text-small text-text-secondary">{file.label}</p>
						</div>
						<FileDownloadLink
							file={file}
							words="ดาวน์โหลดเอกสาร"
							class="max-sm:col-span-2 sm:min-h-13 sm:px-7"
						/>
					</section>
				) : (
					<section aria-labelledby="document-file" class="flex flex-col gap-3">
						<h2 id="document-file" class="text-body-large font-semibold text-brand-dark">
							<ThaiTitle text="ไฟล์เอกสาร" />
						</h2>
						<UnavailableNotice message={FILE_UNAVAILABLE} />
					</section>
				)}
				{hasDetails && (
					<>
						<hr class="border-border-default" />
						<dl class="flex flex-col gap-3">
							{types.length > 0 && <DetailItem term="ประเภทเอกสาร">{typeLabels}</DetailItem>}
							{document.document_at && (
								<DetailItem term="วันที่เอกสาร">
									<DateText value={document.document_at} />
								</DetailItem>
							)}
							{document.fiscal_year && (
								<DetailItem term="ปีงบประมาณ">{document.fiscal_year}</DetailItem>
							)}
							{document.owner_source && (
								<DetailItem term="เจ้าของ/แหล่งที่มา">{document.owner_source}</DetailItem>
							)}
							{document.domain_status && (
								<DetailItem term="สถานะเอกสาร">
									<DocumentStatus status={document.domain_status} />
								</DetailItem>
							)}
							{topics.length > 0 && (
								<DetailItem term="ประเด็นสุขภาพ">
									<ul class="flex flex-wrap gap-x-4 gap-y-1">
										{topics.map((topic) => (
											<li>
												<a
													class="inline-flex min-h-11 items-center text-brand-primary underline underline-offset-4"
													href={documentsPath({ topic: topic.slug })}
												>
													{topic.label}
												</a>
											</li>
										))}
									</ul>
								</DetailItem>
							)}
						</dl>
					</>
				)}
			</div>
			{successor && successorTitle && (
				<p class="max-w-3xl rounded-24 bg-surface-soft p-5 text-brand-dark">
					เอกสารฉบับถัดไป:{" "}
					<a
						class="font-semibold wrap-anywhere text-brand-primary underline underline-offset-4"
						href={documentPath(successor.id)}
					>
						{successorTitle}
					</a>
				</p>
			)}
		</CardOverField>
	</article>
</SiteLayout>
