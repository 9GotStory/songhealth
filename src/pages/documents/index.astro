---
// The Document repository, /documents (Feature 003 #55; spec #51 "Public reads" (Documents),
// `03` §10): published Documents, newest publication first, a fixed number per page with the page
// number in the query string.
import DocumentRow from "../../components/DocumentRow.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHeading from "../../components/PageHeading.astro";
import Pagination from "../../components/Pagination.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { listDocuments } from "../../lib/documents";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../../lib/pagination";

const title = "เอกสารเผยแพร่";
const lead = "แบบฟอร์ม คู่มือ แผนงาน รายงาน และเอกสารอื่นของสำนักงานสาธารณสุขอำเภอสอง";
const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM));
const { entries, hasMore } = await listDocuments(page);
const listUrl = new URL("/documents", Astro.url);
---

<SiteLayout
	title={title}
	section="documents"
	description={lead}
	canonical={pageHref(listUrl, page)}
	breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: title }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		{entries.length > 0 ? (
			<ul class="flex flex-col gap-4">
				{entries.map((document) => (
					<li>
						<DocumentRow document={document} />
					</li>
				))}
			</ul>
		) : page > 1 ? (
			<EmptyState
				message="ไม่พบเอกสารในหน้านี้"
				action={{ href: pageHref(listUrl, 1), label: "กลับไปหน้าแรกของรายการ" }}
			/>
		) : (
			<EmptyState message="ยังไม่มีเอกสาร" />
		)}
		{entries.length > 0 && <Pagination page={page} hasMore={hasMore} />}
	</div>
</SiteLayout>
