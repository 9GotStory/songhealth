---
// The Health Information hub, /health (Feature 003 #59; spec #51 "Public reads", `03` §9 and §19):
// it links to Health Content and to Health Reports (src/lib/health.ts), so citizens choose
// knowledge or reports (#51 user story 43).
//
// The page opens on the deep field as the lists do (Feature 011 #339; spec #338 "Decisions", 5,
// and "`/health`"; ListHeading): the label "สุขภาพ", the Homepage's Health Information label, with
// the heart-pulse icon, over its H1. Its two destinations follow over the field's lower edge as the
// Service catalog's cards (Feature 014 #420; spec #417 "The cards"; HomeServiceCard `kind="list"`),
// each with its list's heading icon and from `sm` its list's lead (src/lib/health.ts), one to a
// row below `sm` and two from `sm`, 12 px apart below `sm` and 20 px from `sm`, each revealed as it
// comes into the window (`scroll-reveal`).
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import HomeServiceCard from "../../components/HomeServiceCard.astro";
import ListBody from "../../components/ListBody.astro";
import ListHeading from "../../components/ListHeading.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { HEALTH_DESTINATIONS, HEALTH_PATH, HEALTH_TITLE } from "../../lib/health";

const lead = "ความรู้สุขภาพสำหรับประชาชน และรายงานสุขภาพของสำนักงานสาธารณสุขอำเภอสองและเครือข่าย";
---

<SiteLayout title={HEALTH_TITLE} section="health" description={lead} canonical={HEALTH_PATH}>
	<ListHeading section="health" crumbs={[]} label="สุขภาพ" title={HEALTH_TITLE} lead={lead}>
		<HeartPulse slot="icon" class="shrink-0" size={24} />
	</ListHeading>
	<ListBody>
		<ul class="grid gap-3 sm:grid-cols-2 sm:gap-5">
			{HEALTH_DESTINATIONS.map((destination) => (
				<li class="scroll-reveal min-w-0">
					<HomeServiceCard destination={destination} kind="list" />
				</li>
			))}
		</ul>
	</ListBody>
</SiteLayout>
