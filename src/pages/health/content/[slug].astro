---
// A Health Content page, /health/content/{slug} (Feature 003 #59; spec #51 "Public reads" (Health
// Content) and "Errors, redirects, preview and SEO", `03` §14): its summary under the title, its
// publication date, when staff last reviewed it ("ทบทวนล่าสุด", only when that date is set), its
// picture, body and source, and its Health Topics linking to the list each one filters (#51 user
// story 44). The next review date is for staff and is not shown (`02` §7). From lg it reads beside
// its picture, as a News page does (Feature 006 #147; spec #144 "Post pages: News, Activity and
// Health Content"; src/components/PostColumns.astro). Its header, with its breadcrumb, lies on the
// deep field, so the page gives the shell no crumbs (Feature 009 #285;
// src/components/PostHeader.astro).
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid
// signed preview token for it (emdash 1.1.0 src/query.ts resolveEmDashEntry). Anything else
// answers with the site 404 page, which EmDash records in its 404 log. A slug that changed is
// redirected by EmDash's middleware before this page runs.
//
// A picture whose media item was deleted in Admin is left out (src/lib/media.ts), and so is such
// an image in the body (src/components/RichText.astro).
import { getEmDashEntry } from "emdash";
import DateText from "../../../components/DateText.astro";
import PostBody from "../../../components/PostBody.astro";
import PostColumns from "../../../components/PostColumns.astro";
import PostHeader from "../../../components/PostHeader.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { HEALTH_CONTENT_PATH, HEALTH_CONTENT_TITLE } from "../../../lib/health";
import {
	healthContentListPath,
	healthContentPath,
	type HealthContentData,
} from "../../../lib/health-content";
import { termsOf } from "../../../lib/terms";

const slug = Astro.params.slug ?? "";
const { entry, isPreview, error } = await getEmDashEntry<"health_content", HealthContentData>(
	"health_content",
	slug,
);
if (error) throw error;
if (!entry) return Astro.rewrite("/404");

const content = entry.data;
const topics = termsOf(content, "topic");
---

<SiteLayout
	title={content.seo?.title || content.title}
	section="health"
	description={content.summary}
	canonical={healthContentPath(entry.id)}
	entry={{
		collection: "health_content",
		id: content.id,
		slug: entry.id,
		publishedAt: content.publishedAt,
	}}
	noindex={isPreview}
>
	<article class="pb-16 lg:pb-20">
		<PostColumns image={content.featured_image}>
			<PostHeader
				slot="header"
				section="health"
				crumbs={[
					{ label: HEALTH_CONTENT_TITLE, href: HEALTH_CONTENT_PATH },
					{ label: content.title },
				]}
				title={content.title}
				summary={content.summary}
				publishedAt={content.publishedAt}
			>
				{content.reviewed_at && (
					<p class="text-small">
						ทบทวนล่าสุด <DateText value={content.reviewed_at} />
					</p>
				)}
			</PostHeader>
			<PostBody
				body={content.body}
				source={content.source_text}
				topics={topics}
				topicHref={healthContentListPath}
			/>
		</PostColumns>
	</article>
</SiteLayout>
