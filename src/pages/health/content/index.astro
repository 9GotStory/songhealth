---
// The Health Content list, /health/content (Feature 003 #59; spec #51 "Public reads" (Health
// Content), `03` §9): published Health Content, newest publication first, a fixed number per page.
// `?topic=<slug>` narrows it to one Health Topic; one that does not exist simply matches nothing.
// Each card is labelled with its first Health Topic (#51 user story 21).
//
// The canonical address keeps the chosen Health Topic and a valid page number, as on Health News,
// so each view stays its own address for search engines.
import ContentCardGrid from "../../../components/ContentCardGrid.astro";
import EmptyState from "../../../components/EmptyState.astro";
import FilterForm from "../../../components/FilterForm.astro";
import PageHeading from "../../../components/PageHeading.astro";
import Pagination from "../../../components/Pagination.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { HEALTH_CONTENT_TITLE } from "../../../lib/health";
import {
	healthContentListPath,
	healthContentPath,
	listHealthContent,
} from "../../../lib/health-content";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../../../lib/pagination";
import { TOPIC_PARAM, listTerms } from "../../../lib/terms";

const title = HEALTH_CONTENT_TITLE;
const lead = "ความรู้ด้านสุขภาพสำหรับประชาชนในอำเภอสอง เลือกประเด็นสุขภาพที่สนใจได้";
const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM));
const topic = Astro.url.searchParams.get(TOPIC_PARAM)?.trim() ?? "";
const [topics, { entries, hasMore }] = await Promise.all([
	listTerms("topic"),
	listHealthContent(page, topic),
]);
const listUrl = new URL(healthContentListPath(topic), Astro.url);
---

<SiteLayout
	title={title}
	section="health"
	description={lead}
	canonical={pageHref(listUrl, page)}
	crumbs={[{ label: title }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		<FilterForm
			label="กรองความรู้สุขภาพ"
			action={healthContentListPath()}
			fields={[
				{
					name: TOPIC_PARAM,
					label: "ประเด็นสุขภาพ",
					anyLabel: "ทุกประเด็น",
					value: topic,
					options: topics.map((term) => ({ value: term.slug, label: term.label })),
				},
			]}
		/>
		{entries.length > 0 ? (
			<ContentCardGrid entries={entries} labelTaxonomy="topic" pathOf={healthContentPath} />
		) : page > 1 ? (
			<EmptyState
				message="ไม่พบความรู้สุขภาพในหน้านี้"
				action={{ href: pageHref(listUrl, 1), label: "กลับไปหน้าแรกของรายการ" }}
			/>
		) : topic !== "" ? (
			<EmptyState
				message="ไม่พบความรู้สุขภาพในประเด็นนี้"
				action={{ href: healthContentListPath(), label: "ดูความรู้สุขภาพทุกประเด็น" }}
			/>
		) : (
			<EmptyState message="ยังไม่มีความรู้สุขภาพ" />
		)}
		{entries.length > 0 && <Pagination page={page} hasMore={hasMore} />}
	</div>
</SiteLayout>
