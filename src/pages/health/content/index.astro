---
// The Health Content list, /health/content (Feature 003 #59; spec #51 "Public reads" (Health
// Content), `03` §9): published Health Content, newest publication first, a fixed number per page.
// `?topic=<slug>` narrows it to one Health Topic. The filter offers only the Health Topics that
// published Health Content carries (src/lib/terms.ts offeredTerms); any other topic simply matches
// nothing. Each card is labelled with its first Health Topic (#51 user story 21).
//
// The canonical address keeps the chosen Health Topic and a valid page number, as on Health News,
// so each view stays its own address for search engines.
//
// The page opens on the deep field as Health News does (Feature 009 #282; spec #280 "List
// heading"; ListHeading), under the label "สุขภาพ", the Homepage's Health Information label, with
// the heart-pulse icon and no link; the filter form comes first over the field's lower edge.
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import ContentCardGrid from "../../../components/ContentCardGrid.astro";
import EmptyState from "../../../components/EmptyState.astro";
import FilterForm from "../../../components/FilterForm.astro";
import ListBody from "../../../components/ListBody.astro";
import ListHeading from "../../../components/ListHeading.astro";
import Pagination from "../../../components/Pagination.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { HEALTH_CONTENT_TITLE } from "../../../lib/health";
import {
	healthContentListPath,
	healthContentPath,
	listHealthContent,
} from "../../../lib/health-content";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../../../lib/pagination";
import { TOPIC_PARAM, offeredTerms } from "../../../lib/terms";

const title = HEALTH_CONTENT_TITLE;
const lead = "ความรู้ด้านสุขภาพสำหรับประชาชนในอำเภอสอง เลือกประเด็นสุขภาพที่สนใจได้";
const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM));
const topic = Astro.url.searchParams.get(TOPIC_PARAM)?.trim() ?? "";
const [topics, { entries, hasMore }] = await Promise.all([
	offeredTerms("health_content", "topic"),
	listHealthContent(page, topic),
]);
const listUrl = new URL(healthContentListPath(topic), Astro.url);
---

<SiteLayout title={title} section="health" description={lead} canonical={pageHref(listUrl, page)}>
	<ListHeading
		section="health"
		crumbs={[{ label: title }]}
		label="สุขภาพ"
		title={title}
		lead={lead}
	>
		<HeartPulse slot="icon" class="shrink-0" size={24} />
	</ListHeading>
	<ListBody>
		<FilterForm
			label="กรองความรู้สุขภาพ"
			action={healthContentListPath()}
			fields={[
				{
					name: TOPIC_PARAM,
					label: "ประเด็นสุขภาพ",
					anyLabel: "ทุกประเด็น",
					value: topic,
					options: topics.map((term) => ({ value: term.slug, label: term.label })),
				},
			]}
		/>
		{entries.length > 0 ? (
			<ContentCardGrid
				entries={entries}
				labelTaxonomy="topic"
				icon="heart-pulse"
				pathOf={healthContentPath}
			/>
		) : page > 1 ? (
			<EmptyState
				message="ไม่พบความรู้สุขภาพในหน้านี้"
				action={{ href: pageHref(listUrl, 1), label: "กลับไปหน้าแรกของรายการ" }}
			/>
		) : topic !== "" ? (
			<EmptyState
				message="ไม่พบความรู้สุขภาพในประเด็นนี้"
				action={{ href: healthContentListPath(), label: "ดูความรู้สุขภาพทุกประเด็น" }}
			/>
		) : (
			<EmptyState message="ยังไม่มีความรู้สุขภาพ" />
		)}
		{entries.length > 0 && <Pagination page={page} hasMore={hasMore} />}
	</ListBody>
</SiteLayout>
