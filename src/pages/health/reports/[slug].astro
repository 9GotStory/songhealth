---
// A Health Report page, /health/reports/{slug} (Feature 003 #59; spec #51 "Public reads" (Health
// Reports) and "Errors, redirects, preview and SEO", `02` §16, `03` §14): its summary, Report
// Type, report date, reporting period, fiscal year and source, and its report Document, the
// report's authoritative content (#51 user story 45).
//
// It opens on the deep field with the Post page's header, though it is not a Post page (Feature 011
// #343; spec #338 "The three pages: the header", "The card over the field's edge", decisions 4, 8
// and 9): "วันที่รายงาน" and its report date in an accent-warm pill, only when it has one, never its
// publication date, then its Report Type outlined, then its title and summary. One white card over
// the field's lower edge (src/components/CardOverField.astro) holds first its report Document, as
// a Document's page holds its file (src/components/FileBlock.astro): the file's tile, the H2
// "เอกสารรายงาน", the Document's title linking to its page, the file's type and size, and the
// download "ดาวน์โหลดเอกสาร", so citizens get the report in one step (Product Owner, 2026-10-30:
// #59 comment 6515961560). Then a rule and the details, each row only when set. The page gives the
// shell no crumbs, since the header shows them on the field.
//
// The report Document is read through the reference field. EmDash resolves it only while it is
// published, or a draft in preview (emdash 1.1.0 src/query.ts attachReferences); the page reads
// the published Document again by its id (src/lib/documents.ts documentsById), so a draft
// Document never shows. The Document is required, so while it is not published, or while its file
// cannot be served, the card says the report Document is unavailable and points to the office.
//
// getEmDashEntry returns the published entry, or the draft when the request carries a valid
// signed preview token for it (src/query.ts resolveEmDashEntry). Anything else answers with the
// site 404 page, which EmDash records in its 404 log. A slug that changed is redirected by
// EmDash's middleware before this page runs.
import { getEmDashEntry } from "emdash";
import CardOverField from "../../../components/CardOverField.astro";
import DateText from "../../../components/DateText.astro";
import DetailItem from "../../../components/DetailItem.astro";
import FileBlock from "../../../components/FileBlock.astro";
import PostHeader from "../../../components/PostHeader.astro";
import ThaiTitle from "../../../components/ThaiTitle.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { documentPath, documentsById } from "../../../lib/documents";
import { HEALTH_REPORTS_PATH, HEALTH_REPORTS_TITLE } from "../../../lib/health";
import { healthReportPath, type HealthReportData } from "../../../lib/health-reports";
import { downloadableFile } from "../../../lib/media";
import { targetIds } from "../../../lib/references";
import { termsOf } from "../../../lib/terms";

const slug = Astro.params.slug ?? "";
const { entry, isPreview, error } = await getEmDashEntry<
	"health_reports",
	HealthReportData,
	{ report_document: true }
>("health_reports", slug, { references: { report_document: true } });
if (error) throw error;
if (!entry) return Astro.rewrite("/404");

const report = entry.data;
const types = termsOf(report, "report_type");
const typeLabels = types.map((type) => type.label).join(", ");
const [document] = await documentsById(targetIds(entry.references?.report_document.entries));
const file = document && (await downloadableFile(document.data.file, Astro.locals.emdash));
const hasDetails =
	types.length > 0 ||
	!!report.report_at ||
	!!report.reporting_period ||
	!!report.fiscal_year ||
	!!report.owner_source;
---

<SiteLayout
	title={report.seo?.title || report.title}
	section="health"
	description={report.summary ?? undefined}
	canonical={healthReportPath(entry.id)}
	entry={{
		collection: "health_reports",
		id: report.id,
		slug: entry.id,
		publishedAt: report.publishedAt,
	}}
	noindex={isPreview}
>
	<article class="pb-16 lg:pb-20">
		<CardOverField>
			<PostHeader
				slot="header"
				section="health"
				crumbs={[
					{ label: HEALTH_REPORTS_TITLE, href: HEALTH_REPORTS_PATH },
					{ label: report.title },
				]}
				title={report.title}
				summary={report.summary}
				date={report.report_at}
				dateWords="วันที่รายงาน"
				outlined={typeLabels || undefined}
			/>
			<div slot="card" class="flex flex-col gap-5">
				<FileBlock
					id="report-document"
					heading="เอกสารรายงาน"
					file={file}
					unavailable="เอกสารรายงานไม่พร้อมให้บริการ"
				>
					{document && (
						<p>
							<a
								class="font-semibold wrap-anywhere text-brand-primary underline underline-offset-4"
								href={documentPath(document.id)}
							>
								<ThaiTitle text={document.data.title} />
							</a>
						</p>
					)}
				</FileBlock>
				{hasDetails && (
					<>
						<hr class="border-border-default" />
						<dl class="flex flex-col gap-3">
							{types.length > 0 && <DetailItem term="ประเภทรายงาน">{typeLabels}</DetailItem>}
							{report.report_at && (
								<DetailItem term="วันที่รายงาน">
									<DateText value={report.report_at} />
								</DetailItem>
							)}
							{report.reporting_period && (
								<DetailItem term="ช่วงเวลาของรายงาน">{report.reporting_period}</DetailItem>
							)}
							{report.fiscal_year && (
								<DetailItem term="ปีงบประมาณ">{report.fiscal_year}</DetailItem>
							)}
							{report.owner_source && (
								<DetailItem term="เจ้าของ/แหล่งที่มา">{report.owner_source}</DetailItem>
							)}
						</dl>
					</>
				)}
			</div>
		</CardOverField>
	</article>
</SiteLayout>
