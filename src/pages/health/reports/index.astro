---
// The Health Reports list, /health/reports (Feature 003 #59; spec #51 "Public reads" (Health
// Reports), `03` §9): published Health Reports, the latest report date first, each without a
// report date placed by its publication (src/lib/health-reports.ts, ADR 0004). A fixed number per
// page, with the page number in the query string. Each row states the report's reporting period
// and fiscal year (#51 user story 45).
//
// The canonical address keeps a valid page number, as on the News lists.
import EmptyState from "../../../components/EmptyState.astro";
import HealthReportRow from "../../../components/HealthReportRow.astro";
import PageHeading from "../../../components/PageHeading.astro";
import Pagination from "../../../components/Pagination.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { HEALTH_CRUMB, HEALTH_REPORTS_PATH, HEALTH_REPORTS_TITLE } from "../../../lib/health";
import { listHealthReports } from "../../../lib/health-reports";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../../../lib/pagination";

const title = HEALTH_REPORTS_TITLE;
const lead = "รายงานด้านสุขภาพของสำนักงานสาธารณสุขอำเภอสองและเครือข่าย พร้อมเอกสารรายงานฉบับเต็ม";
const page = parsePageNumber(Astro.url.searchParams.get(PAGE_PARAM));
const { entries, hasMore } = await listHealthReports(page);
const listUrl = new URL(HEALTH_REPORTS_PATH, Astro.url);
---

<SiteLayout
	title={title}
	section="health"
	description={lead}
	canonical={pageHref(listUrl, page)}
	breadcrumbs={[{ label: "หน้าแรก", href: "/" }, HEALTH_CRUMB, { label: title }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		{entries.length > 0 ? (
			<ul class="flex flex-col gap-4">
				{entries.map((report) => (
					<li>
						<HealthReportRow report={report} />
					</li>
				))}
			</ul>
		) : page > 1 ? (
			<EmptyState
				message="ไม่พบรายงานสุขภาพในหน้านี้"
				action={{ href: pageHref(listUrl, 1), label: "กลับไปหน้าแรกของรายการ" }}
			/>
		) : (
			<EmptyState message="ยังไม่มีรายงานสุขภาพ" />
		)}
		{entries.length > 0 && <Pagination page={page} hasMore={hasMore} />}
	</div>
</SiteLayout>
