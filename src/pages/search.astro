---
// Search, /search (Feature 003 #63; spec #51 "Search", ADR 0002, `03` §13, `08`): every
// published public entry that matches the query, grouped, a fixed number per page. `?q=` carries
// the query, `?group=` the group and `?page=` the page, so reload, back, forward and a shared link
// keep them. src/lib/search.ts reads and matches; this page only renders what it returns.
//
// The page has four states besides its results, each in its own words: the start page with just
// the form, a query too short to search (an empty one included), a query that finds nothing (with
// links to browse instead, `08` §12), and a failed search, which answers 500 and shows no detail.
// Result pages are discovery views, not content pages (`08` §9), so the page keeps out of search
// engines and its canonical address is /search. It belongs to no main-navigation section; ค้นหา
// is a utility link. The Product Owner decided its text and these choices on 2026-10-30 (#63
// comment 6518347225).
import ActionLink from "../components/ActionLink.astro";
import EmptyState from "../components/EmptyState.astro";
import PageHeading from "../components/PageHeading.astro";
import Pagination from "../components/Pagination.astro";
import SearchForm from "../components/SearchForm.astro";
import SearchResultRow from "../components/SearchResultRow.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { documentsPath } from "../lib/documents";
import { HEALTH_PATH } from "../lib/health";
import { DIRECTORY_TITLE, directoryPath } from "../lib/health-service-directory";
import { pageHref } from "../lib/pagination";
import { search } from "../lib/search";
import { GROUP_PARAM, SEARCH_GROUPS, type SearchGroup } from "../lib/search-matcher";
import { servicesPath } from "../lib/service-catalog";

const title = "ค้นหา";
const lead =
	"ค้นหาข่าวสาร บริการประชาชน ข้อมูลสุขภาพ หน่วยบริการ เอกสาร และข้อมูลของสำนักงานสาธารณสุขอำเภอสองได้จากที่เดียว";
const outcome = await search(Astro.url.searchParams, new Date());
if (outcome.state === "failed") Astro.response.status = 500;
const { query, group, page } = outcome;
const queryText = query.kind === "none" ? "" : query.text;
const groupSuffix = group.id === "all" ? "" : `ในกลุ่ม${group.label}`;

/** This search's address in another group, from its first page. */
function groupHref(other: SearchGroup): string {
	const url = new URL(Astro.url);
	if (other.id === "all") url.searchParams.delete(GROUP_PARAM);
	else url.searchParams.set(GROUP_PARAM, other.id);
	return pageHref(url, 1);
}

/** Where to browse instead when a search finds nothing or fails (`08` §12). */
const browse = [
	{ label: "บริการประชาชน", href: servicesPath() },
	{ label: DIRECTORY_TITLE, href: directoryPath() },
	{ label: "เอกสารเผยแพร่", href: documentsPath() },
	{ label: "ข่าวสาร", href: "/news" },
	{ label: "ข้อมูลสุขภาพ", href: HEALTH_PATH },
];
const pill = "inline-flex min-h-11 items-center gap-2 rounded-pill px-4 text-label";
---

<SiteLayout
	title={title}
	description={lead}
	canonical="/search"
	noindex
	crumbs={[{ label: title }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		<SearchForm value={queryText} />
		{outcome.state === "too-short" ? (
			<EmptyState message="คำค้นหาสั้นเกินไป">
				<p class="text-text-secondary">กรุณาพิมพ์คำค้นหาอย่างน้อย 2 ตัวอักษร</p>
			</EmptyState>
		) : outcome.state === "nothing" || outcome.state === "failed" ? (
			<EmptyState
				message={
					outcome.state === "failed"
						? "ขออภัย ระบบค้นหาขัดข้องชั่วคราว"
						: `ไม่พบข้อมูลที่ตรงกับ “${queryText}”`
				}
			>
				<p class="max-w-prose text-text-secondary">
					{outcome.state === "failed"
						? "กรุณาลองใหม่อีกครั้งในภายหลัง หรือเลือกดูข้อมูลจากหมวดต่อไปนี้"
						: "ตรวจสอบตัวสะกด ลองใช้คำที่สั้นลงหรือคำอื่นที่มีความหมายใกล้เคียง หรือเลือกดูข้อมูลจากหมวดต่อไปนี้"}
				</p>
				<ul class="flex flex-wrap justify-center gap-3">
					{browse.map((link) => (
						<li>
							<ActionLink href={link.href}>{link.label}</ActionLink>
						</li>
					))}
				</ul>
			</EmptyState>
		) : (
			outcome.state === "found" && (
				<div class="flex flex-col gap-6">
					<nav aria-label="กลุ่มผลการค้นหา">
						<ul class="flex flex-wrap gap-2">
							{SEARCH_GROUPS.map((each) => (
								<li>
									<a
										class:list={[
											pill,
											each.id === group.id
												? "bg-brand-primary text-surface-base"
												: "bg-surface-soft text-brand-dark hover:bg-border-default",
										]}
										href={groupHref(each)}
										aria-current={each.id === group.id ? "true" : undefined}
									>
										{each.label}
										<span class="font-normal">
											{outcome.found.counts[each.id]}
											<span class="sr-only"> รายการ</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
					<p class="text-label text-text-secondary">
						{`พบ ${outcome.found.counts[group.id]} รายการ${groupSuffix}`}
					</p>
					{outcome.found.results.length > 0 ? (
						<ul class="flex flex-col gap-4">
							{outcome.found.results.map(({ entry, snippet }) => (
								<li>
									<SearchResultRow entry={entry} snippet={snippet} />
								</li>
							))}
						</ul>
					) : outcome.found.counts[group.id] > 0 ? (
						<EmptyState
							message="ไม่พบผลการค้นหาในหน้านี้"
							action={{ href: pageHref(Astro.url, 1), label: "กลับไปหน้าแรกของผลการค้นหา" }}
						/>
					) : (
						<EmptyState
							message={`ไม่พบผลการค้นหาในกลุ่ม${group.label}`}
							action={{ href: groupHref(SEARCH_GROUPS[0]), label: "ดูผลการค้นหาทุกประเภท" }}
						/>
					)}
					{outcome.found.results.length > 0 && (
						<Pagination page={page} hasMore={outcome.found.hasMore} />
					)}
				</div>
			)
		)}
	</div>
</SiteLayout>
