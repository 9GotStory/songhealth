---
// Search, /search (Feature 003 #63; spec #51 "Search", ADR 0002, `03` §13, `08`): every
// published public entry that matches the query, grouped, a fixed number per page. `?q=` carries
// the query, `?group=` the group and `?page=` the page, so reload, back, forward and a shared link
// keep them. src/lib/search.ts reads and matches; this page only renders what it returns.
//
// The page has four states besides its results, each in its own words: the start page with just
// the form, a query too short to search, a query that finds nothing (with links to browse
// instead, `08` §12), and a failed search. A failure answers 500, shows no detail and is logged on
// the server. Result pages are discovery views, not content pages (`08` §9), so the page keeps
// out of search engines and its canonical address is /search. It belongs to no main-navigation
// section; ค้นหา is a utility link.
import EmptyState from "../components/EmptyState.astro";
import PageHeading from "../components/PageHeading.astro";
import Pagination from "../components/Pagination.astro";
import SearchForm from "../components/SearchForm.astro";
import SearchResultRow from "../components/SearchResultRow.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { documentsPath } from "../lib/documents";
import { HEALTH_PATH } from "../lib/health";
import { directoryPath } from "../lib/health-service-directory";
import { PAGE_PARAM, pageHref, parsePageNumber } from "../lib/pagination";
import { search, type SearchEntry } from "../lib/search";
import {
	GROUP_PARAM,
	MAX_QUERY_LENGTH,
	QUERY_PARAM,
	SEARCH_GROUPS,
	parseGroup,
	parseQuery,
	type SearchGroupId,
	type SearchPage,
} from "../lib/search-matcher";
import { servicesPath } from "../lib/service-catalog";

const title = "ค้นหา";
const lead =
	"ค้นหาข่าวสาร บริการประชาชน ข้อมูลสุขภาพ หน่วยบริการ เอกสาร และข้อมูลของสำนักงานสาธารณสุขอำเภอสองได้จากที่เดียว";
const params = Astro.url.searchParams;
const raw = params.get(QUERY_PARAM) ?? "";
const query = parseQuery(raw);
const group = parseGroup(params.get(GROUP_PARAM));
const page = parsePageNumber(params.get(PAGE_PARAM));
/** The query as the citizen typed it, trimmed and capped as the search reads it. */
const shownQuery = [...raw.trim()].slice(0, MAX_QUERY_LENGTH).join("");

let results: SearchPage<SearchEntry> | undefined;
let failed = false;
if (query.kind === "terms") {
	try {
		results = await search(query.terms, group, page, new Date());
	} catch (error) {
		// The query is a citizen's own words, so the log leaves it out.
		console.error("/search: the search failed", error);
		Astro.response.status = 500;
		failed = true;
	}
}

/** This search's address in another group, from its first page. */
function groupHref(id: SearchGroupId): string {
	const next = new URLSearchParams(params);
	next.delete(PAGE_PARAM);
	if (id === "all") next.delete(GROUP_PARAM);
	else next.set(GROUP_PARAM, id);
	return `/search?${next}`;
}

const chosen = SEARCH_GROUPS.find(({ id }) => id === group)!;
/** Where to browse instead when a search finds nothing or fails (`08` §12). */
const browse = [
	{ label: "บริการประชาชน", href: servicesPath() },
	{ label: "หน่วยบริการสุขภาพที่เกี่ยวข้อง", href: directoryPath() },
	{ label: "เอกสารเผยแพร่", href: documentsPath() },
	{ label: "ข่าวสาร", href: "/news" },
	{ label: "ข้อมูลสุขภาพ", href: HEALTH_PATH },
];
const pill = "inline-flex min-h-11 items-center gap-2 rounded-pill px-4 text-label";
---

<SiteLayout
	title={title}
	description={lead}
	canonical="/search"
	noindex
	breadcrumbs={[{ label: "หน้าแรก", href: "/" }, { label: title }]}
>
	<div class="page-container flex flex-col gap-8 pt-6 pb-16 lg:pb-20">
		<PageHeading title={title} lead={lead} />
		<SearchForm value={shownQuery} />
		{query.kind === "too-short" ? (
			<EmptyState message="คำค้นหาสั้นเกินไป">
				<p class="text-text-secondary">กรุณาพิมพ์คำค้นหาอย่างน้อย 2 ตัวอักษร</p>
			</EmptyState>
		) : failed || results?.counts.all === 0 ? (
			<EmptyState
				message={
					failed ? "ขออภัย ระบบค้นหาขัดข้องชั่วคราว" : `ไม่พบข้อมูลที่ตรงกับ “${shownQuery}”`
				}
			>
				<p class="max-w-prose text-text-secondary">
					{failed
						? "กรุณาลองใหม่อีกครั้งในภายหลัง หรือเลือกดูข้อมูลจากหมวดต่อไปนี้"
						: "ลองใช้คำที่สั้นลงหรือคำอื่นที่มีความหมายใกล้เคียง หรือเลือกดูข้อมูลจากหมวดต่อไปนี้"}
				</p>
				<ul class="flex flex-wrap justify-center gap-3">
					{browse.map((link) => (
						<li>
							<a
								class="inline-flex min-h-11 items-center rounded-pill border border-border-input px-5 text-label text-brand-primary hover:bg-surface-soft"
								href={link.href}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</EmptyState>
		) : (
			results && (
				<div class="flex flex-col gap-6">
					<nav aria-label="กลุ่มผลการค้นหา">
						<ul class="flex flex-wrap gap-2">
							{SEARCH_GROUPS.map(({ id, label }) => (
								<li>
									<a
										class:list={[
											pill,
											id === group
												? "bg-brand-primary text-surface-base"
												: "bg-surface-soft text-brand-dark hover:bg-border-default",
										]}
										href={groupHref(id)}
										aria-current={id === group ? "true" : undefined}
									>
										{label}
										<span class="font-normal">
											{results.counts[id]}
											<span class="sr-only"> รายการ</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
					<p class="text-label text-text-secondary">
						พบ {results.counts[group]} รายการ{group === "all" ? "" : `ในกลุ่ม${chosen.label}`}
					</p>
					{results.results.length > 0 ? (
						<ul class="flex flex-col gap-4">
							{results.results.map(({ entry, snippet }) => (
								<li>
									<SearchResultRow entry={entry} snippet={snippet} />
								</li>
							))}
						</ul>
					) : results.counts[group] > 0 ? (
						<EmptyState
							message="ไม่พบผลการค้นหาในหน้านี้"
							action={{ href: pageHref(Astro.url, 1), label: "กลับไปหน้าแรกของผลการค้นหา" }}
						/>
					) : (
						<EmptyState
							message={`ไม่พบผลการค้นหาในกลุ่ม${chosen.label}`}
							action={{ href: groupHref("all"), label: "ดูผลการค้นหาทุกประเภท" }}
						/>
					)}
					{results.results.length > 0 && <Pagination page={page} hasMore={results.hasMore} />}
				</div>
			)
		)}
	</div>
</SiteLayout>
