---
// The Songhealth Homepage, / (Feature 003 #64, #65; spec #51 "Homepage (`04`, Figma order)", `04`;
// docs/design/homepage-concept-v1.md). A view of published content, in the Figma order:
//
// - the hero (Feature 008 #241; spec #239 "Hero and Featured"; HomeHero): the office summary as
//   the headline, the site search, a GET form to /search, and the Featured item as a card, the
//   first item of the Featured menu that resolves to published content
//   (src/lib/homepage-curation.ts). With none, the headline and the search alone;
// - the Frequently Used Services: up to 6 Services from their menu, in menu order;
// - the newest published News that is not the Featured item, as one card, beside up to 3 current
//   Announcements, newest first by announcement date, the Featured one left out (`04` §7), each
//   with its status and dates as the Announcements list shows them (src/lib/announcements.ts), each
//   box followed by a link to its own list;
// - Health Information: the latest 4 Health Content items, each labelled with its first Health
//   Topic, the `topic` term EmDash hydrates first (src/lib/terms.ts);
// - Health Service Discovery: an Area select and a name field, a GET form to the Health Service
//   Directory with the directory's own parameters (src/lib/health-service-directory.ts);
// - the latest Activities by when they were held (ADR 0004), 3 on a desktop and 4 on phones and
//   tablets;
// - Quick Access: up to 4 shortcuts from their menu, in menu order, each a label and an arrow;
// - the Contact Summary: the site title, then Office Contact's address with the "เปิดแผนที่" link,
//   main telephone and opening hours (OfficeContactDetails), each only when set, and a link to
//   /contact. A static visual stands in for the map; no map is embedded.
//
// Each section between the hero and the Contact Summary opens with the Homepage section heading
// (spec #239 "Section headings"; SectionHeading): an icon tile, a label and the H2. The Frequently
// Used Services, Health Information and Activities are named as their lists are, and their
// heading links to that list; the News box and the Announcements box keep a link each under them.
//
// Below 640 px the page is shorter, with every section kept in its order (Feature 006 #146; spec
// #144 "Homepage (`04`)"; the Product Owner's "โอเค เฉพาะหน้าแรก" on the prototype): the
// Frequently Used Services, Health Information, Activities and Quick Access go two to a row in
// their compact cards, the Service and Health Content cards without their summary; the Contact
// Summary's lead and the map's stand-in are left out; each section has 32 px of space above and
// below it; and the News card's summary is clamped to three lines. The 4th Activity fills the
// second row of two; a desktop row holds three.
//
// A section with nothing to show is left out (`04` §17): the Frequently Used Services, News and
// Announcements together, Health Information, Health Service Discovery while no Health Service is
// published, Activities and Quick Access. The hero and the Contact Summary always render, so the
// page answers with no content at all. The site title is the page's H1, hidden from sight in the
// hero, whose headline shows in its place (spec #239 "Hero and Featured").
//
// Beyond the Figma frame, on the Product Owner's decision (2026-10-30: #64 comment 6526131459):
// the links to the News, Announcements and Health Content lists, since the Announcements list is in
// no navigation; each Announcement's status; and the Contact Summary's lead as the page's
// description, since a tagline is a slogan and EmDash's site settings hold no description (emdash
// 1.1.0 src/api/schemas/settings.ts).
//
// The meta element named "songhealth-foundation" with content "public-runtime" is the Feature 001
// public-runtime marker (T011): tests/browser/foundation.spec.ts, the development runtime's verify
// script and container health check, and the T016/T022 production verification all read it from
// the server-rendered HTML of `/`. Keep it exactly as written.
import FileText from "@lucide/astro/icons/file-text";
import Heart from "@lucide/astro/icons/heart";
import HeartPulse from "@lucide/astro/icons/heart-pulse";
import Hospital from "@lucide/astro/icons/hospital";
import MessageSquare from "@lucide/astro/icons/message-square";
import Users from "@lucide/astro/icons/users";
import ActivityCard from "../components/ActivityCard.astro";
import AnnouncementStatusLine from "../components/AnnouncementStatusLine.astro";
import ArrowLink from "../components/ArrowLink.astro";
import HomeHero from "../components/HomeHero.astro";
import OfficeContactDetails from "../components/OfficeContactDetails.astro";
import QuickLinkCard from "../components/QuickLinkCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ThaiTitle from "../components/ThaiTitle.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { ACTIVITIES_PATH, ACTIVITIES_TITLE, latestActivities } from "../lib/activities";
import {
	ANNOUNCEMENTS_PATH,
	ANNOUNCEMENTS_TITLE,
	announcementPath,
	currentAnnouncements,
} from "../lib/announcements";
import { HEALTH_CONTENT_PATH, HEALTH_CONTENT_TITLE } from "../lib/health";
import { healthContentPath, latestHealthContent } from "../lib/health-content";
import { FILTER_LABELS, FILTER_PARAMS, directoryPath } from "../lib/health-service-directory";
import { directoryOverview } from "../lib/health-services";
import { readHomepageCuration } from "../lib/homepage-curation";
import { latestNews, newsPath } from "../lib/news";
import { readOfficeContact } from "../lib/office-contact";
import { OFFICE_SUMMARY } from "../lib/office-summary";
import { SERVICES_PATH, SERVICES_TITLE } from "../lib/service-catalog";
import { getSiteIdentity } from "../lib/site-identity";
import { termsOf } from "../lib/terms";

/** One instant for the current Announcements, the status each states and the Featured item's. */
const now = new Date();
const [
	identity,
	{ featured, services, quickAccess },
	newestNews,
	newestAnnouncements,
	healthContent,
	directory,
	activities,
	{ contact },
] = await Promise.all([
	getSiteIdentity(Astro.url),
	readHomepageCuration(Astro.url.origin, now),
	latestNews(2),
	currentAnnouncements(4, now),
	latestHealthContent(4),
	directoryOverview(),
	latestActivities(4),
	readOfficeContact(),
]);
/**
 * Whether an entry of `collection` is other than the Featured item, which the page already shows.
 */
const notFeatured =
	(collection: string) =>
	({ data }: { data: { id: string } }) =>
		!(featured?.collection === collection && featured.id === data.id);
/** The News card: the newest News that is not Featured. */
const news = newestNews.find(notFeatured("news"));
/** Up to 3 current Announcements that are not Featured. */
const announcements = newestAnnouncements.filter(notFeatured("announcements")).slice(0, 3);
const newsCategory = news && termsOf(news.data, "news_category")[0];

/** The Health Service Discovery fields' box: 44 px high, with a 3:1 boundary, as FilterForm's. */
const control =
	"min-h-11 w-full min-w-0 rounded-14 border border-border-input bg-surface-base px-3 text-body";
---

<SiteLayout section="home" description={OFFICE_SUMMARY} canonical="/">
	<meta slot="head" name="songhealth-foundation" content="public-runtime" />

	<HomeHero siteTitle={identity.title} featured={featured} />

	{services.length > 0 && (
		<section aria-labelledby="home-services" class="bg-surface-base py-8 sm:py-16 lg:pb-20">
			<div class="page-container flex flex-col gap-7">
				<SectionHeading
					id="home-services"
					label="บริการ"
					title={SERVICES_TITLE}
					href={SERVICES_PATH}
				>
					<Users slot="icon" class="shrink-0" size={24} />
				</SectionHeading>
				<ul class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
					{services.map((service) => (
						<li>
							<ServiceCard service={service} headingLevel={3} compact />
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	{(news || announcements.length > 0) && (
		<section aria-labelledby="home-news" class="py-8 sm:py-16 lg:py-20">
			<div class="page-container flex flex-col gap-7">
				<SectionHeading id="home-news" label="ข่าวสาร" title="เรื่องใหม่จากเครือข่ายสุขภาพอำเภอสอง">
					<MessageSquare slot="icon" class="shrink-0" size={24} />
				</SectionHeading>
				<div
					class:list={[
						"grid gap-6",
						news && announcements.length > 0 && "lg:grid-cols-[minmax(0,1fr)_26rem]",
					]}
				>
					{news && (
						<div class="flex flex-col gap-4">
							<article class="flex flex-1 flex-col gap-4 rounded-24 bg-brand-primary px-6 py-7 text-surface-base lg:px-7.5">
								{newsCategory && <p class="text-label wrap-anywhere">{newsCategory.label}</p>}
								<h3 class="text-h3 wrap-anywhere lg:text-h1">
									<ThaiTitle text={news.data.title} />
								</h3>
								{news.data.summary && (
									<p class="line-clamp-4 text-body-large max-sm:line-clamp-3">
										{news.data.summary}
									</p>
								)}
								<ArrowLink
									href={newsPath(news.id)}
									context={news.data.title}
									onDark
									class="mt-auto"
								>
									อ่านข่าว
								</ArrowLink>
							</article>
							<ArrowLink href="/news">ดูข่าวทั้งหมด</ArrowLink>
						</div>
					)}
					{announcements.length > 0 && (
						<div class="flex flex-col gap-4">
							<div class="flex flex-1 flex-col rounded-24 border border-border-default bg-surface-base">
								<div class="flex flex-col gap-1 px-6 pt-6 pb-5">
									<h3 id="home-announcements" class="text-h3 text-text-primary">
										<ThaiTitle text="ประกาศ" />
									</h3>
									<p class="text-small text-text-secondary">
										ข้อมูลที่อาจมีวันสิ้นสุดหรือการดำเนินการ
									</p>
								</div>
								<ul aria-labelledby="home-announcements">
									{announcements.map((announcement) => (
										<li class="flex flex-col gap-1.5 border-t border-divider px-6 py-4.5">
											<p class="wrap-anywhere">
												<ThaiTitle text={announcement.data.title} />
											</p>
											<AnnouncementStatusLine data={announcement.data} now={now} />
											<ArrowLink
												href={announcementPath(announcement.id)}
												context={announcement.data.title}
											>
												ดูรายละเอียด
											</ArrowLink>
										</li>
									))}
								</ul>
							</div>
							<ArrowLink href={ANNOUNCEMENTS_PATH}>ดู{ANNOUNCEMENTS_TITLE}ทั้งหมด</ArrowLink>
						</div>
					)}
				</div>
			</div>
		</section>
	)}

	{healthContent.length > 0 && (
		<section aria-labelledby="home-health" class="bg-surface-base py-8 sm:py-16 lg:py-20">
			<div class="page-container flex flex-col gap-7">
				<SectionHeading
					id="home-health"
					label="สุขภาพ"
					title={HEALTH_CONTENT_TITLE}
					href={HEALTH_CONTENT_PATH}
				>
					<HeartPulse slot="icon" class="shrink-0" size={24} />
				</SectionHeading>
				<ul class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
					{healthContent.map((item, index) => {
						const topic = termsOf(item.data, "topic")[0];
						return (
							<li>
								<article
									class:list={[
										"flex h-full flex-col gap-3 rounded-22 px-6 pt-6.5 pb-6",
										"max-sm:gap-1.5 max-sm:rounded-18 max-sm:px-3 max-sm:pt-3.5 max-sm:pb-2",
										index % 2 === 0 ? "bg-topic-green" : "bg-topic-blue",
									]}
								>
									{topic && (
										<p class="text-label wrap-anywhere text-brand-primary">{topic.label}</p>
									)}
									<h3 class="text-h3 wrap-anywhere text-text-primary max-sm:text-body max-sm:font-semibold">
										<ThaiTitle text={item.data.title} />
									</h3>
									{item.data.summary && (
										<p class="line-clamp-3 text-text-secondary-on-soft max-sm:hidden">
											{item.data.summary}
										</p>
									)}
									<ArrowLink
										href={healthContentPath(item.id)}
										context={item.data.title}
										class="mt-auto"
									>
										อ่านเพิ่มเติม
									</ArrowLink>
								</article>
							</li>
						);
					})}
				</ul>
			</div>
		</section>
	)}

	{directory.hasHealthServices && (
		<section aria-labelledby="home-discovery" class="bg-brand-dark py-8 sm:py-16 lg:py-20">
			<div class="page-container flex flex-col gap-7">
				<SectionHeading
					onDark
					id="home-discovery"
					label="หน่วยบริการ"
					title="ค้นหาหน่วยบริการสุขภาพในอำเภอสอง"
				>
					<Hospital slot="icon" class="shrink-0" size={24} />
				</SectionHeading>
				<form
					method="get"
					action={directoryPath()}
					aria-label="ค้นหาหน่วยบริการ"
					class="flex max-w-225 flex-col gap-4 rounded-18 bg-surface-base p-4 sm:flex-row sm:items-end sm:p-2.5 sm:pl-5.5"
				>
					<div class="flex min-w-0 flex-1 flex-col gap-1.5">
						<label class="text-label" for="discovery-area">
							{FILTER_LABELS.area}
						</label>
						<select id="discovery-area" name={FILTER_PARAMS.area} class={control}>
							<option value="">{FILTER_LABELS.anyArea}</option>
							{directory.areas.map((area) => (
								<option value={area.slug}>{area.label}</option>
							))}
						</select>
					</div>
					<div class="flex min-w-0 flex-1 flex-col gap-1.5">
						<label class="text-label" for="discovery-name">
							{FILTER_LABELS.name}
						</label>
						<input id="discovery-name" name={FILTER_PARAMS.name} type="search" class={control} />
					</div>
					<button
						type="submit"
						class="inline-flex min-h-11 shrink-0 cursor-pointer items-center justify-center rounded-pill bg-brand-primary px-5 text-label text-surface-base hover:bg-brand-dark"
					>
						ค้นหาหน่วยบริการ
					</button>
				</form>
			</div>
		</section>
	)}

	{activities.length > 0 && (
		<section aria-labelledby="home-activities" class="py-8 sm:py-16 lg:py-20">
			<div class="page-container flex flex-col gap-7">
				<SectionHeading
					id="home-activities"
					label="ภาพกิจกรรม"
					title={ACTIVITIES_TITLE}
					href={ACTIVITIES_PATH}
				>
					<Heart slot="icon" class="shrink-0" size={24} />
				</SectionHeading>
				<ul class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-3">
					{activities.map((activity, index) => (
						<li class:list={[index === 3 && "lg:hidden"]}>
							<ActivityCard activity={activity} headingLevel={3} compact />
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	{quickAccess.length > 0 && (
		<section aria-labelledby="home-quick-access" class="bg-surface-base py-8 sm:py-16 lg:py-20">
			<div class="page-container flex flex-col gap-7">
				<SectionHeading id="home-quick-access" label="เข้าถึงข้อมูล" title="ข้อมูลและเอกสารสำคัญ">
					<FileText slot="icon" class="shrink-0" size={24} />
				</SectionHeading>
				<ul class="grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
					{quickAccess.map((link) => (
						<li>
							<QuickLinkCard href={link.href} label={link.label} compact />
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<section aria-labelledby="home-contact" class="bg-surface-soft py-8 sm:py-16">
		<div class="page-container grid items-center gap-8 lg:grid-cols-[35rem_minmax(0,1fr)] lg:gap-12">
			<div class="flex flex-col gap-3.5">
				<h2 id="home-contact" class="text-h3 wrap-anywhere text-brand-dark lg:text-h2">
					<ThaiTitle text={identity.title} />
				</h2>
				<p class="text-body-large text-text-secondary-on-soft max-sm:hidden">{OFFICE_SUMMARY}</p>
				<OfficeContactDetails contact={contact} summary />
				<ArrowLink href="/contact">ดูข้อมูลติดต่อทั้งหมด</ArrowLink>
			</div>
			<div
				aria-hidden="true"
				class="flex h-40 items-center justify-center gap-3 rounded-24 bg-linear-to-r from-contact-visual-from to-contact-visual-to px-6 text-center text-label text-brand-dark max-sm:hidden lg:h-57.5"
			>
				<span class="size-10.5 shrink-0 rounded-pill bg-surface-base"></span>
				แผนที่สำนักงานและพื้นที่อำเภอสอง
			</div>
		</div>
	</section>
</SiteLayout>
