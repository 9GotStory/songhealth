# Local WordPress verification runtime configuration example (Delivery 002 Gate 01.5).
#
# Copy to .env.wordpress-verification.local and fill in local values. The actual
# .env.wordpress-verification.local file is ignored by Git (see .gitignore) and is
# never committed. These are non-secret, non-Production placeholder values only:
# the runtime is local and disposable, its database is reachable only inside the
# Compose project network, and its only published port binds to 127.0.0.1.
#
# This file is safe committed example configuration (FR-021): it contains no real
# credential, no Production value, and no Production-derived data. Replace every
# password with a locally generated value when you create your local copy. Keep
# every value free of unquoted spaces (use hyphens) so the file also stays safe
# to source in a shell if you ever need to.
#
# The origin is loopback-only by contract: WORDPRESS_VERIFY_SITE_URL must be
# http://127.0.0.1:<WORDPRESS_VERIFY_PORT> (http://localhost:<port> is accepted
# too); scripts/wordpress-verification.sh rejects anything else.

# The single loopback-published HTTP port of the runtime. Default chosen to avoid
# the Delivery 001 Development/Verification ports (3306, 8080).
WORDPRESS_VERIFY_PORT=18080
WORDPRESS_VERIFY_SITE_URL=http://127.0.0.1:18080
WORDPRESS_VERIFY_SITE_TITLE=Songhealth-Local-Verification

# Synthetic local WordPress administrator for this disposable profile only.
# Never a Production identity; never Production-derived.
WORDPRESS_VERIFY_ADMIN_USER=songhealth-local-admin
WORDPRESS_VERIFY_ADMIN_PASSWORD=change-me-locally-never-commit
WORDPRESS_VERIFY_ADMIN_EMAIL=songhealth-local@example.invalid

# Credentials of this Compose project's own MySQL-compatible database. Reachable
# only from inside the project network (never published to the host).
WORDPRESS_DB_NAME=songhealth_wp_verify
WORDPRESS_DB_USER=songhealth_wp
WORDPRESS_DB_PASSWORD=change-me-locally-never-commit
WORDPRESS_DB_ROOT_PASSWORD=change-me-locally-never-commit-root
