# Verification operation target — Production-like Verification configuration example.
# Copy to .env.verification.local and fill in local values. Actual local .env files are
# ignored by Git. These are non-secret, non-Production placeholders only; they are
# never accepted as Production configuration and contain no real credentials.
#
# Verification is not a fourth environment: APP_ENVIRONMENT stays `development`.
# The application is exposed only on the internal Compose network (its port is not
# published to the host), and exactly one proxy hop is trusted.
#
# operationTarget and diagnosticScope are NOT configuration keys: operationTarget is
# supplied by the local command boundary (--target) and diagnosticScope is derived
# output context.

APP_ENVIRONMENT=development
RUNTIME_PROFILE=verification
APP_HOST=songhealth-app
APP_PORT=3000
PUBLIC_ORIGIN=http://songhealth-verification.test
DATABASE_URL=mysql://songhealth_ver:ver-only-placeholder@songhealth-db:3306/songhealth_verification
DATABASE_POOL_MAX=5
PROXY_POLICY=one-hop
LOG_LEVEL=info
FIXTURE_PROVENANCE=synthetic
