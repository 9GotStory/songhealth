# Secrets / environment
# Ignore actual local secret files, but allow exactly the three committed examples.
.env
.env.*
!.env.real-engine.example
!.env.development.example
!.env.verification.example

# Checkout-local operation journal and Verification report tree (never committed)
.foundation-state/

# Node / build output (for later implementation)
node_modules/
dist/
build/
coverage/
.vite/

