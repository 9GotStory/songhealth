wordpress/vendor/
wordpress/composer.phar
wordpress/wp-tests-config.php
wordpress/.phpunit.result.cache

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

