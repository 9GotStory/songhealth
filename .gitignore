# Secrets / local environment
.env
.env.*
!.env.example

# Dependencies / build output
node_modules/
dist/
build/
coverage/
.astro/
.vite/

# Generated output (EmDash migration manifest emitted by the exact application build)
.emdash/migrations.json

# Development runtime checkout identity marker (written by scripts/dev-runtime-{install,update}.sh)
/.songhealth-qdev-source-identity

# Development media (local EmDash media store at the approved stable ./media application mount path; see 10-system-blueprint.md §20.1)
/media/

# Local caches / temp
.cache/
.tmp/
tmp/
*.tmp
*.bak

# Logs (including raw validation logs/captures; redacted evidence under specs/ stays tracked)
/logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local database / backup / export artifacts
*.sqlite
*.sqlite3
*.dump
*.sql
*.sql.gz
*.tar
*.tgz
