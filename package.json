{
  "name": "songhealth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Application foundation and development runtime for the สสอ.สอง website (one repository, three application workspaces).",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=12.0.0 <13"
  },
  "scripts": {
    "foundation:check": "node scripts/foundation-operations.mjs foundation:check",
    "dev:setup": "node scripts/foundation-operations.mjs dev:setup --target development",
    "dev:start": "node scripts/foundation-operations.mjs dev:start",
    "dev:ready": "node scripts/foundation-operations.mjs dev:ready",
    "dev:stop": "node scripts/foundation-operations.mjs dev:stop",
    "dev:restart": "node scripts/foundation-operations.mjs dev:restart",
    "foundation:status": "node scripts/foundation-operations.mjs foundation:status",
    "foundation:inventory": "node scripts/foundation-operations.mjs foundation:inventory",
    "dev:reset": "node scripts/foundation-operations.mjs dev:reset",
    "foundation:recover": "node scripts/foundation-operations.mjs foundation:recover",
    "foundation:cleanup": "node -e \"process.exit(1)\"",
    "foundation:test-interruption": "node scripts/foundation-operations.mjs foundation:test-interruption",
    "dev:persistence-check": "node scripts/foundation-operations.mjs dev:persistence-check",
    "db:status": "node scripts/foundation-operations.mjs db:status",
    "db:migrate": "node scripts/foundation-operations.mjs db:migrate",
    "verify:production-like": "node -e \"process.exit(1)\"",
    "check": "node -e \"process.exit(1)\"",
    "security:secrets": "node -e \"process.exit(1)\"",
    "security:dependencies": "node -e \"process.exit(1)\"",
    "security:asvs": "node -e \"process.exit(1)\"",
    "security:check": "node -e \"process.exit(1)\""
  }
}
